import { ScrollView } from "std-widgets.slint";
import { Palette, Icons } from "tokmon-theme.slint";
import { ReviewFile, DiffLine, TreeItem, RightTab } from "tokmon-models.slint";
import { ToolIcon, MenuOption } from "tokmon-components.slint";

// A single row of the unified (inline) diff. Regular rows keep one fixed
// height; banner rows reproduce the prototype's `td py-1` + `py-1 my-0.5`
// pill: 4px gap, 28px pill, 4px gap.
component UnifiedDiffRow inherits Rectangle {
    in property <DiffLine> line;
    callback toggle-hunk(string);

    height: root.line.kind == "banner" ? 40px : 20px;
    background: root.line.kind == "delete" ? Palette.diff-del-bg
        : root.line.kind == "add" ? Palette.diff-add-bg : transparent;

    if root.line.kind == "banner" : Rectangle {
        y: 6px;
        width: parent.width;
        height: 28px;
        border-radius: 8px;
        background: banner-touch.has-hover ? #EAEAEA : Palette.diff-banner-bg;
        border-width: 1px;
        border-color: Palette.diff-banner-line;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: space-between;
            Text {
                text: root.line.banner;
                font-family: "MiSans VF";
                font-size: 11.5px;
                color: Palette.dim;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                // The C++ projection stores the action hint ("点击折叠" /
                // "点击展开上下文") in `text`; fall back for safety.
                text: root.line.text == "" ? "点击展开上下文" : root.line.text;
                font-size: 10px;
                color: Palette.faint;
                vertical-alignment: center;
            }
        }
        banner-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-hunk(root.line.hunk); }
        }
    }

    if root.line.kind != "banner" : HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 48px;
            horizontal-stretch: 0;
            background: root.line.kind == "delete" ? Palette.diff-del-num-bg
                : root.line.kind == "add" ? Palette.diff-add-num-bg : transparent;
            Text {
                x: 0px;
                width: 36px;
                height: parent.height;
                text: root.line.kind == "add" ? root.line.new-num : root.line.old-num;
                font-family: "MiSans VF";
                font-size: 11px;
                font-weight: root.line.kind == "context" ? 400 : 500;
                color: root.line.kind == "delete" ? Palette.diff-del-num-ink
                    : root.line.kind == "add" ? Palette.diff-add-num-ink : Palette.faint;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if root.line.kind != "context" : Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: root.line.kind == "delete" ? #FCA5A566 : #86EFAC66;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 12px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.line.text == "" ? " " : root.line.text;
                font-family: "MiSans VF";
                font-size: 12px;
                color: root.line.kind == "delete" ? Palette.diff-del-ink
                    : root.line.kind == "add" ? Palette.diff-add-ink : Palette.ink;
                vertical-alignment: center;
            }
        }
    }
}

// A single row of the side-by-side diff. Both columns are always present so
// the two versions stay vertically aligned across the whole file. Line
// numbers carry their own tint (red/green/faint) distinct from the code ink,
// matching the prototype's spans. Cells breathe with `py-0.5`, so regular
// rows are 24px tall versus 20px in the unified view.
component SplitDiffRow inherits Rectangle {
    in property <DiffLine> line;

    height: root.line.kind == "banner" ? 40px : 24px;

    if root.line.kind == "banner" : Rectangle {
        y: 6px;
        width: parent.width;
        height: 28px;
        border-radius: 8px;
        background: Palette.diff-banner-bg;
        border-width: 1px;
        border-color: Palette.diff-banner-line;
        Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text: root.line.banner;
            font-family: "MiSans VF";
            font-size: 11.5px;
            color: Palette.dim;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.line.kind != "banner" : HorizontalLayout {
        spacing: 0px;
        Rectangle {
            horizontal-stretch: 1;
            background: root.line.kind == "delete" ? Palette.diff-del-bg : transparent;
            split-old-num := Text {
                x: 8px;
                height: parent.height;
                text: (root.line.kind == "add" || root.line.old-num == "")
                    ? "" : root.line.old-num;
                font-family: "MiSans VF";
                font-size: 11px;
                color: root.line.kind == "delete" ? #DC2626 : Palette.faint;
                vertical-alignment: center;
            }
            Text {
                x: split-old-num.x + split-old-num.preferred-width + 8px;
                width: parent.width - self.x - 8px;
                height: parent.height;
                text: (root.line.kind == "add" || root.line.old-num == "")
                    ? "" : root.line.text;
                font-family: "MiSans VF";
                font-size: 12px;
                color: root.line.kind == "delete" ? Palette.diff-del-ink : Palette.ink;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Palette.border;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: root.line.kind == "add" ? Palette.diff-add-bg
                : root.line.kind == "delete" ? Palette.diff-del-empty : transparent;
            split-new-num := Text {
                x: 8px;
                height: parent.height;
                text: (root.line.kind == "delete" || root.line.new-num == "")
                    ? "" : root.line.new-num;
                font-family: "MiSans VF";
                font-size: 11px;
                color: root.line.kind == "add" ? #16A34A : Palette.faint;
                vertical-alignment: center;
            }
            Text {
                x: split-new-num.x + split-new-num.preferred-width + 8px;
                width: parent.width - self.x - 8px;
                height: parent.height;
                text: (root.line.kind == "delete" || root.line.new-num == "")
                    ? "" : root.line.text;
                font-family: "MiSans VF";
                font-size: 12px;
                color: root.line.kind == "add" ? Palette.diff-add-ink : Palette.ink;
                vertical-alignment: center;
            }
        }
    }
}

// Pill-shaped closable tab in the right panel header. Every pill — active or
// not — carries its own close button, like the prototype. Children are
// absolutely positioned so the 14px icon, the text and the 16px close hit box
// stay exactly centered inside the fixed 28px pill.
component RightTabPill inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <image> icon;
    in property <bool> compact;
    callback picked();
    callback closed();

    height: 28px;
    // 12px left pad + 14px icon + 6px + text + 6px + 16px close + 12px pad.
    preferred-width: root.compact ? 52px : title-text.preferred-width + 66px;
    border-radius: 999px;
    background: root.active ? Palette.white
        : (pill-touch.has-hover ? Palette.hover-soft : transparent);
    border-width: root.active ? 0.67px : 0px;
    border-color: Palette.card-line;
    drop-shadow-color: root.active ? Palette.shadow : transparent;
    drop-shadow-offset-y: root.active ? 1px : 0px;
    drop-shadow-blur: root.active ? 1px : 0px;

    Image {
        x: root.compact ? 8px : 12px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        source: root.icon;
        colorize: Palette.dim;
    }
    title-text := Text {
        visible: !root.compact;
        x: 32px;
        width: self.preferred-width;
        height: parent.height;
        text: root.title;
        font-size: 12.5px;
        font-weight: root.active ? 500 : 400;
        color: root.active || pill-touch.has-hover ? Palette.ink : Palette.dim;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 28px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 999px;
        background: close-touch.has-hover ? Palette.hover-soft : transparent;
        Image {
            source: Icons.close;
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: close-touch.has-hover ? Palette.ink : Palette.faint;
        }
    }
    close-touch := TouchArea {
        // Overlay only the trailing close hit box; the pill itself picks the tab.
        x: parent.width - 24px;
        width: 24px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.closed(); }
    }
    pill-touch := TouchArea {
        width: parent.width - 24px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// One row of the changed-files list in the review sidebar. A folder heading
// (20px) sits 2px above its file row (26px), matching the prototype group.
component ReviewFileRow inherits Rectangle {
    in property <ReviewFile> file;
    in property <bool> active;
    callback picked();

    height: root.file.show-folder ? 48px : 26px;
    clip: true;

    if root.file.show-folder : Rectangle {
        height: 20px;
        Image {
            source: Icons.chev-down;
            x: 8px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            colorize: Palette.dim;
        }
        Text {
            x: 24px;
            width: parent.width - 40px;
            height: parent.height;
            text: root.file.display-folder;
            font-family: "MiSans VF";
            font-size: 11px;
            color: Palette.dim;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 14px;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: root.file.status == "added" ? Palette.green
                : root.file.status == "deleted" ? #DC2626 : Palette.accent;
        }
    }
    file-row := Rectangle {
        y: root.file.show-folder ? 22px : 0px;
        height: 26px;
        border-radius: 8px;
        background: root.active ? Palette.white
            : (row-touch.has-hover ? Palette.hover-soft : transparent);
        border-width: root.active ? 0.67px : 0px;
        border-color: Palette.card-line;
        drop-shadow-color: root.active ? Palette.shadow : transparent;
        drop-shadow-offset-y: root.active ? 1px : 0px;
        drop-shadow-blur: root.active ? 1px : 0px;
        Image {
            source: Icons.doc;
            x: 10px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            colorize: Palette.dim;
        }
        Text {
            x: 30px;
            width: parent.width - 58px;
            height: parent.height;
            text: root.file.display-name;
            font-family: "MiSans VF";
            font-size: 11.5px;
            font-weight: root.active ? 500 : 400;
            color: root.active ? Palette.ink : Palette.strong;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 28px;
            y: (parent.height - 16px) / 2;
            width: 18px;
            height: 16px;
            border-radius: 4px;
            background: root.file.status == "added" ? #DCFCE7
                : root.file.status == "deleted" ? #FEE2E2
                : root.file.status == "renamed" ? #DBEAFE : #FEF3D6;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.file.status == "added" ? "A"
                    : root.file.status == "deleted" ? "D"
                    : root.file.status == "renamed" ? "R" : "M";
                font-family: "MiSans VF";
                font-size: 10px;
                font-weight: 700;
                color: root.file.status == "added" ? Palette.green-ink
                    : root.file.status == "deleted" ? #B91C1C
                    : root.file.status == "renamed" ? #1D4ED8 : #B45309;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(); }
        }
    }
}

// Directory tree row for the workspace "open file" sidebar. Indentation
// follows the prototype: 8px base + 20px per nesting level (`px-2` row plus
// the `pl-5` folder child container). Nested file rows are tighter (22px,
// 12px icon) than folder and root-level rows (26px, 14px icon).
component TreeRow inherits Rectangle {
    in property <TreeItem> item;
    in property <bool> active;
    callback picked();

    height: root.item.depth == 0 || root.item.kind == "folder" ? 26px : 22px;
    property <length> content-x: 8px + root.item.depth * 20px;
    border-radius: 6px;
    background: root.active ? #FAF5EF
        : (row-touch.has-hover ? Palette.sep : transparent);
    clip: true;
    if root.item.kind == "folder" : Image {
        source: root.item.expanded ? Icons.chev-down : Icons.chev-right;
        x: root.content-x;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        colorize: Palette.dim;
    }
    if root.item.kind == "file" : Image {
        source: Icons.doc;
        x: root.content-x;
        y: (parent.height - self.height) / 2;
        width: root.item.depth == 0 ? 14px : 12px;
        height: self.width;
        colorize: root.item.depth == 0 ? Palette.dim : Palette.faint;
    }
    Text {
        x: root.content-x + (root.item.kind == "file" && root.item.depth > 0
            ? 18px : 20px);
        width: parent.width - self.x - 8px;
        height: parent.height;
        text: root.item.name;
        font-family: "MiSans VF";
        font-size: root.item.kind == "folder" || root.item.depth == 0
            ? 12.5px : 11.5px;
        font-weight: root.active ? 500 : 400;
        color: root.active ? Palette.accent
            : (root.item.kind == "folder" || root.item.depth == 0
                ? Palette.strong : Palette.dim);
        overflow: elide;
        vertical-alignment: center;
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// Frameless filter field reused by both right-panel sidebars. The review
// list uses the prototype's `rounded-lg` pill while the workspace tree uses
// the roomier `rounded-xl` variant, hence the configurable radius/indent.
component PanelFilter inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> field-radius: 8px;
    in property <length> text-indent: 28px;
    in property <length> field-font-size: 11.5px;
    callback edited(string);

    height: 26px;
    border-radius: root.field-radius;
    background: field.has-focus ? Palette.white : Palette.pill;
    border-width: 1px;
    border-color: field.has-focus ? rgba(200, 106, 40, 0.4) : transparent;
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }
    Image {
        source: Icons.search;
        x: 10px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        colorize: Palette.faint;
    }
    field := TextInput {
        x: root.text-indent;
        width: parent.width - self.x - 8px;
        height: parent.height;
        vertical-alignment: center;
        font-size: root.field-font-size;
        color: Palette.body;
        text <=> root.text;
        edited => { root.edited(self.text); }
    }
    if root.text == "" : Text {
        x: root.text-indent;
        height: parent.height;
        text: root.placeholder;
        font-size: root.field-font-size;
        color: Palette.faint;
        vertical-alignment: center;
    }
}

// Launcher entry: icon + label + keyboard hint, matching the prototype card
// (`px-4 py-3 rounded-2xl` → 44px row).
component LauncherEntry inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    callback chosen();

    height: 44px;
    border-radius: 16px;
    background: entry-touch.has-hover ? Palette.hover-soft : transparent;
    border-width: 1px;
    border-color: entry-touch.has-hover ? Palette.card-line : transparent;
    drop-shadow-color: Palette.shadow;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 1px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        alignment: space-between;
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
                colorize: entry-touch.has-hover ? Palette.accent : Palette.dim;
            }
            Text {
                text: root.label;
                font-size: 13.5px;
                font-weight: 500;
                color: Palette.body;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 20px;
            border-radius: 999px;
            background: Palette.white;
            border-width: 1px;
            border-color: Palette.card-line;
            horizontal-stretch: 0;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: root.shortcut;
                    font-family: "MiSans VF";
                    font-size: 11px;
                    color: Palette.faint;
                    vertical-alignment: center;
                }
            }
        }
    }
    entry-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

export component CodePanelSlot inherits Rectangle {
    in property <bool> code-visible;
    in property <length> host-width;
    in property <bool> sidebar-visible;
    in property <length> sidebar-width;
    in property <length> minimum-workspace-width: 300px;
    in property <length> minimum-code-panel-width: 214px;
    property <float> reveal-progress: root.code-visible ? 1.0 : 0.0;
    out property <length> layout-width: (root.code-panel-width + 1px) * root.reveal-progress;
    animate reveal-progress { duration: 160ms; easing: ease-in-out; }

    // Tabs: an empty list means the launcher screen is showing.
    in-out property <[RightTab]> right-tabs;
    in-out property <string> right-tab: "launcher";

    // Review (Git diff) state
    in-out property <[ReviewFile]> review-files;
    in-out property <[DiffLine]> diff-lines;
    in-out property <string> current-branch;
    in-out property <[string]> branch-options;
    in-out property <int> review-added: 0;
    in-out property <int> review-removed: 0;
    in-out property <string> selected-review-file-id;
    in-out property <string> selected-review-path;
    in-out property <int> selected-review-added: 0;
    in-out property <int> selected-review-removed: 0;
    in-out property <string> review-file-search;
    in-out property <string> diff-view-mode: "unified";
    in-out property <bool> file-list-visible: true;
    // Widest diff row in device pixels, so long lines scroll horizontally
    // instead of being clipped.
    in-out property <length> diff-content-width: 0px;
    // Unified-mode scroll content height: regular rows are 20px, hunk banner
    // rows 40px, plus 8px padding on top and bottom. Computed by the C++
    // projection; the split view adds `diff-split-extra` on top (its cells
    // breathe with `py-0.5`, so every non-banner row is 4px taller).
    in-out property <length> diff-content-height: 0px;
    in-out property <length> diff-split-extra: 0px;
    property <length> diff-rows-extra: root.diff-view-mode == "split"
        ? root.diff-split-extra : 0px;

    // Workspace tree state
    in-out property <[TreeItem]> tree-items;
    in-out property <string> tree-search;
    in-out property <string> tree-file-name;
    in-out property <string> tree-file-content;
    in-out property <string> tree-selected-path;
    in-out property <string> workspace-tree-label;
    in-out property <bool> workspace-tree-visible: true;

    // Popovers
    in-out property <bool> branch-menu-open: false;
    in-out property <bool> git-menu-open: false;
    in-out property <bool> commit-modal-open: false;
    in-out property <string> commit-message;
    in-out property <bool> push-immediately: true;
    in-out property <string> staged-summary;

    // Toast feedback
    in-out property <string> toast-text;
    in-out property <bool> toast-visible: false;

    in-out property <length> code-panel-width;
    in-out property <bool> maximized: false;

    callback return-focus();
    callback drag-window();
    callback update-window-drag();
    callback end-window-drag();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback set-code-panel-visible(bool);
    callback open-right-tab(string);
    callback close-right-tab(string);
    callback add-right-tab();
    callback toggle-panel-maximized();
    callback select-review-file(string);
    callback switch-branch(string);
    callback toggle-diff-view();
    callback toggle-file-list();
    callback reveal-in-explorer();
    callback stage-all();
    callback refresh-review();
    callback discard-unstaged();
    callback commit-and-push(string, bool);
    callback toggle-hunk(string);
    callback select-tree-item(int);
    callback filter-tree(string);
    callback filter-review-files(string);
    callback dismiss-toast();

    toggle-diff-view => {
        root.diff-view-mode = root.diff-view-mode == "unified" ? "split" : "unified";
    }
    toggle-file-list => { root.file-list-visible = !root.file-list-visible; }

    min-width: root.layout-width;
    preferred-width: root.layout-width;
    max-width: root.layout-width;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    background: transparent;

    Timer {
        interval: 2500ms;
        running: root.toast-visible;
        triggered => {
            root.toast-visible = false;
            root.dismiss-toast();
        }
    }

    Rectangle {
        visible: root.layout-width > 0px;
        x: 0px;
        width: 1px;
        height: parent.height;
        z: 100;
        background: Palette.line-soft;
    }

    Rectangle {
        visible: root.layout-width > 1px;
        x: 1px;
        width: Math.max(0px, root.layout-width - 1px);
        height: parent.height;
        clip: true;
        background: Palette.surface;

        // ---- Header: closable tabs, new tab, panel and window actions ----
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 46px;
            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 10px;
                padding-right: 4px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 0px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    horizontal-stretch: 0;
                    for tab in root.right-tabs : RightTabPill {
                        title: tab.title;
                        icon: tab.id == "review" ? Icons.review : Icons.doc;
                        compact: root.code-panel-width < 300px;
                        active: root.right-tab == tab.id;
                        picked => { root.right-tab = tab.id; root.return-focus(); }
                        closed => { root.close-right-tab(tab.id); }
                    }
                    // 28px like the pills, so the header row aligns every
                    // control on the same center line.
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 999px;
                        horizontal-stretch: 0;
                        background: add-touch.has-hover ? Palette.hover-soft : transparent;
                        Image {
                            source: Icons.plus-dim;
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.add-right-tab(); }
                        }
                    }
                }
                // Draggable spacer: only this blank stretch moves the native
                // window, leaving every button independently clickable.
                Rectangle {
                    min-width: 0px;
                    preferred-width: 100000px;
                    max-width: 100000px;
                    horizontal-stretch: 1;
                    TouchArea {
                        x: 0px;
                        y: 6px;
                        width: parent.width;
                        height: parent.height - self.y;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                root.return-focus();
                                root.drag-window();
                            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                root.end-window-drag();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.update-window-drag();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;
                    horizontal-stretch: 0;
                    // This edge of the frameless window owns the native window
                    // controls. Panel expand/collapse stays on the divider rail;
                    // do not duplicate the prototype's panel buttons here.
                    ToolIcon { source: Icons.minus; icon-size: 14px; clicked => { root.minimize-window() } }
                    ToolIcon { source: Icons.stop; icon-size: 12px; clicked => { root.toggle-maximize-window() } }
                    ToolIcon { source: Icons.close; icon-size: 14px; clicked => { root.close-window() } }
                }
            }
            Rectangle {
                y: parent.height - 0.67px;
                height: 0.67px;
                width: parent.width;
                background: Palette.line-soft;
            }
        }

        // ================= VIEW 1: LAUNCHER (no tabs open) =================
        if root.right-tab == "launcher" : Rectangle {
            width: parent.width;
            y: 46px;
            height: parent.height - self.y;
            Rectangle {
                width: Math.min(260px, parent.width - 40px);
                height: 98px;
                x: (parent.width - self.width) / 2;
                y: Math.max(16px, (parent.height - self.height) / 2);
                VerticalLayout {
                    spacing: 10px;
                    LauncherEntry {
                        icon: Icons.review;
                        label: "审查";
                        shortcut: "Ctrl+Shift+G";
                        chosen => { root.open-right-tab("review"); }
                    }
                    LauncherEntry {
                        icon: Icons.folder-dim;
                        label: "文件";
                        shortcut: "Ctrl+P";
                        chosen => { root.open-right-tab("openFile"); }
                    }
                }
            }
        }

        // ================= VIEW 2: CODE REVIEW (GIT DIFF) =================
        if root.right-tab == "review" : Rectangle {
            width: parent.width;
            y: 46px;
            height: parent.height - self.y;
            VerticalLayout {
                spacing: 0px;
                // Git toolbar. A single space-between row like the prototype:
                // branch selector + stats + tracking on the left, the action
                // buttons on the right, tracking absorbing the leftover space.
                Rectangle {
                    height: 42px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            // Branch selector: naturally sized pill button.
                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: branch-touch.has-hover ? Palette.sep : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: "分支";
                                        font-size: 12.5px;
                                        font-weight: 500;
                                        color: Palette.ink;
                                        vertical-alignment: center;
                                    }
                                    Image {
                                        source: Icons.chev-down;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - 14px) / 2;
                                        colorize: Palette.dim;
                                    }
                                }
                                branch-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.branch-menu-open = !root.branch-menu-open; }
                                }
                            }
                            // Total additions / deletions badge.
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: "+" + root.review-added;
                                    font-family: "MiSans VF";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #16A34A;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "-" + root.review-removed;
                                    font-family: "MiSans VF";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #DC2626;
                                    vertical-alignment: center;
                                }
                            }
                            // Remote tracking hint; only when the panel has
                            // room for it (the prototype hides it on `sm`).
                            if root.code-panel-width >= 500px : HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.current-branch + " → origin/" + root.current-branch;
                                    font-family: "MiSans VF";
                                    font-size: 11.5px;
                                    color: Palette.dim;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Image {
                                    source: Icons.chev-down;
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - 12px) / 2;
                                    colorize: Palette.faint;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            ToolIcon {
                                source: Icons.dots;
                                icon-size: 14px;
                                width: 28px;
                                height: 28px;
                                radius: 6px;
                                clicked => { root.git-menu-open = !root.git-menu-open; }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                horizontal-stretch: 0;
                                background: root.diff-view-mode == "split" ? #FAF5EF
                                    : (diff-touch.has-hover ? Palette.sep : transparent);
                                Image {
                                    source: Icons.diff-split;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: root.diff-view-mode == "split" ? Palette.accent : Palette.dim;
                                }
                                diff-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-diff-view(); }
                                }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                horizontal-stretch: 0;
                                background: root.file-list-visible ? #FAF5EF
                                    : (panes-touch.has-hover ? Palette.sep : transparent);
                                Image {
                                    source: Icons.panes;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: root.file-list-visible ? Palette.accent : Palette.dim;
                                }
                                panes-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-file-list(); }
                                }
                            }
                            if root.code-panel-width >= 408px : ToolIcon {
                                source: Icons.folder-open;
                                icon-size: 14px;
                                width: 28px;
                                height: 28px;
                                radius: 6px;
                                clicked => { root.reveal-in-explorer(); }
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 8px;
                                horizontal-stretch: 0;
                                background: commit-touch.has-hover ? #FAF5EF : Palette.white;
                                border-width: 1px;
                                border-color: commit-touch.has-hover ? Palette.accent : Palette.border;
                                HorizontalLayout {
                                    padding-left: root.code-panel-width >= 408px ? 10px : 7px;
                                    padding-right: root.code-panel-width >= 408px ? 8px : 7px;
                                    spacing: 6px;
                                    Image {
                                        source: Icons.commit;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - 14px) / 2;
                                    }
                                    if root.code-panel-width >= 408px : Text {
                                        text: "提交或推送";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Palette.body;
                                        vertical-alignment: center;
                                    }
                                    if root.code-panel-width >= 408px : Image {
                                        source: Icons.chev-down;
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - 12px) / 2;
                                        colorize: Palette.dim;
                                    }
                                }
                                commit-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.commit-modal-open = !root.commit-modal-open; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.line-soft;
                    }
                }
                // Diff body: viewer plus the optional changed-files list
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 34px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Image {
                                            source: Icons.doc;
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - 14px) / 2;
                                            colorize: Palette.dim;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.selected-review-path;
                                            font-family: "MiSans VF";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: Palette.ink;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "+" + root.selected-review-added;
                                            font-family: "MiSans VF";
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: #16A34A;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "-" + root.selected-review-removed;
                                            font-family: "MiSans VF";
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: #DC2626;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 0.67px;
                                    height: 0.67px;
                                    width: parent.width;
                                    background: Palette.border;
                                }
                            }
                            if root.diff-view-mode == "split" : Rectangle {
                                height: 24px;
                                HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: #FAFAFA;
                                        Text {
                                            x: 8px;
                                            height: parent.height;
                                            text: "原版本 (Original)";
                                            font-size: 11px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: #FAFAFA;
                                        Rectangle {
                                            x: 0px;
                                            width: 1px;
                                            height: parent.height;
                                            background: Palette.border;
                                        }
                                        Text {
                                            x: 8px;
                                            height: parent.height;
                                            text: "修改后 (Modified)";
                                            font-size: 11px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 0.67px;
                                    height: 0.67px;
                                    width: parent.width;
                                    background: Palette.border;
                                }
                            }
                            if root.diff-lines.length > 0 : ScrollView {
                                vertical-stretch: 1;
                                viewport-width: root.diff-content-width + 16px;
                                viewport-height: (root.diff-content-height > 0px
                                    ? root.diff-content-height
                                    : root.diff-lines.length * 20px + 16px)
                                    + root.diff-rows-extra;
                                // The prototype scrolls a `p-2` table, so the
                                // whole diff body is inset 8px on every side.
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 0px;
                                    if root.diff-view-mode == "unified" : VerticalLayout {
                                        height: (root.diff-content-height > 0px
                                            ? root.diff-content-height - 16px
                                            : root.diff-lines.length * 20px);
                                        spacing: 0px;
                                        for line in root.diff-lines : UnifiedDiffRow {
                                            line: line;
                                            toggle-hunk(hunk) => { root.toggle-hunk(hunk); }
                                        }
                                    }
                                    if root.diff-view-mode == "split" : VerticalLayout {
                                        height: (root.diff-content-height > 0px
                                            ? root.diff-content-height - 16px
                                            : root.diff-lines.length * 20px)
                                            + root.diff-rows-extra;
                                        spacing: 0px;
                                        for line in root.diff-lines : SplitDiffRow {
                                            line: line;
                                        }
                                    }
                                }
                            }
                            if root.diff-lines.length == 0 : Rectangle {
                                vertical-stretch: 1;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.current-branch == "" ? "当前工作空间不是 Git 仓库。"
                                        : root.review-files.length == 0 ? "工作区干净，没有待审查的更改。"
                                        : "该文件没有可显示的文本差异。";
                                    font-size: 12.5px;
                                    color: Palette.faint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if root.file-list-visible : Rectangle {
                        width: Math.max(192px, Math.min(224px, parent.width - 200px));
                        horizontal-stretch: 0;
                        Rectangle {
                            x: 0px;
                            width: 1px;
                            height: parent.height;
                            background: Palette.line-soft;
                        }
                        VerticalLayout {
                            spacing: 0px;
                            // Search zone (`p-2` in the prototype).
                            VerticalLayout {
                                padding: 8px;
                                PanelFilter {
                                    text <=> root.review-file-search;
                                    placeholder: "筛选文件...";
                                    edited(value) => { root.filter-review-files(value); }
                                }
                            }
                            // Files list (`p-1.5` with 4px row gaps); the
                            // ScrollView sizes its viewport to the rows.
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    for file in root.review-files : ReviewFileRow {
                                        file: file;
                                        active: file.id == root.selected-review-file-id;
                                        picked => { root.select-review-file(file.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= VIEW 3: WORKSPACE FILE TREE =================
        if root.right-tab == "openFile" : Rectangle {
            width: parent.width;
            y: 46px;
            height: parent.height - self.y;
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 34px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: root.workspace-tree-label;
                                        font-family: "MiSans VF";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.ink;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.tree-selected-path == ""
                                            ? "" : "/ " + root.tree-selected-path;
                                        font-family: "MiSans VF";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Palette.ink;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    horizontal-stretch: 0;
                                    background: tree-toggle.has-hover ? Palette.hover-soft : transparent;
                                    Image {
                                        source: Icons.folder-dim;
                                        width: 16px;
                                        height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: root.workspace-tree-visible ? Palette.accent : Palette.dim;
                                    }
                                    tree-toggle := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.workspace-tree-visible = !root.workspace-tree-visible; }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 0.67px;
                                height: 0.67px;
                                width: parent.width;
                                background: Palette.line-soft;
                            }
                        }
                        if root.tree-file-name != "" : ScrollView {
                            vertical-stretch: 1;
                            // Wrap at the visible width; only vertical scrolling.
                            viewport-width: self.width;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.tree-file-name;
                                        font-family: "MiSans VF";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.ink;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "只读模式";
                                        font-size: 11px;
                                        color: Palette.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: Palette.line-soft;
                                }
                                Text {
                                    font-family: "MiSans VF";
                                    font-size: 12px;
                                    color: Palette.body;
                                    text: root.tree-file-content;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                }
                            }
                        }
                        if root.tree-file-name == "" : Rectangle {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    x: (parent.width - self.width) / 2;
                                    border-radius: 16px;
                                    background: Palette.white;
                                    border-width: 0.67px;
                                    border-color: Palette.card-line;
                                    drop-shadow-color: Palette.shadow;
                                    drop-shadow-offset-y: 1px;
                                    Image {
                                        source: Icons.folder-open;
                                        width: 32px;
                                        height: 32px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Palette.dim;
                                    }
                                }
                                Text {
                                    text: "打开文件";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Palette.ink;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "从工作区目录树中选择文件";
                                    font-size: 12.5px;
                                    color: Palette.dim;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
                if root.workspace-tree-visible : Rectangle {
                    width: Math.max(224px, Math.min(256px, parent.width - 220px));
                    horizontal-stretch: 0;
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Palette.line-soft;
                    }
                    VerticalLayout {
                        spacing: 0px;
                        // Search zone (`p-2.5` in the prototype).
                        VerticalLayout {
                            padding: 10px;
                            PanelFilter {
                                field-radius: 12px;
                                text-indent: 32px;
                                field-font-size: 12px;
                                text <=> root.tree-search;
                                placeholder: "筛选文件...";
                                edited(value) => { root.filter-tree(value); }
                            }
                        }
                        // Tree list (`p-2` with 2px row gaps); the ScrollView
                        // sizes its viewport to the rows.
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                for item[index] in root.tree-items : TreeRow {
                                    item: item;
                                    active: root.tree-selected-path != "" && item.path == root.tree-selected-path;
                                    picked => { root.select-tree-item(index); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // The dismissal surface must be behind the popovers. When it was
        // declared after them it intercepted every click, which made branch
        // selection and commit inputs appear broken.
        if root.branch-menu-open || root.git-menu-open || root.commit-modal-open : TouchArea {
            y: 46px;
            height: parent.height - self.y;
            clicked => {
                root.branch-menu-open = false;
                root.git-menu-open = false;
                root.commit-modal-open = false;
            }
        }

        // ---- Branch dropdown ----
        if root.branch-menu-open : Rectangle {
            x: 12px;
            y: 85px;
            width: 192px;
            // Absolute children would fill the panel; hug the content instead.
            height: branch-col.preferred-height;
            background: Palette.white;
            border-radius: 12px;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.14);
            drop-shadow-offset-y: 5px;
            drop-shadow-blur: 14px;
            TouchArea { clicked => { root.branch-menu-open = false; } }
            branch-col := VerticalLayout {
                padding: 4px;
                Text {
                    x: 8px;
                    height: 22px;
                    text: "切换 Git 分支";
                    font-size: 11px;
                    font-weight: 600;
                    color: Palette.faint;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 1px;
                    background: Palette.hairline;
                }
                for branch in root.branch-options : MenuOption {
                    label: branch;
                    active: branch == root.current-branch;
                    show-check: true;
                    hover-tint: #FEF3D6;
                    active-tint: #FAF5EF;
                    chosen => {
                        root.switch-branch(branch);
                        root.branch-menu-open = false;
                    }
                }
            }
        }

        // ---- Git "more" menu ----
        if root.git-menu-open : Rectangle {
            x: parent.width - 190px;
            y: 85px;
            width: 176px;
            height: git-menu-col.preferred-height;
            background: Palette.white;
            border-radius: 12px;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.14);
            drop-shadow-offset-y: 5px;
            drop-shadow-blur: 14px;
            TouchArea { clicked => { root.git-menu-open = false; } }
            git-menu-col := VerticalLayout {
                padding: 4px;
                MenuOption {
                    label: "暂存全部更改";
                    active: false;
                    chosen => { root.git-menu-open = false; root.stage-all(); }
                }
                MenuOption {
                    label: "刷新审查状态";
                    active: false;
                    chosen => { root.git-menu-open = false; root.refresh-review(); }
                }
                MenuOption {
                    label: "放弃未暂存更改";
                    active: false;
                    danger: true;
                    chosen => { root.git-menu-open = false; root.discard-unstaged(); }
                }
            }
        }

        // ---- Commit & push popover ----
        if root.commit-modal-open : Rectangle {
            x: Math.max(8px, parent.width - 300px);
            y: 89px;
            width: 288px;
            height: commit-col.preferred-height;
            background: Palette.white;
            border-radius: 16px;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.18);
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 20px;
            commit-col := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "提交更改到 " + root.current-branch;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.ink;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        horizontal-stretch: 0;
                        background: close-commit.has-hover ? Palette.sep : transparent;
                        Image {
                            source: Icons.close;
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        close-commit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.commit-modal-open = false; }
                        }
                    }
                }
                Text {
                    text: root.staged-summary;
                    font-size: 11.5px;
                    color: Palette.dim;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 72px;
                    border-radius: 12px;
                    background: Palette.input;
                    border-width: 1px;
                    border-color: commit-input.has-focus ? Palette.accent : Palette.border;
                    commit-input := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        font-size: 12px;
                        color: Palette.ink;
                        wrap: word-wrap;
                        text <=> root.commit-message;
                    }
                    if root.commit-message == "" : Text {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        text: "输入提交信息 (例如: feat: 更新字幕文本)...";
                        font-size: 12px;
                        color: Palette.faint;
                        wrap: word-wrap;
                    }
                }
                Rectangle {
                    height: 22px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - 18px) / 2;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: root.push-immediately ? Palette.accent : Palette.border;
                            background: root.push-immediately ? Palette.accent : Palette.white;
                            if root.push-immediately : Image {
                                source: Icons.check-small;
                                width: 11px;
                                height: 11px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Palette.white;
                            }
                            push-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.push-immediately = !root.push-immediately; }
                            }
                        }
                        Text {
                            text: "提交后立即推送到远程 origin/" + root.current-branch;
                            font-size: 11.5px;
                            color: Palette.mid;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        height: 28px;
                        border-radius: 8px;
                        horizontal-stretch: 0;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: cancel-commit.has-hover ? Palette.sep : Palette.white;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "取消";
                                font-size: 12px;
                                color: Palette.mid;
                                vertical-alignment: center;
                            }
                        }
                        cancel-commit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.commit-modal-open = false; }
                        }
                    }
                    Rectangle {
                        height: 28px;
                        border-radius: 8px;
                        horizontal-stretch: 0;
                        background: do-commit.has-hover ? #B85E20 : Palette.accent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.push-immediately ? "提交并推送" : "仅提交";
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.white;
                                vertical-alignment: center;
                            }
                        }
                        do-commit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.commit-and-push(root.commit-message, root.push-immediately);
                                root.commit-message = "";
                                root.commit-modal-open = false;
                            }
                        }
                    }
                }
            }
        }

        // ---- Toast ----
        if root.toast-visible : Rectangle {
            x: (parent.width - self.width) / 2;
            y: 48px;
            width: Math.min(parent.width - 24px, toast-label.preferred-width + 50px);
            height: 30px;
            border-radius: 8px;
            background: #1C1917;
            drop-shadow-color: rgba(0, 0, 0, 0.24);
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;
                Image {
                    source: Icons.check-circle-green;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - 14px) / 2;
                }
                toast-label := Text {
                    text: root.toast-text;
                    font-size: 12px;
                    color: Palette.white;
                    vertical-alignment: center;
                }
            }
        }
    }

}
