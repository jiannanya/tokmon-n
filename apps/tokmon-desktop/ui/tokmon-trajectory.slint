import { ListView, ScrollView } from "std-widgets.slint";
import { Palette, Icons } from "tokmon-theme.slint";
import { GanttSegment, TraceEvent } from "tokmon-models.slint";
import { ToolIcon, PillBadge, TraceEventRow, SelectBox } from "tokmon-components.slint";

export component TrajectoryPanel inherits Rectangle {
    in property <[TraceEvent]> trace-events;
    in property <[GanttSegment]> gantt;
    in property <[string]> trace-ticks;
    in property <string> model-name;
    in property <string> access-mode;
    in property <string> effort;
    in property <string> assistant-text;
    in property <string> setting-command-approval;
    in property <string> trace-duration;
    in property <string> trace-provider;
    in property <string> trace-model;
    in property <string> trace-result;
    in property <string> trace-total-label;
    in property <string> trace-prompt-label;
    in property <string> trace-completion-label;
    in property <int> trace-turns;
    in property <int> trace-calls;
    in property <int> trace-total;
    in property <int> trace-pages;
    in-out property <string> trace-search;
    in-out property <int> trace-selected-num;
    in-out property <int> request-tab;
    in-out property <int> trace-filter-index;
    in-out property <int> trace-page;
    in-out property <int> trace-page-size;
    in-out property <bool> trace-filter-open;

    callback refresh-trace();
    callback export-trace();
    pure callback page-range-label() -> string;
    clip: true;
    trace-scroll := ScrollView {
        viewport-width: self.visible-width;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            width: trace-scroll.visible-width;
            padding-top: 20px;
            padding-bottom: 20px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 16px;
            Rectangle {
                border-radius: 16px;
                background: Palette.white;
                border-width: 0.67px;
                border-color: Palette.border;
                drop-shadow-color: Palette.shadow;
                drop-shadow-offset-y: 1px;
                drop-shadow-blur: 0px;
                height: 54px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 24px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "🕒"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Duration "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-duration; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "💬"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Turns "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-turns; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "⚙️"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Calls "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-calls; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "📊"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Total Tokens "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-total-label; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "📥"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Prompt "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-prompt-label; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "📤"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Completion "; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                        Text { text: root.trace-completion-label; font-size: 12px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 220px;
                        horizontal-stretch: 0;
                        height: 27px;
                        border-radius: 8px;
                        background: Palette.input;
                        border-width: 0.67px;
                        border-color: Palette.border;
                        Image {
                            source: Icons.search;
                            x: 10px;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                        }
                        trace-q := TextInput {
                            x: 32px;
                            width: parent.width - 40px;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 11.5px;
                            color: Palette.body;
                            text <=> root.trace-search;
                            edited => { root.refresh-trace() }
                            accepted => { root.refresh-trace() }
                        }
                        if true : Text {
                            x: 32px;
                            height: parent.height;
                            text: "搜索轨迹...";
                            font-size: 11.5px;
                            color: rgba(28, 25, 23, 0.5);
                            vertical-alignment: center;
                            visible: trace-q.text == "";
                        }
                    }
                }
            }
            Rectangle {
                border-radius: 16px;
                background: Palette.white;
                border-width: 0.67px;
                border-color: Palette.border;
                drop-shadow-color: Palette.shadow;
                drop-shadow-offset-y: 1px;
                drop-shadow-blur: 0px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Rectangle {
                        height: 23px;
                        HorizontalLayout {
                            x: 76px;
                            width: parent.width - 92px;
                            alignment: space-between;
                            for tick in root.trace-ticks : Text {
                                text: tick;
                                font-family: "MiSans VF";
                                font-size: 11px;
                                color: Palette.faint;
                            }
                        }
                        Rectangle {
                            y: parent.height - 0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.sep;
                        }
                    }
                    Rectangle {
                        height: 90px;
                        Text {
                            x: 0px;
                            y: 19px;
                            width: 60px;
                            text: "Input";
                            font-size: 11.5px;
                            font-weight: 500;
                            color: Palette.dim;
                            horizontal-alignment: right;
                        }
                        Text {
                            x: 0px;
                            y: 45px;
                            width: 60px;
                            text: "Model";
                            font-size: 11.5px;
                            font-weight: 500;
                            color: Palette.dim;
                            horizontal-alignment: right;
                        }
                        Text {
                            x: 0px;
                            y: 71px;
                            width: 60px;
                            text: "Tools";
                            font-size: 11.5px;
                            font-weight: 500;
                            color: Palette.dim;
                            horizontal-alignment: right;
                        }
                        Rectangle {
                            x: 72px;
                            y: 12px;
                            width: parent.width - 72px;
                            height: 78px;
                            Rectangle {
                                y: 7px;
                                height: 12px;
                                width: parent.width;
                                border-radius: 999px;
                                background: Palette.sep;
                            }
                            Rectangle {
                                y: 33px;
                                height: 12px;
                                width: parent.width;
                                border-radius: 999px;
                                background: Palette.sep;
                            }
                            Rectangle {
                                y: 59px;
                                height: 12px;
                                width: parent.width;
                                border-radius: 999px;
                                background: Palette.sep;
                            }
                            for seg in root.gantt : Rectangle {
                                y: seg.row * 26px + 7px;
                                x: seg.start * parent.width;
                                width: Math.max(8px, seg.span * parent.width);
                                height: 12px;
                                border-radius: 999px;
                                background: seg.tint;
                            }
                        }
                    }
                    Rectangle {
                        height: 27px;
                        HorizontalLayout {
                            y: 8px;
                            spacing: 24px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 4px; background: Palette.bar-gray; y: 4px; }
                                Text { text: "Input"; font-size: 11.5px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 4px; background: #3B82F6; y: 4px; }
                                Text { text: "Model (Thinking)"; font-size: 11.5px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 4px; background: #22C55E; y: 4px; }
                                Text { text: "Model (Generating)"; font-size: 11.5px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 4px; background: #A855F7; y: 4px; }
                                Text { text: "Tool Call"; font-size: 11.5px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 4px; background: #F97316; y: 4px; }
                                Text { text: "Tool Result"; font-size: 11.5px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            y: -0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.sep;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: Math.max(520px, trace-scroll.visible-width - 56px - trace-details.width);
                    horizontal-stretch: 0;
                    border-radius: 16px;
                    background: Palette.white;
                    border-width: 0.67px;
                    border-color: Palette.border;
                    drop-shadow-color: Palette.shadow;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-blur: 0px;
                    min-height: 380px;
                    VerticalLayout {
                        padding: 16px;
                        HorizontalLayout {
                            padding-bottom: 12px;
                            alignment: space-between;
                            Text {
                                text: "事件列表 (" + root.trace-total + ")";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: Palette.ink;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Rectangle {
                                    height: 27px;
                                    border-radius: 8px;
                                    background: Palette.surface;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 4px;
                                        Image { source: Icons.funnel; width: 12px; height: 12px; y: (parent.height - 12px) / 2; }
                                        Text {
                                            text: root.trace-filter-index == 0 ? "筛选" : root.trace-filter-index == 1 ? "USER" : root.trace-filter-index == 2 ? "CONTEXT" : root.trace-filter-index == 3 ? "ASSISTANT" : "TOOL";
                                            font-size: 11.5px;
                                            color: Palette.mid;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.trace-filter-open = !root.trace-filter-open }
                                        mouse-cursor: pointer;
                                    }
                                }
                                Rectangle {
                                    height: 27px;
                                    border-radius: 8px;
                                    background: Palette.surface;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 4px;
                                        Image { source: Icons.download; width: 12px; height: 12px; y: (parent.height - 12px) / 2; }
                                        Text { text: "导出"; font-size: 11.5px; color: Palette.mid; vertical-alignment: center; }
                                    }
                                    TouchArea {
                                        clicked => { root.export-trace() }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                padding-left: 4px;
                                alignment: start;
                                Text { width: 28px; horizontal-stretch: 0; text: "#"; font-size: 11.5px; font-weight: 700; color: Palette.faint; vertical-alignment: center; }
                                Text { width: 118px; horizontal-stretch: 0; text: "时间"; font-size: 11.5px; font-weight: 700; color: Palette.faint; vertical-alignment: center; }
                                Text { width: 140px; horizontal-stretch: 0; text: "类型"; font-size: 11.5px; font-weight: 700; color: Palette.faint; vertical-alignment: center; }
                                Text { width: 96px; horizontal-stretch: 0; text: "角色"; font-size: 11.5px; font-weight: 700; color: Palette.faint; vertical-alignment: center; }
                                Text { text: "内容 / 名称"; font-size: 11.5px; font-weight: 700; color: Palette.faint; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { width: 72px; horizontal-stretch: 0; text: "耗时"; font-size: 11.5px; font-weight: 700; color: Palette.faint; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 64px; horizontal-stretch: 0; text: "Tokens"; font-size: 11.5px; font-weight: 700; color: Palette.faint; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            Rectangle {
                                y: parent.height - 0.67px;
                                height: 0.67px;
                                width: parent.width;
                                background: Palette.sep;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            min-height: 200px;
                            for event in root.trace-events : TraceEventRow {
                                event: event;
                                selected-num: root.trace-selected-num;
                                pick => { root.trace-selected-num = event.num }
                            }
                        }
                        HorizontalLayout {
                            padding-top: 12px;
                            alignment: space-between;
                            Text {
                                text: root.page-range-label();
                                font-size: 11.5px;
                                color: Palette.dim;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                ToolIcon {
                                    source: Icons.chev-left;
                                    icon-size: 14px;
                                    enabled: root.trace-page > 1;
                                    clicked => {
                                        root.trace-page = Math.max(1, root.trace-page - 1);
                                        root.refresh-trace();
                                    }
                                }
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: Palette.chip;
                                    border-width: 0.67px;
                                    border-color: Palette.chip-line;
                                    Text {
                                        text: root.trace-page;
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: Palette.chip-ink;
                                        x: (parent.width - self.preferred-width) / 2;
                                        y: (parent.height - self.preferred-height) / 2;
                                    }
                                }
                                Text {
                                    text: "/ " + root.trace-pages;
                                    font-size: 11.5px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                                ToolIcon {
                                    source: Icons.chev-right;
                                    icon-size: 14px;
                                    enabled: root.trace-page < root.trace-pages;
                                    clicked => {
                                        root.trace-page = Math.min(root.trace-pages, root.trace-page + 1);
                                        root.refresh-trace();
                                    }
                                }
                                SelectBox {
                                    box-width: 92px;
                                    value: root.trace-page-size + " 条/页";
                                    options: ["20 条/页", "50 条/页", "100 条/页"];
                                    selected(i, o) => {
                                        root.trace-page-size = i == 0 ? 20 : i == 1 ? 50 : 100;
                                        root.trace-page = 1;
                                        root.refresh-trace();
                                    }
                                }
                            }
                        }
                    }
                }
                trace-details := Rectangle {
                    width: Math.min(320px, (trace-scroll.visible-width - 40px) * 0.34);
                    horizontal-stretch: 0;
                    border-radius: 16px;
                    background: Palette.white;
                    border-width: 0.67px;
                    border-color: Palette.border;
                    drop-shadow-color: Palette.shadow;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-blur: 0px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "请求详情 · Turn " + Math.max(1, root.trace-turns); font-size: 13.5px; font-weight: 700; color: Palette.ink; vertical-alignment: center; }
                            PillBadge { label: root.trace-result == "已完成" ? "COMPLETED" : root.trace-result; tone: root.trace-result == "已完成" ? "CONTEXT" : root.trace-result == "执行失败" ? "ERROR" : "OTHER"; }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            for tab[ti] in ["Summary", "Options", "Usage", "Timing"] : Rectangle {
                                width: tname.width + 4px;
                                horizontal-stretch: 0;
                                tname := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: tab;
                                    font-size: 12px;
                                    font-weight: root.request-tab == ti ? 600 : 500;
                                    color: root.request-tab == ti ? Palette.amber : Palette.dim;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.request-tab == ti ? Palette.amber : transparent;
                                }
                                TouchArea {
                                    clicked => { root.request-tab = ti }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;
                                if root.request-tab == 0 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "Provider"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-provider; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; overflow: elide; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Model"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-model; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; overflow: elide; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Tool calls"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-calls; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Result"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: top; } Text { text: root.assistant-text == "" ? "-" : root.assistant-text; font-size: 12px; color: Palette.body; wrap: word-wrap; overflow: elide; } }
                                }
                                if root.request-tab == 1 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "权限模式"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.access-mode; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "推理力度"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.effort; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "会话模型"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.model-name; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; overflow: elide; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "命令审批"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.setting-command-approval; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                                if root.request-tab == 2 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "Prompt"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-prompt-label; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Completion"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-completion-label; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Total"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-total-label; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                                if root.request-tab == 3 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "Duration"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-duration; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Turns"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-turns; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Calls"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-calls; font-family: "MiSans VF"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
