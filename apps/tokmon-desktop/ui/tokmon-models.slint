export struct NavigationItem {
    id: string,
    ray: string,
    workspace: string,
    kind: string,
    title: string,
    title-manual: bool,
    icon: image,
    indent: int,
    selected: bool,
    expandable: bool,
    expanded: bool,
}

export struct ModelChoice {
    name: string,
    model: string,
    label: string,
}

export struct TimelineItem {
    time: string,
    kind: string,
    title: string,
    detail: string,
    tone: string,
    progress: int,
}

export struct CodeLine {
    number: int,
    text: string,
    tone: string,
}

export struct SlashCommandItem {
    command: string,
    usage: string,
    summary: string,
    category: string,
}

// One formatted segment of an assistant reply, produced by the C++ side from
// real markdown parsing (md4c). The UI renders structure instead of literal
// markdown markers.
export struct ChatBlock {
    // "paragraph" | "heading" | "bullet" | "ordered" | "code" | "rule"
    kind: string,
    // Inline-rich text content, already serialized into the StyledText
    // markup subset (bold/emphasis/code/links); raw source for "code".
    title: string,
    // "1." style ordinal for ordered items, empty otherwise.
    ordinal: string,
    // Nesting context: list indent levels for items, 1-6 for headings.
    depth: int,
    // Parsed rich-text value ready for StyledText; produced by the C++
    // runtime markdown converter (falls back to plain text).
    rich: styled-text,
}

export struct ProjectFile {
    name: string,
    path: string,
    group-title: string,
}

export struct GanttSegment {
    row: int,
    start: float,
    span: float,
    tint: color,
}

export struct TraceEvent {
    num: int,
    time: string,
    tone: string,
    role: string,
    title: string,
    detail: string,
    dur: string,
    tokens: string,
}
