import { NavigationItem, TimelineItem, TraceEvent, ChatBlock } from "tokmon-models.slint";
import { Palette, Icons } from "tokmon-theme.slint";

export component ToolIcon inherits Rectangle {
    in property <image> source;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    background: ta.has-hover ? Palette.sep : transparent;
    border-radius: 8px;
    min-width: self.icon-size + 12px;
    min-height: self.icon-size + 12px;
    ta := TouchArea {
        enabled: parent.enabled;
        clicked => { parent.clicked() }
        mouse-cursor: pointer;
    }
    Image {
        source: parent.source;
        width: parent.icon-size;
        height: parent.icon-size;
        x: (parent.width - parent.icon-size) / 2;
        y: (parent.height - parent.icon-size) / 2;
    }
}

export component StatusDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: self.tone == "success" ? #16A34A
        : self.tone == "warning" ? #D97706
        : self.tone == "danger" ? #EF4444 : #A8A29E;
}

export component MenuOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? Palette.sep : (active ? Palette.accent-bg : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: 12.5px;
            color: root.active ? Palette.accent-text : Palette.body;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { parent.chosen() }
        mouse-cursor: pointer;
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 999px;
    background: self.checked ? Palette.accent : #E7E5E4;
    animate background { duration: 120ms; }
    Rectangle {
        x: parent.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: white;
        drop-shadow-color: rgba(0, 0, 0, 0.18);
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 5px;
        animate x { duration: 120ms; }
    }
    TouchArea {
        clicked => { root.toggled(!root.checked) }
        mouse-cursor: pointer;
    }
}

export component SegTrack inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> warm: false;
    in property <bool> compact: false;
    callback picked(int, string);
    background: Palette.sep;
    border-radius: 12px;
    border-width: 0.67px;
    border-color: Palette.border;
    height: 35px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding: 4px;
        spacing: 0px;
        for option[index] in root.options : Rectangle {
            background: index == root.selected ? (root.warm ? Palette.chip : Palette.accent-bg) : transparent;
            border-radius: 8px;
            drop-shadow-color: index == root.selected ? Palette.shadow : transparent;
            drop-shadow-offset-y: 1px;
            drop-shadow-blur: 0px;
            HorizontalLayout {
                padding-left: root.compact ? 8px : 16px;
                padding-right: root.compact ? 8px : 16px;
                Text {
                    text: option;
                    font-size: root.compact ? 11.5px : 12.5px;
                    font-weight: index == root.selected ? 600 : 500;
                    color: index == root.selected ? (root.warm ? Palette.chip-ink : Palette.accent-text) : Palette.dim;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => { root.picked(index, option) }
                mouse-cursor: pointer;
            }
        }
    }
}

export component SelectBox inherits Rectangle {
    in property <string> value;
    in property <[string]> options;
    in property <bool> drop-up: false;
    in property <bool> mono: false;
    in property <length> box-width: 132px;
    callback selected(int, string);
    property <bool> open: false;
    width: self.box-width;
    height: 31.33px;
    border-radius: 12px;
    background: Palette.surface;
    border-width: 0.67px;
    border-color: Palette.border;
    Text {
        x: 14px;
        width: parent.width - 46px;
        text: parent.value;
        font-family: "MiSans VF";
        font-size: 13px;
        color: Palette.ink;
        overflow: elide;
        vertical-alignment: center;
    }
    Image {
        source: Icons.chev-down-faint;
        width: 10px;
        height: 6px;
        x: parent.width - 22px;
        y: (parent.height - 6px) / 2;
    }
    TouchArea {
        clicked => { parent.open = !parent.open }
        mouse-cursor: pointer;
    }
    if self.open : Rectangle {
        x: 0px;
        y: parent.drop-up ? -self.height - 6px : parent.height + 6px;
        width: Math.max(parent.width, 190px);
        height: Math.min(root.options.length, 6) * 32px + 8px;
        background: Palette.white;
        border-radius: 12px;
        border-width: 0.67px;
        border-color: Palette.border;
        drop-shadow-color: rgba(0, 0, 0, 0.14);
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 16px;
        VerticalLayout {
            padding: 4px;
            for option[index] in root.options : MenuOption {
                label: option;
                active: option == root.value;
                chosen => {
                    root.selected(index, option);
                    root.open = false;
                }
            }
        }
        TouchArea { clicked => { root.open = false } }
    }
}

export component RowShell inherits Rectangle {
    in property <string> label;
    in property <bool> separated: true;
    in property <bool> tall: false;
    height: !self.separated ? 41px : (self.tall ? 57px : 49px);
    vertical-stretch: 0;
    HorizontalLayout {
        padding-top: 0px;
        padding-bottom: root.separated ? 16px : 0px;
        alignment: space-between;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 500;
            color: Palette.ink;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            @children
        }
    }
    if self.separated : Rectangle {
        y: parent.height - 0.67px;
        height: 0.67px;
        width: parent.width;
        background: Palette.sep;
    }
}

export component OverviewLine inherits Rectangle {
    in property <string> key;
    in property <string> val;
    in property <color> value-color: Palette.ink;
    in property <bool> mono-value: false;
    height: 46px;
    VerticalLayout {
        Text {
            text: root.key;
            font-size: 12.5px;
            color: Palette.faint;
        }
        Text {
            text: root.val;
            font-family: "MiSans VF";
            font-size: root.mono-value ? 11px : 12.5px;
            font-weight: 700;
            color: root.value-color;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component KeyCap inherits Rectangle {
    in property <string> label;
    background: Palette.white;
    border-radius: 8px;
    border-width: 0.67px;
    border-color: Palette.border;
    drop-shadow-color: Palette.shadow;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 0px;
    min-width: 26px;
    height: 26px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            font-family: "MiSans VF";
            font-size: 12px;
            color: Palette.strong;
            vertical-alignment: center;
        }
    }
}

export component SwatchDot inherits Rectangle {
    in property <color> fill;
    in property <bool> active;
    callback picked;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: self.fill;
    if root.active : Rectangle {
        x: -4px;
        y: -4px;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        border-width: 3px;
        border-color: root.fill;
        background: transparent;
    }
    TouchArea {
        clicked => { parent.picked() }
        mouse-cursor: pointer;
    }
}

export component PillBadge inherits Rectangle {
    in property <string> label;
    in property <string> tone;
    height: 16px;
    border-radius: 4px;
    background: self.tone == "USER" ? #E0F2FE
        : self.tone == "CONTEXT" ? #DCFCE7
        : self.tone == "ASSISTANT" ? #F3E8FF
        : self.tone == "MODEL" ? #EDE9FE
        : self.tone == "TOOL" ? #FEF3D6
        : self.tone == "LENS" ? #ECFDF5
        : self.tone == "ERROR" ? #FEE2E2 : #ECFDF5;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-family: "MiSans VF";
            font-weight: 700;
            font-size: 10.5px;
            color: root.tone == "USER" ? #0284C7
                : root.tone == "CONTEXT" ? #16A34A
                : root.tone == "ASSISTANT" ? #9333EA
                : root.tone == "MODEL" ? #7C3AED
                : root.tone == "TOOL" ? #B45309
                : root.tone == "LENS" ? #059669
                : root.tone == "ERROR" ? #DC2626 : #059669;
            vertical-alignment: center;
        }
    }
}

export component StepDot inherits Rectangle {
    in property <string> tone;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: self.tone == "success" ? rgba(34, 197, 94, 0.2)
        : self.tone == "warning" ? #FEF3D6
        : self.tone == "danger" ? rgba(239, 68, 68, 0.15)
        : self.tone == "running" ? transparent : Palette.accent-bg;
    border-width: 0.67px;
    border-color: self.tone == "success" ? #22C55E
        : self.tone == "warning" ? #F59E0B
        : self.tone == "danger" ? #EF4444
        : self.tone == "running" ? #A8A29E : Palette.accent-border;
    if self.tone == "success" : Image {
        source: Icons.check-small;
        width: 10px;
        height: 10px;
        x: 2px;
        y: 2px;
    }
    if self.tone == "warning" || self.tone == "danger" : Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: root.tone == "warning" ? #D97706 : #EF4444;
        x: 4px;
        y: 4px;
    }
    if self.tone == "running" : Image {
        source: Icons.spinner;
        width: 10px;
        height: 10px;
        x: 2px;
        y: 2px;
    }
    if self.tone != "success" && self.tone != "warning" && self.tone != "danger" && self.tone != "running" : Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: Palette.accent;
        x: 4px;
        y: 4px;
    }
}

export component SidebarRow inherits Rectangle {
    in property <NavigationItem> item;
    in property <int> row-index;
    callback selected;
    callback quick-create;
    height: 30px;
    border-radius: 6px;
    background: root.item.selected ? Palette.accent-bg : (ta.has-hover ? rgba(0, 0, 0, 0.03) : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 12px;
            horizontal-stretch: 0;
            visible: root.item.expandable;
            Image {
                source: root.item.expanded ? Icons.chev-down-faint : Icons.chev-right-faint;
                width: 12px;
                height: 12px;
                y: (parent.height - 12px) / 2;
            }
        }
        Rectangle {
            width: 12px;
            horizontal-stretch: 0;
            visible: !root.item.expandable;
        }
        Image {
            source: root.item.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - 14px) / 2;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.title;
            font-size: root.item.kind == "group" ? 13px : 12.5px;
            font-weight: root.item.selected ? 600 : (root.item.kind == "group" ? 600 : (root.item.kind == "project" ? 500 : 400));
            color: root.item.selected ? Palette.accent-text
                : root.item.kind == "session" ? Palette.mid : Palette.strong;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            width: 22px;
            height: 22px;
            horizontal-stretch: 0;
            border-radius: 6px;
            visible: root.item.expandable && ta.has-hover && !qta.has-hover;
            Image {
                source: Icons.plus-dim;
                width: 14px;
                height: 14px;
                x: (parent.width - 14px) / 2;
                y: (parent.height - 14px) / 2;
            }
            qta := TouchArea {
                clicked => { root.quick-create() }
                mouse-cursor: pointer;
            }
        }
    }
    ta := TouchArea {
        clicked => { parent.selected() }
        mouse-cursor: pointer;
    }
}

// One parsed markdown block of the assistant reply (see chat_blocks_from).
// Root is a layout so every branch keeps full row width and natural height;
// rich lines go through StyledText consuming the markup subset emitted by the
// C++ serializer.
export component ChatBlockRow inherits VerticalLayout {
    in property <ChatBlock> block;

    property <bool> rule: root.block.kind == "rule";
    property <bool> code: root.block.kind == "code";
    property <bool> bullet: root.block.kind == "bullet";
    property <bool> ordered: root.block.kind == "ordered";
    property <bool> heading: root.block.kind == "heading";
    property <length> indent: root.heading || (!root.bullet && !root.ordered)
        ? (root.block.depth > 0 && !root.heading ? (root.block.depth * 12px)
                                                 : 0px)
        : ((root.block.depth - 1) * 12px);

    if root.rule : Rectangle {
        height: 15px;
        vertical-stretch: 0;
        Rectangle {
            y: (parent.height - 1px) / 2;
            x: 2px;
            width: parent.width - 4px;
            height: 1px;
            background: #DEDCD6;
        }
    }

    if root.code : Rectangle {
        border-radius: 8px;
        background: #F2F1ED;
        border-width: 0.67px;
        border-color: #E4E2DC;
        clip: true;
        vertical-stretch: 0;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 9px;
            Text {
                text: root.block.title;
                font-family: "MiSans VF";
                font-size: 12px;
                color: #37332F;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }

    if !root.rule && !root.code : HorizontalLayout {
        padding-left: root.indent;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: root.bullet ? 6px : (root.ordered ? ord.preferred-width : 0px);
            height: 21px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            Rectangle {
                visible: root.bullet;
                width: 5px;
                height: 5px;
                border-radius: 999px;
                background: #A8A29E;
                x: 0px;
                y: 9px;
            }
            ord := Text {
                visible: root.ordered;
                x: 0px;
                width: self.preferred-width;
                height: parent.height;
                text: root.block.ordinal;
                font-size: 12.5px;
                color: Palette.mid;
                vertical-alignment: center;
            }
        }
        // StyledText's intrinsic width is the unwrapped line width. As a
        // direct layout child that width becomes the row minimum and expands
        // the ScrollView horizontally. Isolate it behind a zero-min-width
        // wrapper, then measure height again using the assigned viewport width.
        rich-box := Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            vertical-stretch: 0;
            height: max(21px, rich-text.preferred-height);
            rich-text := StyledText {
                width: parent.width;
                height: self.preferred-height;
                text: root.block.rich;
                default-font-size: !root.heading ? 13.5px
                    : root.block.depth <= 1 ? 15px
                    : root.block.depth == 2 ? 14.5px
                    : root.block.depth == 3 ? 14px
                    : root.block.depth == 4 ? 13.5px
                    : root.block.depth == 5 ? 13px : 12.5px;
                default-color: Palette.body;
                default-font-family: "MiSans VF";
                vertical-alignment: top;
                link-color: Palette.accent-text;
            }
        }
    }
}

// Collapsible chain-of-thought card shown above an assistant reply. Expanded
// it presents the full reasoning text; collapsed it becomes a slim bar with a
// one-line preview, mirroring the UI prototype's ThoughtProcessCard.
export component ThoughtProcessCard inherits Rectangle {
    in property <string> content;
    in-out property <bool> expanded: true;
    border-radius: 12px;
    background: #F4F4F4;
    border-width: 0.67px;
    border-color: #E5E5E5;
    clip: true;
    vertical-stretch: 0;

    if !root.expanded : Rectangle {
        height: 27px;
        collapse-bar := HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 999px;
                background: #78716C;
                y: (parent.height - 6px) / 2;
            }
            Text {
                horizontal-stretch: 1;
                text: root.content == "" ? "思考过程" : root.content;
                font-size: 12px;
                color: #8E8E93;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
            Image {
                source: Icons.chev-down;
                width: 14px;
                height: 14px;
                y: (parent.height - 14px) / 2;
            }
        }
        TouchArea {
            clicked => { root.expanded = true; }
            mouse-cursor: pointer;
        }
    }
    if root.expanded : VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 15px;
        padding-bottom: 18px;
        spacing: 13px;
        // Clicking anywhere on the header strip collapses the card.
        Rectangle {
            height: 22px;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 999px;
                    background: #78716C;
                    y: (parent.height - 6px) / 2;
                }
                Text {
                    text: "思考过程";
                    font-size: 13.5px;
                    font-weight: 500;
                    color: #262626;
                    vertical-alignment: center;
                }
                Rectangle { min-width: 0px; horizontal-stretch: 1; }
                Image {
                    source: Icons.chev-down;
                    width: 15px;
                    height: 15px;
                    transform-rotation: 180deg;
                    y: (parent.height - 15px) / 2;
                }
            }
            TouchArea {
                clicked => { root.expanded = false; }
                mouse-cursor: pointer;
            }
        }
        Text {
            text: root.content;
            font-size: 13px;
            color: #4B5563;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

export component WorkflowStepRow inherits Rectangle {
    in property <TimelineItem> item;
    property <bool> running-progress: root.item.progress >= 0 && root.item.progress < 100;
    property <bool> completed-card: root.item.kind == "task.completed";
    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        VerticalLayout {
            width: 45px;
            horizontal-stretch: 0;
            Text {
                text: root.item.time;
                font-family: "MiSans VF";
                font-size: 11.5px;
                color: Palette.faint;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            width: 28px;
            horizontal-stretch: 0;
            padding-top: 3px;
            StepDot { tone: root.item.tone; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            padding-top: 1px;
            padding-bottom: 6px;
            if !root.completed-card : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Image {
                    source: root.item.kind == "fs.read" || root.item.kind == "fs.written" || root.item.kind == "fs.created" || root.item.kind == "fs.deleted" ? Icons.folder-dim
                        : root.item.kind == "process.started" || root.item.kind == "process.output" || root.item.kind == "process.exit" || root.item.kind == "tool.result" ? Icons.terminal
                        : root.item.kind == "model.tool-call" || root.item.kind == "model.reasoning-summary" ? Icons.bot
                        : Icons.doc;
                    width: 14px;
                    height: 14px;
                    y: 2px;
                }
                Text {
                    text: root.item.title;
                    font-size: 12.5px;
                    font-weight: 500;
                    color: root.item.tone == "success" && (root.item.kind == "assistant.message" || root.item.kind == "act.completed") ? Palette.green-ink : Palette.body;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.running-progress ? "" : root.item.detail;
                    font-family: "MiSans VF";
                    font-size: 11.5px;
                    color: Palette.dim;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.completed-card : Rectangle {
                background: #F0FDF4;
                border-radius: 8px;
                border-width: 0.67px;
                border-color: #BBF7D0;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            source: Icons.check-circle-green;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                        Text {
                            text: root.item.title;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #15803D;
                            vertical-alignment: center;
                        }
                    }
                    if root.item.detail != "" : HorizontalLayout {
                        padding-left: 22px;
                        Text {
                            text: root.item.detail;
                            font-size: 11.5px;
                            color: #166534;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if root.running-progress : Rectangle {
                background: #FAF8F5;
                border-radius: 8px;
                border-width: 0.67px;
                border-color: #E8E6DF;
                height: 78px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.item.detail;
                            font-size: 12px;
                            color: Palette.strong;
                            overflow: elide;
                        }
                        Text {
                            text: "进度 " + root.item.progress + " %";
                            font-family: "MiSans VF";
                            font-weight: 600;
                            font-size: 12px;
                            color: Palette.accent-text;
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 999px;
                        background: #E8E6DF;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: Math.max(2px, parent.width * clamp(root.item.progress, 0, 100) / 100);
                            height: 8px;
                            border-radius: 999px;
                            background: @linear-gradient(90deg, #E08A7E 0%, #C86A28 100%);
                        }
                    }
                    Text {
                        text: "实时进度由 worker.progress 光子驱动 · 详细日志见轨迹面板";
                        font-size: 11px;
                        color: Palette.dim;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component TraceEventRow inherits Rectangle {
    in property <TraceEvent> event;
    in property <int> selected-num;
    callback pick;
    property <bool> hi: root.event.num == root.selected-num;
    height: 34px;
    background: self.hi ? rgba(254, 243, 214, 0.6) : (ta.has-hover ? rgba(0, 0, 0, 0.02) : transparent);
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 0px;
        alignment: start;
        Text {
            width: 28px;
            horizontal-stretch: 0;
            text: root.event.num;
            font-family: "MiSans VF";
            font-weight: root.hi ? 500 : 400;
            font-size: 12px;
            color: Palette.faint;
            vertical-alignment: center;
        }
        Text {
            width: 118px;
            horizontal-stretch: 0;
            text: root.event.time;
            font-family: "MiSans VF";
            font-weight: root.hi ? 500 : 400;
            font-size: 11.5px;
            color: Palette.faint;
            vertical-alignment: center;
        }
        Rectangle {
            width: 140px;
            horizontal-stretch: 0;
            PillBadge {
                label: root.event.tone;
                tone: root.event.tone;
                y: (parent.height - 16px) / 2;
                x: 0px;
            }
        }
        Text {
            width: 96px;
            horizontal-stretch: 0;
            text: root.event.role;
            font-size: 12px;
            color: Palette.strong;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.event.detail;
            font-family: "MiSans VF";
            font-size: 11.5px;
            color: root.hi ? Palette.body : Palette.mid;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: 72px;
            horizontal-stretch: 0;
            text: root.event.dur;
            font-family: "MiSans VF";
            font-size: 12px;
            color: Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 64px;
            horizontal-stretch: 0;
            text: root.event.tokens;
            font-family: "MiSans VF";
            font-size: 12px;
            color: Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 0.67px;
        height: 0.67px;
        width: parent.width;
        background: Palette.sep;
    }
    ta := TouchArea {
        clicked => { parent.pick() }
        mouse-cursor: pointer;
    }
}

export component WorkspaceStatusBar inherits Rectangle {
    in property <string> group-name;
    in property <string> project-name;
    in property <string> short-path;
    in property <bool> has-git;
    in property <string> branch-name;
    in property <int> indexed-files;
    in property <bool> locked;
    callback change-workspace;

    height: 27px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.95);
    border-width: 0.67px;
    border-color: Palette.border;
    clip: true;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: start;
            Rectangle {
                width: 18px;
                height: 18px;
                horizontal-stretch: 0;
                border-radius: 5px;
                background: #FEF8F4;
                border-width: 0.67px;
                border-color: #F5D9C3;
                Image {
                    source: Icons.folder-open;
                    width: 11px;
                    height: 11px;
                    x: (parent.width - 11px) / 2;
                    y: (parent.height - 11px) / 2;
                }
            }
            Text {
                text: root.group-name;
                font-size: 10px;
                font-weight: 500;
                color: Palette.dim;
                vertical-alignment: center;
            }
            Text {
                text: "/";
                font-size: 9px;
                color: #D6D3D1;
                vertical-alignment: center;
            }
            Text {
                text: root.project-name;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: Palette.ink;
                vertical-alignment: center;
            }
            Rectangle {
                width: Math.min(210px, path-label.preferred-width + 12px);
                horizontal-stretch: 0;
                height: 17px;
                border-radius: 4px;
                background: Palette.sep;
                border-width: 0.67px;
                border-color: Palette.border;
                path-label := Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: root.short-path;
                    font-family: "MiSans VF";
                    font-size: 9.5px;
                    color: Palette.dim;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if root.has-git : Rectangle {
                width: branch-label.preferred-width + 23px;
                horizontal-stretch: 0;
                height: 17px;
                border-radius: 4px;
                background: #FEF8F4;
                border-width: 0.67px;
                border-color: #F5D9C3;
                Image {
                    source: Icons.git-branch;
                    x: 5px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                }
                branch-label := Text {
                    x: 17px;
                    width: parent.width - 21px;
                    height: parent.height;
                    text: root.branch-name;
                    font-family: "MiSans VF";
                    font-size: 9px;
                    color: Palette.accent;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: end;
            Rectangle {
                width: ready-label.preferred-width + 23px;
                horizontal-stretch: 0;
                height: 17px;
                border-radius: 4px;
                background: Palette.sep;
                border-width: 0.67px;
                border-color: Palette.border;
                Rectangle {
                    x: 6px;
                    y: (parent.height - 6px) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 999px;
                    background: #16A34A;
                }
                ready-label := Text {
                    x: 16px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.indexed-files + " 文件就绪";
                    font-size: 9.5px;
                    color: Palette.dim;
                    vertical-alignment: center;
                }
            }
            if !root.locked : Rectangle {
                width: 70px;
                height: 19px;
                horizontal-stretch: 0;
                border-radius: 5px;
                background: #FEF8F4;
                border-width: 0.67px;
                border-color: #F5D9C3;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Image { source: Icons.folder-open; width: 10px; height: 10px; y: (parent.height - 10px) / 2; }
                    Text { text: "更换目录"; font-size: 10px; font-weight: 500; color: Palette.accent; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.change-workspace() }
                    mouse-cursor: pointer;
                }
            }
            if root.locked : Rectangle {
                width: 72px;
                height: 19px;
                horizontal-stretch: 0;
                border-radius: 5px;
                background: Palette.sep;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Image { source: Icons.lock; width: 10px; height: 10px; y: (parent.height - 10px) / 2; }
                    Text { text: "目录已锁定"; font-size: 10px; color: Palette.faint; vertical-alignment: center; }
                }
            }
        }
    }
}
