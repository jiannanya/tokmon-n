import { LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct NavigationItem {
    id: string,
    ray: string,
    workspace: string,
    kind: string,
    title: string,
    icon: image,
    indent: int,
    selected: bool,
    expandable: bool,
    expanded: bool,
}

export struct ModelChoice {
    provider: string,
    model: string,
    label: string,
}

export struct TimelineItem {
    time: string,
    kind: string,
    title: string,
    detail: string,
    tone: string,
    progress: int,
}

export struct CodeLine {
    number: int,
    text: string,
    tone: string,
}

export struct SlashCommandItem {
    command: string,
    usage: string,
    summary: string,
    category: string,
}

component ToolIcon inherits Rectangle {
    in property <image> source;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.has-hover && root.enabled ? #f0eee8 : transparent;
    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component StatusDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: tone == "success" ? #22c55e :
                tone == "warning" ? #f59e0b :
                tone == "danger" ? #ef4444 : #a8a29e;
}

component MenuOption inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback chosen;
    height: 27px;
    border-radius: 9px;
    background: active ? #f7efe5 : option-touch.has-hover ? #f5f5f4 : transparent;
    Text {
        x: 9px; width: parent.width - 18px; height: parent.height;
        text: root.label; color: root.active ? #8b5229 : #44403c;
        font-size: 10px; vertical-alignment: center; overflow: elide;
    }
    option-touch := TouchArea { clicked => { root.chosen(); } }
}

component SettingsNavigationRow inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active: false;
    callback chosen;
    height: 41px;
    border-radius: 12px;
    background: active ? #f7efe5 : nav-touch.has-hover ? #f5f5f4 : transparent;
    Text {
        x: 12px; width: 22px; height: parent.height;
        text: root.glyph; color: root.active ? #8b5229 : #78716c;
        font-size: 14px; vertical-alignment: center; horizontal-alignment: center;
    }
    Text {
        x: 43px; width: parent.width - 55px; height: parent.height;
        text: root.label; color: root.active ? #8b5229 : #44403c;
        font-size: 12px; font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
    }
    nav-touch := TouchArea { clicked => { root.chosen(); } }
}

component SettingsSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    width: 40px; height: 22px; border-radius: 11px;
    background: checked ? #c86a28 : #d6d3d1;
    Rectangle {
        x: root.checked ? 20px : 2px; y: 2px;
        width: 18px; height: 18px; border-radius: 9px;
        background: white; drop-shadow-blur: 2px; drop-shadow-color: #00000020;
    }
    TouchArea {
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

component SettingsChoice inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback chosen;
    height: 32px;
    border-radius: 10px;
    border-width: 1px;
    border-color: active ? #f5c86b : #e7e5e4;
    background: active ? #fef3d6 : choice-touch.has-hover ? #fafaf9 : white;
    Text {
        width: parent.width; height: parent.height; text: root.label;
        color: root.active ? #855702 : #57534e; font-size: 10.5px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    choice-touch := TouchArea { clicked => { root.chosen(); } }
}

component SettingsValueRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> value;
    callback chosen;
    height: 64px;
    background: row-touch.has-hover ? #fafaf9 : transparent;
    border-width: 1px; border-color: #f0eee8;
    Text {
        x: 14px; y: 10px; width: parent.width - 180px; height: 18px;
        text: root.title; color: #292524; font-size: 11px; font-weight: 600;
    }
    Text {
        x: 14px; y: 31px; width: parent.width - 180px; height: 17px;
        text: root.detail; color: #a8a29e; font-size: 9.5px; overflow: elide;
    }
    Text {
        x: parent.width - 160px; y: 0px; width: 138px; height: parent.height;
        text: root.value + "  ›"; color: #57534e; font-size: 10.5px;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
    }
    row-touch := TouchArea { clicked => { root.chosen(); } }
}

component SidebarRow inherits Rectangle {
    in property <NavigationItem> item;
    callback selected;
    height: 29px;
    border-radius: 8px;
    background: item.selected ? #f7efe5 : touch.has-hover ? #f0eee8 : transparent;
    HorizontalLayout {
        padding-left: 7px + item.indent * 14px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        Image {
            width: item.expandable ? 11px : 0px;
            height: 11px;
            source: item.expandable ? @image-url("../assets/figma/icon-05.svg") : @image-url("../assets/figma/icon-07.svg");
        }
        Image { width: 15px; height: 15px; source: item.icon; }
        Text {
            text: item.title;
            color: item.selected ? #8b5229 : #44403c;
            font-family: "MiSans VF";
            font-size: 12px;
            font-weight: item.selected ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.selected(); } }
}

component TimelineRow inherits Rectangle {
    in property <TimelineItem> item;
    height: item.kind == "complete" ? 66px : item.progress >= 0 ? 82px : item.detail == "" ? 30px : 46px;
    background: transparent;
    if item.kind == "complete": Rectangle {
        x: 24px;
        y: 3px;
        width: parent.width - 32px;
        height: 59px;
        border-radius: 7px;
        background: #f0fdf4;
        border-width: 1px;
        border-color: #bbf7d0;
        Image { x: 10px; y: 10px; width: 14px; height: 14px; source: @image-url("../assets/figma/icon-20.svg"); }
        Text {
            x: 31px; y: 8px; width: parent.width - 42px; height: 17px;
            text: item.title; color: #15803d; font-size: 10.5px; font-weight: 700;
        }
        Text {
            x: 31px; y: 25px; width: parent.width - 42px; height: 28px;
            text: item.detail; color: #16a34a; font-size: 9.5px; wrap: word-wrap;
        }
    }
    if item.kind != "complete": Rectangle {
        x: 14px; y: 0px; width: 1px; height: parent.height;
        background: #e7e5e4;
    }
    if item.kind != "complete": Rectangle {
        x: 8px; y: 8px; width: 13px; height: 13px; border-radius: 7px;
        background: item.tone == "success" ? #dcfce7 : #fffbeb;
        border-width: 1px;
        border-color: item.tone == "success" ? #86efac : #f59e0b;
        Image {
            x: 2px; y: 2px; width: 8px; height: 8px;
            source: item.kind == "folder" ? @image-url("../assets/figma/icon-22.svg") :
                    item.kind == "file" ? @image-url("../assets/figma/icon-23.svg") :
                    item.tone == "success" ? @image-url("../assets/figma/icon-24.svg") :
                    @image-url("../assets/figma/icon-26.svg");
        }
    }
    if item.kind != "complete": Text {
        x: 28px; y: 6px; width: 35px; height: 18px;
        text: item.time; color: #a8a29e; font-size: 9.5px;
        vertical-alignment: center;
    }
    if item.kind != "complete": Text {
        x: 67px; y: 6px; width: parent.width - 78px; height: 18px;
        text: item.title; color: #292524; font-size: 10.5px;
        font-weight: item.kind == "task" ? 700 : 500;
        vertical-alignment: center; overflow: elide;
    }
    if item.kind != "complete" && item.detail != "" && item.progress < 0: Rectangle {
        x: 67px; y: 25px; width: min(parent.width - 82px, 210px); height: 18px;
        border-radius: 4px; background: #f5f5f4;
        Text {
            x: 7px; width: parent.width - 14px; height: parent.height;
            text: item.detail; color: #78716c; font-size: 9px;
            vertical-alignment: center; overflow: elide;
        }
    }
    if item.kind != "complete" && item.progress >= 0: Rectangle {
        x: 67px; y: 25px; width: parent.width - 80px; height: 52px;
        border-radius: 6px; background: #fafaf9;
        border-width: 1px; border-color: #e7e5e4;
        Text {
            x: 9px; y: 4px; width: parent.width - 75px; height: 15px;
            text: item.detail; color: #57534e; font-size: 9px; overflow: elide;
        }
        Text {
            x: parent.width - 58px; y: 4px; width: 48px; height: 15px;
            text: "进度  " + item.progress + " %"; color: #8b5229; font-size: 9px;
            font-weight: 600; horizontal-alignment: right;
        }
        Rectangle {
            x: 9px; y: 23px; width: parent.width - 18px; height: 4px;
            border-radius: 2px; background: #e7e5e4;
            Rectangle {
                width: parent.width * min(100, max(0, item.progress)) / 100;
                height: parent.height; border-radius: 2px; background: #c86a28;
            }
        }
        Text {
            x: 9px; y: 31px; width: parent.width - 18px; height: 14px;
            text: "预计剩余: 00:01:32"; color: #a8a29e; font-size: 8.5px;
        }
    }

}

component ConversationWorkflowRow inherits Rectangle {
    in property <TimelineItem> item;
    height: item.detail == "" ? 38px : 52px;
    background: row-touch.has-hover ? #fafaf9 : transparent;
    border-radius: 7px;

    Rectangle {
        x: 10px; y: 13px; width: 10px; height: 10px; border-radius: 5px;
        background: item.tone == "success" ? #22c55e :
                    item.tone == "danger" ? #ef4444 :
                    item.tone == "warning" ? #f59e0b : #a8a29e;
    }
    Text {
        x: 30px; y: 5px; width: parent.width - 94px; height: 20px;
        text: item.title; color: #292524; font-size: 10.5px; font-weight: 600;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: parent.width - 58px; y: 5px; width: 48px; height: 20px;
        text: item.time; color: #a8a29e; font-size: 9px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if item.detail != "": Text {
        x: 30px; y: 25px; width: parent.width - 40px; height: 20px;
        text: item.detail; color: #78716c; font-size: 9.5px;
        vertical-alignment: center; overflow: elide;
    }
    row-touch := TouchArea { }
}

component TraceEventRow inherits Rectangle {
    in property <TimelineItem> item;
    in property <int> row-index;
    height: 31px;
    background: row-index == 0 ? #fdfbf7 : row-touch.has-hover ? #fafaf9 : transparent;
    border-width: 1px;
    border-color: #f5f5f4;
    Text {
        x: 7px; width: 25px; height: parent.height;
        text: row-index + 1; color: #a8a29e; font-size: 8.5px;
        vertical-alignment: center; horizontal-alignment: center;
    }
    Text {
        x: 35px; width: 48px; height: parent.height;
        text: item.time; color: #78716c; font-size: 8.5px; vertical-alignment: center;
    }
    Rectangle {
        x: 88px; y: 8px; width: 62px; height: 16px; border-radius: 4px;
        background: item.kind == "user.input" || item.kind == "user.message" ? #e0f2fe :
                    item.kind == "tool.result" ? #ffedd5 :
                    item.kind == "model.tool-call" ? #f3e8ff :
                    item.kind == "assistant.message" ? #fce7f3 :
                    item.kind == "act.failed" || item.kind == "model.failed" ? #fee2e2 : #ecfdf5;
        Text {
            width: parent.width; height: parent.height;
            text: item.kind == "user.input" || item.kind == "user.message" ? "USER" :
                  item.kind == "tool.result" ? "RESULT" :
                  item.kind == "model.tool-call" ? "TOOL CALL" :
                  item.kind == "assistant.message" ? "ASSISTANT" :
                  item.kind == "act.failed" || item.kind == "model.failed" ? "ERROR" : "PHOTON";
            color: #57534e; font-size: 7.5px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
    }
    Text {
        x: 158px; width: 65px; height: parent.height;
        text: item.kind == "user.input" || item.kind == "user.message" ? "User" :
              item.kind == "assistant.message" || item.kind == "model.tool-call" ? "Assistant" :
              item.kind == "tool.result" ? "Lens" : "System";
        color: #57534e; font-size: 8.5px; vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 228px; width: parent.width - 235px; height: parent.height;
        text: item.detail == "" ? item.title : item.detail;
        color: #44403c; font-size: 8.5px; vertical-alignment: center; overflow: elide;
    }
    row-touch := TouchArea { }
}

export component MainWindow inherits Window {
    title: "Tokmon — A Lens to Them All";
    no-frame: true;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1040px;
    min-height: 680px;
    background: #f5f5f4;
    default-font-family: "MiSans VF";

    in property <[NavigationItem]> navigation;
    in property <[TimelineItem]> timeline;
    in property <[TimelineItem]> conversation-workflow;
    in property <[CodeLine]> code-lines;
    in property <[SlashCommandItem]> slash-commands;
    in property <[ModelChoice]> model-choices;
    in-out property <string> session-title: "新会话";
    in-out property <string> status-text: "等待输入";
    in-out property <string> model-name: "local-deterministic";
    in-out property <string> access-mode: "完全访问";
    in-out property <string> effort: "最高";
    in-out property <string> composer-text;
    in-out property <string> last-message;
    in-out property <string> assistant-text;
    in-out property <string> daemon-state: "后台服务已连接";
    in-out property <bool> sidebar-visible: true;
    in-out property <bool> code-visible: true;
    in-out property <bool> trajectory-selected: true;
    in-out property <bool> file-preview-selected: false;
    in-out property <string> search-text;
    in-out property <bool> task-expanded: true;
    in-out property <bool> conversation-workflow-expanded: true;
    in-out property <string> trace-duration: "0ms";
    in-out property <int> trace-turns: 0;
    in-out property <int> trace-calls: 0;
    in-out property <int> trace-input-tokens: 0;
    in-out property <int> trace-output-tokens: 0;
    in-out property <string> trace-provider: "-";
    in-out property <string> trace-model: "-";
    in-out property <string> trace-result: "等待输入";
    in-out property <bool> title-editing: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> access-menu-open: false;
    in-out property <bool> model-menu-open: false;
    in-out property <bool> effort-menu-open: false;
    in-out property <bool> file-menu-open: false;
    in-out property <bool> code-menu-open: false;
    in-out property <bool> issues-open: false;
    in-out property <bool> attachment-menu-open: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> slash-menu-visible: false;
    in-out property <bool> create-navigation-open: false;
    in-out property <string> create-navigation-kind: "project";
    in-out property <string> create-navigation-name: "";
    in-out property <string> create-navigation-workspace: "";
    in-out property <string> create-navigation-error: "";
    in-out property <string> selected-attachment: "";
    in-out property <length> sidebar-width: 240px;
    in-out property <length> code-panel-width: 440px;
    in-out property <int> settings-page: 0;
    in-out property <string> settings-search;
    in-out property <string> setting-language: "简体中文";
    in-out property <string> setting-startup: "上次打开的会话";
    in-out property <bool> setting-autosave: true;
    in-out property <string> setting-provider: "local";
    in-out property <string> setting-provider-protocol: "openai-compatible";
    in-out property <string> setting-provider-endpoint: "";
    in-out property <string> setting-provider-auth: "protocol-default";
    in-out property <string> setting-provider-secret: "";
    in-out property <string> setting-provider-credential: "本地模型无需密钥";
    in-out property <bool> setting-provider-thinking: false;
    in-out property <string> setting-main-model: "local-deterministic";
    in-out property <string> setting-reasoning: "标准";
    in-out property <string> setting-command-approval: "按需确认";
    in-out property <bool> setting-network: true;
    in-out property <bool> setting-high-risk: true;
    in-out property <string> setting-workspace: ".";
    in-out property <string> setting-index-mode: "标准";
    in-out property <bool> setting-workspace-sync: true;
    in-out property <bool> setting-git: true;
    in-out property <bool> setting-notifications: true;
    in-out property <bool> setting-desktop-notifications: true;
    in-out property <bool> setting-message-alerts: true;
    in-out property <bool> setting-quiet-hours: false;
    in-out property <bool> setting-dark-theme: false;
    in-out property <int> setting-accent: 0;
    in-out property <string> setting-density: "舒适";
    in-out property <int> setting-font-scale: 100;
    in-out property <int> shortcut-editing: -1;
    in-out property <string> setting-nickname: "Jiandong Chen";
    in-out property <string> setting-email: "jiandong.chen@tokmon.ai";
    in-out property <bool> setting-cloud-sync: true;
    in-out property <string> settings-status: "项目级 · .tokmon/config.yaml";
    callback send-message(string);
    callback new-session;
    callback select-navigation(int);
    callback search-changed(string);
    callback add-navigation;
    callback reconcile;
    callback save-settings;
    callback reset-settings;
    callback configure-provider(string, string, string, string, string, bool, string);
    callback store-provider-secret(string, string);
    callback test-provider(string);
    callback drag-window;
    callback minimize-window;
    callback toggle-maximize-window;
    callback close-window;
    callback slash-query-changed(string);
    callback rename-session(string);
    callback create-navigation(string, string, string) -> bool;
    callback choose-attachment(bool) -> string;
    callback cancel-settings;

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle {
            height: 30px;
            background: #fbfbfa;
            border-width: 1px;
            border-color: #f0eee8;
            drag-touch := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.drag-window();
                    }
                }
            }
            HorizontalLayout {
                width: parent.width; height: parent.height;
                padding-left: 10px;
                spacing: 7px;
                Image { width: 14px; height: 14px; source: @image-url("../assets/figma/icon-00.svg"); }
                Text {
                    text: "Tokmon — A Lens to Them All";
                    color: #57534e; font-size: 10.5px; vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 34px;
                    background: minimize-touch.has-hover ? #f0eee8 : transparent;
                    Text { text: "—"; color: #57534e; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    minimize-touch := TouchArea { clicked => { root.minimize-window(); } }
                }
                Rectangle {
                    width: 34px;
                    background: maximize-touch.has-hover ? #f0eee8 : transparent;
                    if !root.window-maximized: Rectangle {
                        x: 12px; y: 9px; width: 10px; height: 9px;
                        border-width: 1px; border-color: #78716c; background: transparent;
                    }
                    if root.window-maximized: Rectangle {
                        x: 10px; y: 11px; width: 9px; height: 8px;
                        border-width: 1px; border-color: #78716c; background: #fbfbfa;
                        Rectangle {
                            x: 3px; y: -4px; width: 9px; height: 8px;
                            border-width: 1px; border-color: #78716c; background: transparent;
                        }
                    }
                    maximize-touch := TouchArea { clicked => { root.toggle-maximize-window(); } }
                }
                Rectangle {
                    width: 38px;
                    background: close-touch.has-hover ? #ef4444 : transparent;
                    Text { text: "×"; color: close-touch.has-hover ? white : #57534e; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                    close-touch := TouchArea { clicked => { root.close-window(); } }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            sidebar := Rectangle {
            visible: root.sidebar-visible;
            width: root.sidebar-visible ? root.sidebar-width : 0px;
            background: #f9f9f8;
            border-width: 1px;
            border-color: #e7e5e4;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    Image { width: 24px; height: 24px; source: @image-url("../assets/figma/icon-00.svg"); }
                    Text {
                        text: "Tokmon";
                        color: #1c1917;
                        font-family: "MiSans VF";
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ToolIcon {
                        source: @image-url("../assets/figma/icon-01.svg");
                        clicked => { root.sidebar-visible = false; }
                    }
                }
                Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: #f7efe5;
                    border-color: #ebdcd0;
                    border-width: 1px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Image { width: 16px; height: 16px; source: @image-url("../assets/figma/icon-02.svg"); }
                        Text { text: "新建会话"; color: #8b5229; font-size: 13px; font-weight: 600; }
                    }
                    TouchArea {
                        clicked => {
                            root.new-session();
                            root.trajectory-selected = false;
                            root.composer-text = "";
                            root.last-message = "";
                        }
                    }
                }
                Rectangle {
                    height: 34px;
                    border-radius: 11px;
                    background: #f0eee8;
                    Image { x: 12px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/figma/icon-03.svg"); }
                    search := LineEdit {
                        x: 35px; y: 1px; width: parent.width - 40px; height: 32px;
                        placeholder-text: "搜索项目或会话...";
                        font-size: 12px;
                        text <=> root.search-text;
                        edited => { root.search-changed(self.text); }
                    }
                }
                HorizontalLayout {
                    height: 25px;
                    padding-left: 8px;
                    Text {
                        text: "分组 / 项目 / 会话";
                        color: #78716c;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.5px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ToolIcon {
                        icon-size: 14px;
                        source: @image-url("../assets/figma/icon-04.svg");
                        clicked => {
                            root.create-navigation-kind = "project";
                            root.create-navigation-name = "";
                            root.create-navigation-workspace = root.setting-workspace;
                            root.create-navigation-error = "";
                            root.create-navigation-open = true;
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for item[index] in root.navigation: SidebarRow {
                        item: item;
                        selected => { root.select-navigation(index); }
                    }
                }
                Rectangle {
                    height: 27px;
                    border-radius: 7px;
                    background: settings-touch.has-hover ? #f0eee8 : transparent;
                    HorizontalLayout {
                        width: parent.width; height: parent.height;
                        spacing: 7px;
                        Image { width: 14px; height: 14px; source: @image-url("../assets/figma/icon-13.svg"); }
                        Text { text: "设置"; color: #57534e; font-size: 11.5px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        StatusDot { tone: "success"; }
                    }
                    settings-touch := TouchArea { clicked => { root.settings-open = true; } }
                }
            }
        }

            Rectangle {
                visible: root.sidebar-visible;
                width: root.sidebar-visible ? 6px : 0px;
                background: left-resize.has-hover || left-resize.pressed ? #fdfbf7 : #ffffff;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: left-resize.has-hover || left-resize.pressed ? 2px : 1px;
                    height: parent.height;
                    background: left-resize.has-hover || left-resize.pressed ? #c86a28 : #e7e5e4;
                }
                left-resize := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.sidebar-width = max(180px, min(
                                min(380px, root.width - (root.code-visible ? root.code-panel-width + 6px : 0px) - 366px),
                                root.sidebar-width + self.mouse-x - self.width / 2
                            ));
                        }
                    }
                }
            }

            main := Rectangle {
            horizontal-stretch: 1;
            min-width: 360px;
            max-width: 100000px;
            background: #ffffff;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 44px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #f0eee8;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 7px;
                        ToolIcon {
                            visible: !root.sidebar-visible;
                            source: @image-url("../assets/figma/icon-01.svg");
                            clicked => { root.sidebar-visible = true; }
                        }
                        Rectangle {
                            width: root.title-editing ? 190px : 170px;
                            if !root.title-editing: Text {
                                text: root.session-title;
                                color: #292524;
                                font-family: "MiSans VF";
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.title-editing: LineEdit {
                                width: parent.width; height: 30px;
                                text <=> root.session-title;
                                accepted => {
                                    if (self.text != "") { root.rename-session(self.text); }
                                    root.title-editing = false;
                                }
                            }
                        }
                        ToolIcon {
                            icon-size: 13px;
                            source: @image-url("../assets/figma/icon-14.svg");
                            clicked => { root.title-editing = !root.title-editing; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolIcon {
                            source: @image-url("../assets/figma/icon-15.svg");
                            clicked => { root.code-visible = !root.code-visible; }
                        }
                    }
                }
                Rectangle {
                    height: 34px;
                    border-width: 1px;
                    border-color: #f0eee8;
                    HorizontalLayout {
                        padding-left: 18px;
                        spacing: 18px;
                        Rectangle {
                            width: 35px;
                            Text { text: "对话"; color: !root.trajectory-selected ? #8b5229 : #78716c; font-size: 11.5px; horizontal-alignment: center; }
                            Rectangle { visible: !root.trajectory-selected; y: parent.height - 2px; height: 2px; width: parent.width; background: #d97706; }
                            TouchArea { clicked => { root.trajectory-selected = false; } }
                        }
                        Rectangle {
                            width: 35px;
                            Text { text: "轨迹"; color: root.trajectory-selected ? #8b5229 : #78716c; font-size: 11.5px; horizontal-alignment: center; }
                            Rectangle { visible: root.trajectory-selected; y: parent.height - 2px; height: 2px; width: parent.width; background: #d97706; }
                            TouchArea { clicked => { root.trajectory-selected = true; } }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                    preferred-height: 0px;
                    background: #ffffff;
                    if root.trajectory-selected: Rectangle {
                        background: #fafaf9;
                        metrics := Rectangle {
                            x: 18px; y: 14px; width: parent.width - 36px; height: 74px;
                            border-radius: 16px; background: #ffffff;
                            border-width: 1px; border-color: #e7e5e4;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 46px; spacing: 9px;
                                alignment: stretch;
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Duration"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-duration; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Turns"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-turns; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Calls"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-calls; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Total Tokens"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-input-tokens + root.trace-output-tokens; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Prompt"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-input-tokens; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: "Completion"; color: #78716c; font-size: 9px; horizontal-alignment: center; }
                                    Text { text: root.trace-output-tokens; color: #292524; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                }
                            }
                            Rectangle {
                                x: parent.width - 40px; y: 20px; width: 28px; height: 32px;
                                border-radius: 8px; background: #fafaf9;
                                Text { width: parent.width; height: parent.height; text: "⌕"; color: #78716c; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        chart := Rectangle {
                            x: 18px; y: 100px; width: parent.width - 36px; height: 188px;
                            border-radius: 16px; background: #ffffff;
                            border-width: 1px; border-color: #e7e5e4; clip: true;
                            for tick[index] in ["0%", "20%", "40%", "60%", "80%", "100%"]: Text {
                                x: 82px + index * (parent.width - 112px) / 5;
                                y: 13px; width: 34px; height: 14px;
                                text: tick; color: #a8a29e; font-size: 7.5px; horizontal-alignment: center;
                            }
                            Text { x: 18px; y: 39px; width: 55px; height: 18px; text: "Input"; color: #78716c; font-size: 9px; vertical-alignment: center; }
                            Text { x: 18px; y: 67px; width: 55px; height: 18px; text: "Model"; color: #78716c; font-size: 9px; vertical-alignment: center; }
                            Text { x: 18px; y: 95px; width: 55px; height: 18px; text: "Tools"; color: #78716c; font-size: 9px; vertical-alignment: center; }
                            for item[index] in root.timeline: Rectangle {
                                visible: item.kind == "user.input" || item.kind == "user.message" ||
                                         item.kind == "model.reasoning-chunk" || item.kind == "model.content-chunk" ||
                                         item.kind == "model.dispatched" || item.kind == "model.tool-call" ||
                                         item.kind == "tool.result" || item.kind == "act.started";
                                x: 82px + index * max(7px, (parent.width - 112px) / max(1, root.timeline.length));
                                y: item.kind == "user.input" || item.kind == "user.message" ? 44px :
                                   item.kind == "tool.result" || item.kind == "act.started" ? 100px : 72px;
                                width: max(12px, min(70px, (parent.width - 112px) / max(1, root.timeline.length) - 3px));
                                height: 8px; border-radius: 4px;
                                background: item.kind == "user.input" || item.kind == "user.message" ? #64748b :
                                            item.kind == "model.reasoning-chunk" ? #3b82f6 :
                                            item.kind == "model.content-chunk" ? #22c55e :
                                            item.kind == "model.tool-call" ? #a855f7 :
                                            item.kind == "tool.result" ? #f97316 : #f59e0b;
                            }
                            Rectangle { x: 16px; y: 127px; width: parent.width - 32px; height: 1px; background: #f0eee8; }
                            for legend[index] in ["Input", "Model (Thinking)", "Model (Generating)", "Tool Call", "Tool Result"]: Rectangle {
                                x: 18px + index * (parent.width - 36px) / 5; y: 139px;
                                width: (parent.width - 46px) / 5; height: 36px;
                                Rectangle {
                                    x: 0px; y: 5px; width: 8px; height: 8px; border-radius: 4px;
                                    background: index == 0 ? #64748b : index == 1 ? #3b82f6 :
                                                index == 2 ? #22c55e : index == 3 ? #a855f7 : #f97316;
                                }
                                Text { x: 13px; width: parent.width - 13px; height: 30px; text: legend; color: #78716c; font-size: 7.5px; wrap: word-wrap; }
                            }
                        }
                        events := Rectangle {
                            x: 18px; y: 300px;
                            width: parent.width < 610px ? parent.width - 36px : (parent.width - 48px) * 0.66;
                            height: parent.height - 314px;
                            border-radius: 16px; background: #ffffff;
                            border-width: 1px; border-color: #e7e5e4; clip: true;
                            Text { x: 14px; y: 8px; width: 150px; height: 22px; text: "事件列表 (" + root.timeline.length + ")"; color: #292524; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Rectangle {
                                x: parent.width - 96px; y: 8px; width: 38px; height: 22px; border-radius: 6px; background: #fafaf9; border-width: 1px; border-color: #e7e5e4;
                                Text { width: parent.width; height: parent.height; text: "筛选"; color: #78716c; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                x: parent.width - 52px; y: 8px; width: 38px; height: 22px; border-radius: 6px; background: #fafaf9; border-width: 1px; border-color: #e7e5e4;
                                Text { width: parent.width; height: parent.height; text: "导出"; color: #78716c; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                x: 0px; y: 37px; width: parent.width; height: 25px; background: #fafaf9;
                                Text { x: 8px; width: 25px; height: parent.height; text: "#"; color: #a8a29e; font-size: 8px; vertical-alignment: center; horizontal-alignment: center; }
                                Text { x: 35px; width: 48px; height: parent.height; text: "时间"; color: #a8a29e; font-size: 8px; vertical-alignment: center; }
                                Text { x: 88px; width: 62px; height: parent.height; text: "类型"; color: #a8a29e; font-size: 8px; vertical-alignment: center; }
                                Text { x: 158px; width: 65px; height: parent.height; text: "角色"; color: #a8a29e; font-size: 8px; vertical-alignment: center; }
                                Text { x: 228px; width: parent.width - 235px; height: parent.height; text: "内容 / 名称"; color: #a8a29e; font-size: 8px; vertical-alignment: center; }
                            }
                            ListView {
                                x: 0px; y: 62px; width: parent.width; height: parent.height - 82px;
                                for item[index] in root.timeline: TraceEventRow { item: item; row-index: index; }
                            }
                            Text { x: 12px; y: parent.height - 19px; width: parent.width - 24px; height: 15px; text: "显示 1-" + min(20, root.timeline.length) + " 条，共 " + root.timeline.length + " 条"; color: #a8a29e; font-size: 7.5px; }
                        }
                        request := Rectangle {
                            visible: parent.width >= 610px;
                            x: events.x + events.width + 12px; y: 300px;
                            width: max(0px, parent.width - self.x - 18px); height: parent.height - 314px;
                            border-radius: 16px; background: #ffffff;
                            border-width: 1px; border-color: #e7e5e4;
                            Text { x: 14px; y: 10px; width: parent.width - 28px; height: 20px; text: "●  Request #" + max(1, root.trace-calls); color: #292524; font-size: 10px; font-weight: 700; }
                            Text { x: 14px; y: 38px; width: parent.width - 28px; height: 20px; text: "Summary    Options    Usage    Timing"; color: #8b5229; font-size: 8px; overflow: elide; }
                            Rectangle { x: 14px; y: 60px; width: parent.width - 28px; height: 1px; background: #f0eee8; }
                            Text { x: 14px; y: 72px; width: 60px; height: 18px; text: "Status"; color: #a8a29e; font-size: 8px; }
                            Text { x: 78px; y: 72px; width: parent.width - 92px; height: 18px; text: root.trace-result; color: root.trace-result == "执行失败" ? #dc2626 : #15803d; font-size: 8px; horizontal-alignment: right; overflow: elide; }
                            Text { x: 14px; y: 96px; width: 60px; height: 18px; text: "Provider"; color: #a8a29e; font-size: 8px; }
                            Text { x: 78px; y: 96px; width: parent.width - 92px; height: 18px; text: root.trace-provider; color: #57534e; font-size: 8px; horizontal-alignment: right; overflow: elide; }
                            Text { x: 14px; y: 120px; width: 60px; height: 18px; text: "Model"; color: #a8a29e; font-size: 8px; }
                            Text { x: 78px; y: 120px; width: parent.width - 92px; height: 18px; text: root.trace-model; color: #57534e; font-size: 8px; horizontal-alignment: right; overflow: elide; }
                            Text { x: 14px; y: 144px; width: 60px; height: 18px; text: "Tool calls"; color: #a8a29e; font-size: 8px; }
                            Text { x: 78px; y: 144px; width: parent.width - 92px; height: 18px; text: root.trace-calls; color: #57534e; font-size: 8px; horizontal-alignment: right; }
                            Text { x: 14px; y: 168px; width: 60px; height: 18px; text: "Result"; color: #a8a29e; font-size: 8px; }
                            Text { x: 78px; y: 168px; width: parent.width - 92px; height: 18px; text: root.assistant-text == "" ? "-" : "Assistant Message"; color: #8b5229; font-size: 8px; horizontal-alignment: right; overflow: elide; }
                        }
                    }
                    if !root.trajectory-selected: ScrollView {
                        x: 28px; y: 22px; width: parent.width - 56px; height: parent.height - 44px;
                        VerticalLayout {
                            spacing: 18px;
                            Text { text: "10:20"; color: #a8a29e; font-size: 10px; horizontal-alignment: center; }
                            Rectangle {
                                height: 108px;
                                border-radius: 16px;
                                background: #fdfbf7;
                                border-color: #ebdcd0;
                                border-width: 1px;
                                Text {
                                    x: 13px; y: 12px; width: parent.width - 26px; height: parent.height - 24px;
                                    text: root.last-message == "" ? "开始一个新的任务" : root.last-message;
                                    color: #44403c; font-size: 11.5px; wrap: word-wrap;
                                }
                            }
                             Text {
                                 text: root.assistant-text;
                                 color: #44403c; font-size: 12px; wrap: word-wrap;
                             }
                             if root.conversation-workflow.length > 0: Rectangle {
                                 height: root.conversation-workflow-expanded
                                     ? 48px + min(10, root.conversation-workflow.length) * 52px
                                     : 44px;
                                 border-radius: 16px;
                                 background: #ffffff;
                                 border-width: 1px;
                                 border-color: #e7e5e4;
                                 drop-shadow-blur: 4px;
                                 drop-shadow-color: #0000000c;
                                 Rectangle {
                                     x: 0px; y: 0px; width: parent.width; height: 44px;
                                     border-radius: 16px;
                                     background: header-touch.has-hover ? #fafaf9 : #ffffff;
                                     HorizontalLayout {
                                         width: parent.width; height: parent.height;
                                         padding-left: 14px; padding-right: 13px; spacing: 10px;
                                         Rectangle {
                                             width: 22px; height: 22px; border-radius: 11px;
                                             background: root.status-text == "执行失败" ? #fef2f2 : #f7efe5;
                                             Text {
                                                 width: parent.width; height: parent.height;
                                                 text: root.status-text == "执行失败" ? "!" : "✦";
                                                 color: root.status-text == "执行失败" ? #dc2626 : #8b5229;
                                                 font-size: 11px; font-weight: 700;
                                                 horizontal-alignment: center; vertical-alignment: center;
                                             }
                                         }
                                         Text {
                                             text: "执行工作流  ·  " + root.conversation-workflow.length + " 步";
                                             color: #44403c; font-size: 10.5px; font-weight: 700;
                                             vertical-alignment: center;
                                         }
                                         Text {
                                             text: root.status-text;
                                             color: root.status-text == "执行失败" ? #dc2626 :
                                                    root.status-text == "审阅完成" ? #15803d : #8b5229;
                                             font-size: 9.5px; font-weight: 600;
                                             vertical-alignment: center;
                                         }
                                         Rectangle { horizontal-stretch: 1; }
                                         Text {
                                             text: root.conversation-workflow-expanded ? "收起  ^" : "展开  v";
                                             color: #78716c; font-size: 9px; vertical-alignment: center;
                                         }
                                     }
                                     header-touch := TouchArea {
                                         clicked => {
                                             root.conversation-workflow-expanded = !root.conversation-workflow-expanded;
                                         }
                                     }
                                 }
                                 if root.conversation-workflow-expanded: ListView {
                                     x: 8px; y: 45px; width: parent.width - 16px;
                                     height: parent.height - 49px;
                                     for item in root.conversation-workflow: ConversationWorkflowRow { item: item; }
                                 }
                             }
                         }
                     }
                }
                Rectangle {
                    height: 88px;
                    background: #ffffff;
                    composer-shell := Rectangle {
                        x: max(18px, (parent.width - self.width) / 2);
                        y: 8px;
                        width: min(parent.width - 36px, 720px);
                        height: 70px;
                        border-radius: 12px;
                        background: #ffffff;
                        border-color: #e7e5e4;
                        border-width: 1px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000018;
                        composer := LineEdit {
                            x: 12px; y: 7px; width: parent.width - 24px; height: 29px;
                            placeholder-text: "提出后续修改要求";
                            text <=> root.composer-text;
                            edited(text) => {
                                root.slash-query-changed(text);
                            }
                            accepted => {
                                if (self.text != "") {
                                    root.last-message = self.text;
                                    root.trajectory-selected = false;
                                    root.send-message(self.text);
                                    self.text = "";
                                }
                            }
                        }
                        if root.slash-menu-visible && root.slash-commands.length > 0: Rectangle {
                            x: 0px;
                            y: -min(350px, root.slash-commands.length * 43px + 12px);
                            width: parent.width;
                            height: min(342px, root.slash-commands.length * 43px + 8px);
                            border-radius: 11px;
                            background: #ffffff;
                            border-color: #e7e5e4;
                            border-width: 1px;
                            drop-shadow-blur: 14px;
                            drop-shadow-color: #00000022;
                            clip: true;
                            for item[index] in root.slash-commands: Rectangle {
                                x: 4px;
                                y: 4px + index * 43px;
                                width: parent.width - 8px;
                                height: 41px;
                                border-radius: 7px;
                                background: command-touch.has-hover ? #fef3d6 : transparent;
                                Text {
                                    x: 9px; y: 5px; width: 185px; height: 16px;
                                    text: item.usage; color: #292524; font-size: 11px;
                                    font-weight: 700; overflow: elide;
                                }
                                Text {
                                    x: 202px; y: 5px; width: parent.width - 280px; height: 16px;
                                    text: item.summary; color: #78716c; font-size: 10px;
                                    overflow: elide;
                                }
                                Text {
                                    x: 9px; y: 22px; width: parent.width - 18px; height: 13px;
                                    text: item.category; color: #8b5229; font-size: 8.5px;
                                }
                                command-touch := TouchArea {
                                    clicked => {
                                        root.composer-text = item.command + " ";
                                        root.slash-menu-visible = false;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            x: 10px; y: 39px; width: parent.width - 20px; height: 25px;
                            spacing: 8px;
                            ToolIcon {
                                source: @image-url("../assets/figma/icon-02.svg"); icon-size: 14px;
                                clicked => {
                                    root.attachment-menu-open = !root.attachment-menu-open;
                                    root.access-menu-open = false; root.model-menu-open = false; root.effort-menu-open = false;
                                }
                            }
                            Rectangle {
                                width: 78px;
                                Text { text: root.access-mode + "  v"; color: #8b5229; font-size: 10px; vertical-alignment: center; }
                                TouchArea {
                                    clicked => {
                                        root.access-menu-open = !root.access-menu-open;
                                        root.attachment-menu-open = false; root.model-menu-open = false; root.effort-menu-open = false;
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: min(210px, parent.width - 230px);
                                Text { text: root.model-name + "  v"; color: #57534e; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                TouchArea {
                                    clicked => {
                                        root.model-menu-open = !root.model-menu-open;
                                        root.attachment-menu-open = false; root.access-menu-open = false; root.effort-menu-open = false;
                                    }
                                }
                            }
                            Rectangle {
                                width: 48px;
                                Text { text: root.effort + "  v"; color: #57534e; font-size: 10px; vertical-alignment: center; }
                                TouchArea {
                                    clicked => {
                                        root.effort-menu-open = !root.effort-menu-open;
                                        root.attachment-menu-open = false; root.access-menu-open = false; root.model-menu-open = false;
                                    }
                                }
                            }
                            Rectangle {
                                width: 24px; height: 24px; border-radius: 12px; background: #737b8c;
                                Text { text: "↑"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea {
                                    clicked => {
                                        if (root.composer-text != "") {
                                            root.last-message = root.composer-text;
                                            root.trajectory-selected = false;
                                            root.send-message(root.composer-text);
                                            root.composer-text = "";
                                        }
                                    }
                                }
                            }
                        }
                        if root.attachment-menu-open: Rectangle {
                            x: 8px; y: -58px; width: 126px; height: 57px;
                            border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                            drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                            VerticalLayout {
                                padding: 2px;
                                MenuOption { label: "添加文件"; chosen => {
                                    root.selected-attachment = root.choose-attachment(false);
                                    if (root.selected-attachment != "") { root.composer-text = "请处理文件：" + root.selected-attachment; }
                                    root.attachment-menu-open = false;
                                } }
                                MenuOption { label: "添加文件夹"; chosen => {
                                    root.selected-attachment = root.choose-attachment(true);
                                    if (root.selected-attachment != "") { root.composer-text = "请处理文件夹：" + root.selected-attachment; }
                                    root.attachment-menu-open = false;
                                } }
                            }
                        }
                        if root.access-menu-open: Rectangle {
                            x: 35px; y: -84px; width: 132px; height: 83px;
                            border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                            drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                            VerticalLayout {
                                padding: 1px;
                                MenuOption { label: "完全访问"; active: root.access-mode == "完全访问"; chosen => { root.access-mode = "完全访问"; root.access-menu-open = false; } }
                                MenuOption { label: "受限访问"; active: root.access-mode == "受限访问"; chosen => { root.access-mode = "受限访问"; root.access-menu-open = false; } }
                                MenuOption { label: "只读模式"; active: root.access-mode == "只读模式"; chosen => { root.access-mode = "只读模式"; root.access-menu-open = false; } }
                            }
                        }
                        if root.model-menu-open: Rectangle {
                            x: parent.width - 306px;
                            y: -min(164px, root.model-choices.length * 27px + 2px);
                            width: 220px;
                            height: min(164px, root.model-choices.length * 27px + 2px);
                            border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                            drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                            VerticalLayout {
                                padding: 1px;
                                for choice in root.model-choices: MenuOption {
                                    label: choice.label;
                                    active: root.model-name == choice.model && root.setting-provider == choice.provider;
                                    chosen => {
                                        root.model-name = choice.model;
                                        root.setting-main-model = choice.model;
                                        root.setting-provider = choice.provider;
                                        root.model-menu-open = false;
                                    }
                                }
                            }
                        }
                        if root.effort-menu-open: Rectangle {
                            x: parent.width - 133px; y: -111px; width: 92px; height: 110px;
                            border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                            drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                            VerticalLayout {
                                padding: 1px;
                                MenuOption { label: "最高"; active: root.effort == "最高"; chosen => { root.effort = "最高"; root.effort-menu-open = false; } }
                                MenuOption { label: "高"; active: root.effort == "高"; chosen => { root.effort = "高"; root.effort-menu-open = false; } }
                                MenuOption { label: "标准"; active: root.effort == "标准"; chosen => { root.effort = "标准"; root.effort-menu-open = false; } }
                                MenuOption { label: "低"; active: root.effort == "低"; chosen => { root.effort = "低"; root.effort-menu-open = false; } }
                            }
                        }
                    }
                }
            }
        }

            Rectangle {
                visible: root.code-visible;
                width: root.code-visible ? 6px : 0px;
                background: right-resize.has-hover || right-resize.pressed ? #fdfbf7 : #ffffff;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: right-resize.has-hover || right-resize.pressed ? 2px : 1px;
                    height: parent.height;
                    background: right-resize.has-hover || right-resize.pressed ? #c86a28 : #e7e5e4;
                }
                right-resize := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.code-panel-width = max(300px, min(
                                min(620px, root.width - (root.sidebar-visible ? root.sidebar-width + 6px : 0px) - 366px),
                                root.code-panel-width - (self.mouse-x - self.width / 2)
                            ));
                        }
                    }
                }
            }

            code-panel := Rectangle {
            visible: root.code-visible;
            width: root.code-visible ? root.code-panel-width : 0px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e7e5e4;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 38px;
                    HorizontalLayout {
                        padding-left: 13px;
                        spacing: 16px;
                        Rectangle {
                            width: 58px;
                            Text { text: "代码审阅"; color: !root.file-preview-selected ? #8b5229 : #78716c; font-size: 11px; font-weight: 600; }
                            Rectangle { visible: !root.file-preview-selected; y: 35px; height: 2px; width: 58px; background: #f97316; }
                            TouchArea { clicked => { root.file-preview-selected = false; } }
                        }
                        Rectangle {
                            width: 58px;
                            Text { text: "文件预览"; color: root.file-preview-selected ? #8b5229 : #78716c; font-size: 11px; }
                            Rectangle { visible: root.file-preview-selected; y: 35px; height: 2px; width: 58px; background: #f97316; }
                            TouchArea { clicked => { root.file-preview-selected = true; } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolIcon { source: @image-url("../assets/figma/icon-39.svg"); clicked => { root.code-visible = false; } }
                    }
                }
                Rectangle {
                    height: 36px;
                    background: #fafaf9;
                    border-width: 1px;
                    border-color: #e7e5e4;
                    HorizontalLayout {
                        width: parent.width; height: parent.height;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        Text { text: "◈"; font-size: 12px; vertical-alignment: center; }
                        Rectangle {
                            width: 112px;
                            Text { text: root.file-preview-selected ? "结果预览  v" : "光子投影  v"; color: #44403c; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            TouchArea { clicked => { root.file-menu-open = !root.file-menu-open; root.code-menu-open = false; } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.code-lines.length + " 行"; color: #16a34a; font-size: 10px; vertical-alignment: center; }
                        ToolIcon {
                            source: @image-url("../assets/figma/icon-35.svg"); icon-size: 14px;
                            clicked => { root.code-menu-open = !root.code-menu-open; root.file-menu-open = false; }
                        }
                    }
                    if root.file-menu-open: Rectangle {
                        x: 28px; y: 33px; width: 150px; height: 58px;
                        border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                        drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                        VerticalLayout {
                            padding: 2px;
                            MenuOption { label: "光子投影"; active: !root.file-preview-selected; chosen => { root.file-preview-selected = false; root.file-menu-open = false; } }
                            MenuOption { label: "结果预览"; active: root.file-preview-selected; chosen => { root.file-preview-selected = true; root.file-menu-open = false; } }
                        }
                    }
                    if root.code-menu-open: Rectangle {
                        x: parent.width - 154px; y: 33px; width: 145px; height: 58px;
                        border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                        drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                        VerticalLayout {
                            padding: 2px;
                            MenuOption { label: "重新审阅"; chosen => { root.status-text = "正在重新审阅"; root.reconcile(); root.code-menu-open = false; } }
                            MenuOption { label: "关闭审阅面板"; chosen => { root.code-visible = false; root.code-menu-open = false; } }
                        }
                    }
                }
                if !root.file-preview-selected: ListView {
                    vertical-stretch: 1;
                    for line in root.code-lines: Rectangle {
                        height: 20px;
                        background: line.number == 4 ? #f0fdf4 : transparent;
                        HorizontalLayout {
                            Text {
                                width: 31px;
                                text: line.number;
                                color: #d6d3d1;
                                font-family: "MiSans VF";
                                font-size: 10px;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: line.text;
                                color: line.tone == "keyword" ? #8200db : line.tone == "string" ? #007a55 : line.tone == "comment" ? #99a1af : #1e2939;
                                font-family: "MiSans VF";
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.file-preview-selected: Rectangle {
                    vertical-stretch: 1;
                    background: #fafaf9;
                    Text {
                        x: 22px; y: 22px; width: parent.width - 44px;
                        text: root.assistant-text == "" ? "当前会话尚无可预览结果。" : root.assistant-text;
                        color: #44403c; font-family: "MiSans VF"; font-size: 12px;
                    }
                }
                Rectangle {
                    height: 32px;
                    background: #fafaf9;
                    border-width: 1px;
                    border-color: #e7e5e4;
                    HorizontalLayout {
                        width: parent.width; height: parent.height;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        StatusDot { tone: "success"; }
                        Text { text: root.status-text; color: #16a34a; font-size: 10.5px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "Photon  |  UTF-8  |"; color: #78716c; font-size: 10px; vertical-alignment: center; }
                        Rectangle {
                            width: 62px;
                            Text { text: "0 个问题  ^"; color: #78716c; font-size: 10px; vertical-alignment: center; }
                            TouchArea { clicked => { root.issues-open = !root.issues-open; } }
                        }
                    }
                    if root.issues-open: Rectangle {
                        x: parent.width - 274px; y: -78px; width: 264px; height: 74px;
                        border-radius: 8px; background: white; border-width: 1px; border-color: #e7e5e4;
                        drop-shadow-blur: 8px; drop-shadow-color: #00000018;
                        VerticalLayout {
                            padding: 5px; spacing: 2px;
                            Text { text: "问题"; color: #292524; font-size: 10.5px; font-weight: 700; }
                            Text { text: "当前投影没有发现问题"; color: #78716c; font-size: 9.5px; }
                        }
                    }
                }
            }
            }
        }
    }

    if root.create-navigation-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #1c19174f;
        TouchArea { clicked => { root.create-navigation-open = false; } }
        create-navigation-dialog := Rectangle {
            width: 460px; height: root.create-navigation-kind == "group" ? 258px : 358px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px; background: white;
            border-width: 1px; border-color: #e7e5e4;
            drop-shadow-blur: 20px; drop-shadow-color: #00000030;
            Text {
                x: 22px; y: 19px;
                text: root.create-navigation-kind == "session" ? "新建会话" : "新建分组或项目";
                color: #292524; font-size: 15px; font-weight: 700;
            }
            Text { x: 22px; y: 52px; text: "类型"; color: #78716c; font-size: 10px; }
            HorizontalLayout {
                x: 22px; y: 72px; width: parent.width - 44px; height: 34px; spacing: 8px;
                if root.create-navigation-kind == "session": SettingsChoice {
                    horizontal-stretch: 1; label: "会话"; active: true;
                }
                if root.create-navigation-kind != "session": SettingsChoice {
                    horizontal-stretch: 1; label: "分组";
                    active: root.create-navigation-kind == "group";
                    chosen => { root.create-navigation-kind = "group"; }
                }
                if root.create-navigation-kind != "session": SettingsChoice {
                    horizontal-stretch: 1; label: "项目";
                    active: root.create-navigation-kind == "project";
                    chosen => {
                        root.create-navigation-kind = "project";
                        if (root.create-navigation-workspace == "") {
                            root.create-navigation-workspace = root.setting-workspace;
                        }
                    }
                }
            }
            Text { x: 22px; y: 121px; text: "名称"; color: #78716c; font-size: 10px; }
            create-name := LineEdit {
                x: 22px; y: 140px; width: parent.width - 44px; height: 34px;
                text <=> root.create-navigation-name;
                placeholder-text: root.create-navigation-kind == "group" ? "例如：内容生产" :
                                  root.create-navigation-kind == "session" ? "例如：实现字幕导出" :
                                  "例如：字幕制作空间";
            }
            if root.create-navigation-kind != "group": Text {
                x: 22px; y: 187px;
                text: root.create-navigation-kind == "session" ? "工作空间（默认继承所在项目，可在此覆盖）" : "项目工作空间";
                color: #78716c; font-size: 10px;
            }
            if root.create-navigation-kind != "group": LineEdit {
                x: 22px; y: 206px; width: parent.width - 122px; height: 34px;
                text <=> root.create-navigation-workspace;
                placeholder-text: "选择或输入文件夹的绝对路径";
            }
            if root.create-navigation-kind != "group": Rectangle {
                x: parent.width - 92px; y: 206px; width: 70px; height: 34px;
                border-radius: 8px; border-width: 1px; border-color: #e7e5e4;
                background: browse-workspace.has-hover ? #f5f5f4 : white;
                Text {
                    text: "浏览…"; color: #57534e; font-size: 10.5px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                browse-workspace := TouchArea {
                    clicked => {
                        root.selected-attachment = root.choose-attachment(true);
                        if (root.selected-attachment != "") {
                            root.create-navigation-workspace = root.selected-attachment;
                        }
                    }
                }
            }
            if root.create-navigation-kind != "group": Text {
                x: 22px; y: 246px; width: parent.width - 44px; height: 30px;
                text: "切换到该节点时，模型会话、文件工具和 tokmond 都会使用这个目录。";
                color: #a8a29e; font-size: 9px; wrap: word-wrap;
            }
            if root.create-navigation-error != "": Text {
                x: 22px; y: root.create-navigation-kind == "group" ? 181px : 276px;
                width: parent.width - 44px; height: 20px;
                text: root.create-navigation-error; color: #dc2626; font-size: 9.5px;
                overflow: elide;
            }
            Rectangle {
                x: parent.width - 188px; y: parent.height - 48px; width: 76px; height: 32px;
                border-radius: 8px; border-width: 1px; border-color: #e7e5e4;
                background: cancel-create.has-hover ? #f5f5f4 : white;
                Text { text: "取消"; color: #57534e; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                cancel-create := TouchArea { clicked => { root.create-navigation-open = false; } }
            }
            Rectangle {
                x: parent.width - 104px; y: parent.height - 48px; width: 82px; height: 32px;
                border-radius: 8px;
                background: root.create-navigation-name == "" ||
                            (root.create-navigation-kind != "group" && root.create-navigation-workspace == "")
                            ? #d6d3d1 : #c86a28;
                Text { text: "创建"; color: white; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea {
                    enabled: root.create-navigation-name != "" &&
                             (root.create-navigation-kind == "group" || root.create-navigation-workspace != "");
                    clicked => {
                        if (root.create-navigation(root.create-navigation-kind,
                                                   root.create-navigation-name,
                                                   root.create-navigation-workspace)) {
                            root.create-navigation-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #1c19174f;
        TouchArea { clicked => { root.cancel-settings(); root.settings-open = false; } }
        settings-dialog := Rectangle {
            width: min(parent.width - 40px, 1120px);
            height: min(parent.height - 40px, 720px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px; clip: true; background: white;
            border-width: 1px; border-color: #e7e5e4;
            drop-shadow-blur: 24px; drop-shadow-color: #0000003a;

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 56px;
                background: #ffffff; border-width: 1px; border-color: #f0eee8;
                Text {
                    x: 22px; width: 120px; height: parent.height;
                    text: "设置"; color: #1c1917; font-size: 21px; font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: (parent.width - self.width) / 2; y: 11px;
                    width: min(350px, parent.width - 410px); height: 34px;
                    border-radius: 11px; background: #f9f9f8;
                    border-width: 1px; border-color: #f0eee8;
                    Image { x: 11px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/figma/icon-03.svg"); }
                    LineEdit {
                        x: 34px; y: 1px; width: parent.width - 42px; height: 32px;
                        placeholder-text: "搜索设置项"; font-size: 10.5px;
                        text <=> root.settings-search;
                    }
                }
                Text {
                    x: parent.width - 260px; width: 210px; height: parent.height;
                    text: root.settings-status; color: #a8a29e; font-size: 9.5px;
                    horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                }
                ToolIcon {
                    x: parent.width - 42px; y: 15px;
                    source: @image-url("../assets/figma/icon-39.svg");
                    clicked => { root.cancel-settings(); root.settings-open = false; }
                }
            }

            Rectangle {
                x: 0px; y: 56px; width: 220px; height: parent.height - 112px;
                background: #fbfbf9; border-width: 1px; border-color: #f0eee8;
                Rectangle {
                    visible: false;
                    x: 14px; y: 14px; width: parent.width - 28px; height: 34px;
                    border-radius: 9px; background: #f0eee8;
                    Image { x: 10px; y: 9px; width: 15px; height: 15px; source: @image-url("../assets/figma/icon-03.svg"); }
                    LineEdit {
                        x: 31px; y: 1px; width: parent.width - 36px; height: 32px;
                        placeholder-text: "搜索设置项"; font-size: 10.5px;
                        text <=> root.settings-search;
                    }
                }
                VerticalLayout {
                    x: 12px; y: 16px; width: parent.width - 24px; height: 335px; spacing: 1px;
                    SettingsNavigationRow { glyph: "⚙"; label: "通用"; active: root.settings-page == 0; chosen => { root.settings-page = 0; } }
                    SettingsNavigationRow { glyph: "◇"; label: "智能体与模型"; active: root.settings-page == 1; chosen => { root.settings-page = 1; } }
                    SettingsNavigationRow { glyph: "◈"; label: "权限与安全"; active: root.settings-page == 2; chosen => { root.settings-page = 2; } }
                    SettingsNavigationRow { glyph: "▣"; label: "工作区"; active: root.settings-page == 3; chosen => { root.settings-page = 3; } }
                    SettingsNavigationRow { glyph: "◉"; label: "通知"; active: root.settings-page == 4; chosen => { root.settings-page = 4; } }
                    SettingsNavigationRow { glyph: "◐"; label: "外观"; active: root.settings-page == 5; chosen => { root.settings-page = 5; } }
                    SettingsNavigationRow { glyph: "⌘"; label: "快捷键"; active: root.settings-page == 6; chosen => { root.settings-page = 6; } }
                    SettingsNavigationRow { glyph: "◎"; label: "账户"; active: root.settings-page == 7; chosen => { root.settings-page = 7; } }
                }
                Rectangle {
                    x: 14px; y: parent.height - 51px; width: parent.width - 28px; height: 36px;
                    border-radius: 11px; background: #f7efe5;
                    StatusDot { x: 10px; y: 14px; tone: "success"; }
                    Text {
                        x: 25px; width: parent.width - 34px; height: parent.height;
                        text: root.daemon-state; color: #78716c; font-size: 9.5px;
                        vertical-alignment: center; overflow: elide;
                    }
                }
            }

            settings-content := Rectangle {
                x: 220px; y: 56px; width: parent.width - 450px; height: parent.height - 112px;
                background: white;
                Text {
                    x: 28px; y: 23px; width: parent.width - 56px; height: 25px;
                    text: root.settings-page == 0 ? "通用设置" :
                          root.settings-page == 1 ? "智能体与模型" :
                          root.settings-page == 2 ? "权限与安全" :
                          root.settings-page == 3 ? "工作区" :
                          root.settings-page == 4 ? "通知" :
                          root.settings-page == 5 ? "外观" :
                          root.settings-page == 6 ? "快捷键" : "账户";
                    color: #1c1917; font-size: 15px; font-weight: 700;
                }
                Text {
                    x: 28px; y: 50px; width: parent.width - 56px; height: 18px;
                    text: root.settings-page == 0 ? "管理语言、启动行为、保存与更新偏好" :
                          root.settings-page == 1 ? "选择默认智能体、模型提供方与推理强度" :
                          root.settings-page == 2 ? "控制文件、命令、网络与高风险操作" :
                          root.settings-page == 3 ? "配置当前项目的索引、同步和 Git 集成" :
                          root.settings-page == 4 ? "决定 Tokmon 何时以及如何提醒你" :
                          root.settings-page == 5 ? "调整主题、强调色、密度和字号" :
                          root.settings-page == 6 ? "查看并重新录制常用操作的快捷键" : "管理个人信息、方案与云同步";
                    color: #a8a29e; font-size: 9.5px;
                }
                Rectangle { x: 28px; y: 79px; width: parent.width - 56px; height: 1px; background: #f0eee8; }

                if root.settings-page == 0: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    SettingsValueRow { x: 0px; y: 0px; width: parent.width; title: "应用语言"; detail: "设置界面与系统消息使用的语言"; value: root.setting-language; chosen => { root.setting-language = root.setting-language == "简体中文" ? "English" : "简体中文"; } }
                    SettingsValueRow { x: 0px; y: 70px; width: parent.width; title: "启动时打开"; detail: "Tokmon Desktop 启动后的默认位置"; value: root.setting-startup; chosen => { root.setting-startup = root.setting-startup == "首页" ? "上次打开的会话" : "首页"; } }
                    Rectangle {
                        x: 0px; y: 140px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "自动保存"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "每 5 分钟保存会话和工作区状态"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-autosave; toggled(value) => { root.setting-autosave = value; } }
                    }
                    SettingsValueRow { x: 0px; y: 210px; width: parent.width; title: "更新通道"; detail: "稳定版提供经过完整验证的更新"; value: "稳定版"; }
                }

                if root.settings-page == 1: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    Text { x: 0px; y: 0px; text: "平台 ID"; color: #292524; font-size: 10px; font-weight: 600; }
                    LineEdit { x: 0px; y: 17px; width: 160px; height: 32px; text <=> root.setting-provider; placeholder-text: "例如 deepseek / private-cloud"; }
                    Text { x: 174px; y: 0px; text: "协议适配器"; color: #292524; font-size: 10px; font-weight: 600; }
                    Rectangle {
                        x: 174px; y: 17px; width: parent.width - 174px; height: 32px; border-radius: 6px;
                        border-width: 1px; border-color: #e7e5e4; background: white;
                        Text { x: 9px; width: parent.width - 28px; height: parent.height; text: root.setting-provider-protocol; font-size: 9.5px; color: #57534e; vertical-alignment: center; }
                        Text { x: parent.width - 19px; width: 12px; height: parent.height; text: "↻"; color: #a8a29e; vertical-alignment: center; }
                        TouchArea { clicked => { root.setting-provider-protocol = root.setting-provider-protocol == "openai-compatible" ? "anthropic" : root.setting-provider-protocol == "anthropic" ? "gemini" : "openai-compatible"; } }
                    }
                    Text { x: 0px; y: 58px; text: "HTTPS Endpoint"; color: #292524; font-size: 10px; font-weight: 600; }
                    LineEdit { x: 0px; y: 75px; width: parent.width; height: 32px; text <=> root.setting-provider-endpoint; placeholder-text: "https://…/chat/completions"; }
                    Text { x: 0px; y: 116px; text: "模型"; color: #292524; font-size: 10px; font-weight: 600; }
                    LineEdit { x: 0px; y: 133px; width: 218px; height: 32px; text <=> root.setting-main-model; placeholder-text: "模型 ID"; }
                    Text { x: 232px; y: 116px; text: "鉴权"; color: #292524; font-size: 10px; font-weight: 600; }
                    Rectangle {
                        x: 232px; y: 133px; width: parent.width - 232px; height: 32px; border-radius: 6px;
                        border-width: 1px; border-color: #e7e5e4; background: white;
                        Text { x: 9px; width: parent.width - 18px; height: parent.height; text: root.setting-provider-auth; font-size: 9px; color: #57534e; vertical-alignment: center; }
                        TouchArea { clicked => { root.setting-provider-auth = root.setting-provider-auth == "protocol-default" ? "bearer" : root.setting-provider-auth == "bearer" ? "x-api-key" : "protocol-default"; } }
                    }
                    Text { x: 0px; y: 175px; text: "API Key（仅写入系统凭据库）"; color: #292524; font-size: 10px; font-weight: 600; }
                    LineEdit { x: 0px; y: 192px; width: parent.width - 112px; height: 32px; text <=> root.setting-provider-secret; input-type: password; placeholder-text: root.setting-provider-credential; }
                    Rectangle {
                        x: parent.width - 104px; y: 192px; width: 104px; height: 32px; border-radius: 7px; background: #292524;
                        Text { text: "安全保存 Key"; color: white; font-size: 9.5px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { if (root.setting-provider-secret != "") { root.store-provider-secret(root.setting-provider, root.setting-provider-secret); root.setting-provider-secret = ""; root.settings-status = "正在写入系统凭据库…"; } } }
                    }
                    Rectangle {
                        x: 0px; y: 234px; width: parent.width; height: 42px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 10px; y: 6px; text: "扩展推理字段"; font-size: 9.5px; color: #292524; font-weight: 600; }
                        Text { x: 10px; y: 23px; text: "仅在平台明确兼容时启用"; font-size: 8.5px; color: #a8a29e; }
                        SettingsSwitch { x: parent.width - 50px; y: 9px; checked: root.setting-provider-thinking; toggled(value) => { root.setting-provider-thinking = value; } }
                    }
                    HorizontalLayout {
                        x: 0px; y: 285px; width: parent.width; height: 32px; spacing: 8px;
                        SettingsChoice { horizontal-stretch: 1; label: "保存平台配置"; active: false; chosen => { root.configure-provider(root.setting-provider, root.setting-provider-protocol, root.setting-provider-endpoint, root.setting-main-model, root.setting-provider-auth, root.setting-provider-thinking, root.setting-reasoning); root.settings-status = "正在原子保存 provider YAML…"; } }
                        SettingsChoice { horizontal-stretch: 1; label: "测试真实连接"; active: true; chosen => { root.test-provider(root.setting-provider); root.settings-status = "正在通过 Rhea 测试真实连接…"; } }
                    }
                    Text { x: 14px; y: 329px; text: "推理强度"; color: #292524; font-size: 11px; font-weight: 600; }
                    HorizontalLayout {
                        x: 14px; y: 350px; width: parent.width - 28px; height: 32px; spacing: 8px;
                        SettingsChoice { horizontal-stretch: 1; label: "低"; active: root.setting-reasoning == "低"; chosen => { root.setting-reasoning = "低"; } }
                        SettingsChoice { horizontal-stretch: 1; label: "标准"; active: root.setting-reasoning == "标准"; chosen => { root.setting-reasoning = "标准"; } }
                        SettingsChoice { horizontal-stretch: 1; label: "高"; active: root.setting-reasoning == "高"; chosen => { root.setting-reasoning = "高"; } }
                    }
                }

                if root.settings-page == 2: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    SettingsValueRow { x: 0px; y: 0px; width: parent.width; title: "文件访问"; detail: "仅访问当前工作区与已授权目录"; value: "受信路径"; }
                    SettingsValueRow { x: 0px; y: 70px; width: parent.width; title: "命令审批"; detail: "控制命令执行前是否需要确认"; value: root.setting-command-approval; chosen => { root.setting-command-approval = root.setting-command-approval == "自动执行" ? "按需确认" : root.setting-command-approval == "按需确认" ? "禁止执行" : "自动执行"; } }
                    Rectangle {
                        x: 0px; y: 140px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "网络访问"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "允许透镜访问已授权的网络端点"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-network; toggled(value) => { root.setting-network = value; } }
                    }
                    Rectangle {
                        x: 0px; y: 210px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "高风险操作二次确认"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "外部不可逆操作始终要求显式确认"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-high-risk; toggled(value) => { root.setting-high-risk = value; } }
                    }
                }

                if root.settings-page == 3: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    SettingsValueRow { x: 0px; y: 0px; width: parent.width; title: "默认工作区"; detail: "新项目和文件选择器的初始目录"; value: root.setting-workspace; }
                    SettingsValueRow { x: 0px; y: 70px; width: parent.width; title: "索引模式"; detail: "平衡搜索召回率、速度与磁盘占用"; value: root.setting-index-mode; chosen => { root.setting-index-mode = root.setting-index-mode == "标准" ? "完整" : root.setting-index-mode == "完整" ? "轻量" : "标准"; } }
                    Rectangle {
                        x: 0px; y: 140px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "自动同步"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "文件变更后自动刷新工作区投影"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-workspace-sync; toggled(value) => { root.setting-workspace-sync = value; } }
                    }
                    Rectangle {
                        x: 0px; y: 210px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "Git 集成"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "显示差异、分支和提交上下文"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-git; toggled(value) => { root.setting-git = value; } }
                    }
                }

                if root.settings-page == 4: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "启用通知"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "允许 Tokmon 发送状态提醒"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-notifications; toggled(value) => { root.setting-notifications = value; } }
                    }
                    Rectangle {
                        x: 0px; y: 70px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "桌面通知"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "任务完成或需要审批时显示系统通知"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-desktop-notifications; toggled(value) => { root.setting-desktop-notifications = value; } }
                    }
                    Rectangle {
                        x: 0px; y: 140px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "消息提醒"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "模型回复和工具结果到达时提醒"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-message-alerts; toggled(value) => { root.setting-message-alerts = value; } }
                    }
                    Rectangle {
                        x: 0px; y: 210px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "免打扰"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "22:00 — 08:00 暂停非关键通知"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-quiet-hours; toggled(value) => { root.setting-quiet-hours = value; } }
                    }
                }

                if root.settings-page == 5: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    Text { x: 14px; y: 5px; text: "主题模式"; color: #292524; font-size: 11px; font-weight: 600; }
                    HorizontalLayout {
                        x: 14px; y: 30px; width: parent.width - 28px; height: 32px; spacing: 8px;
                        SettingsChoice { horizontal-stretch: 1; label: "浅色"; active: !root.setting-dark-theme; chosen => { root.setting-dark-theme = false; } }
                        SettingsChoice { horizontal-stretch: 1; label: "深色"; active: root.setting-dark-theme; chosen => { root.setting-dark-theme = true; } }
                    }
                    Text { x: 14px; y: 88px; text: "强调色"; color: #292524; font-size: 11px; font-weight: 600; }
                    HorizontalLayout {
                        x: 14px; y: 114px; width: 220px; height: 30px; spacing: 10px;
                        for color[index] in [#f5a623, #f43f5e, #a855f7, #3b82f6, #22c55e, #78716c]: Rectangle {
                            width: 28px; height: 28px; border-radius: 14px; background: color;
                            border-width: root.setting-accent == index ? 3px : 0px; border-color: #292524;
                            TouchArea { clicked => { root.setting-accent = index; } }
                        }
                    }
                    Text { x: 14px; y: 173px; text: "界面密度"; color: #292524; font-size: 11px; font-weight: 600; }
                    HorizontalLayout {
                        x: 14px; y: 198px; width: parent.width - 28px; height: 32px; spacing: 8px;
                        SettingsChoice { horizontal-stretch: 1; label: "紧凑"; active: root.setting-density == "紧凑"; chosen => { root.setting-density = "紧凑"; } }
                        SettingsChoice { horizontal-stretch: 1; label: "舒适"; active: root.setting-density == "舒适"; chosen => { root.setting-density = "舒适"; } }
                        SettingsChoice { horizontal-stretch: 1; label: "宽松"; active: root.setting-density == "宽松"; chosen => { root.setting-density = "宽松"; } }
                    }
                    SettingsValueRow { x: 0px; y: 249px; width: parent.width; title: "字体大小"; detail: "界面文本相对系统字号"; value: root.setting-font-scale + "%"; chosen => { root.setting-font-scale = root.setting-font-scale >= 125 ? 90 : root.setting-font-scale + 10; } }
                }

                if root.settings-page == 6: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    SettingsValueRow { x: 0px; y: 0px; width: parent.width; title: "新建会话"; detail: "创建一个空白因果光线"; value: root.shortcut-editing == 0 ? "请按下快捷键…" : "Ctrl + N"; chosen => { root.shortcut-editing = 0; } }
                    SettingsValueRow { x: 0px; y: 70px; width: parent.width; title: "打开设置"; detail: "显示当前设置弹窗"; value: root.shortcut-editing == 1 ? "请按下快捷键…" : "Ctrl + ,"; chosen => { root.shortcut-editing = 1; } }
                    SettingsValueRow { x: 0px; y: 140px; width: parent.width; title: "发送消息"; detail: "提交输入并推进当前光线"; value: root.shortcut-editing == 2 ? "请按下快捷键…" : "Enter"; chosen => { root.shortcut-editing = 2; } }
                    SettingsValueRow { x: 0px; y: 210px; width: parent.width; title: "命令面板"; detail: "搜索全部可用动作"; value: root.shortcut-editing == 3 ? "请按下快捷键…" : "Ctrl + Shift + P"; chosen => { root.shortcut-editing = 3; } }
                }

                if root.settings-page == 7: Rectangle {
                    x: 28px; y: 94px; width: parent.width - 56px; height: parent.height - 110px;
                    Rectangle { x: 14px; y: 6px; width: 58px; height: 58px; border-radius: 29px; background: #fef08a;
                        Text { text: "JC"; color: #8b5229; font-size: 17px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { x: 88px; y: 12px; text: root.setting-nickname; color: #292524; font-size: 13px; font-weight: 700; }
                    Text { x: 88px; y: 36px; text: root.setting-email; color: #a8a29e; font-size: 9.5px; }
                    Text { x: 14px; y: 92px; text: "昵称"; color: #292524; font-size: 11px; font-weight: 600; }
                    LineEdit { x: 14px; y: 116px; width: parent.width - 28px; height: 36px; text <=> root.setting-nickname; }
                    Text { x: 14px; y: 174px; text: "登录邮箱"; color: #292524; font-size: 11px; font-weight: 600; }
                    LineEdit { x: 14px; y: 198px; width: parent.width - 28px; height: 36px; text <=> root.setting-email; }
                    SettingsValueRow { x: 0px; y: 250px; width: parent.width; title: "当前方案"; detail: "包含模型额度与同步空间"; value: "Pro"; }
                    Rectangle {
                        x: 0px; y: 320px; width: parent.width; height: 64px; border-width: 1px; border-color: #f0eee8;
                        Text { x: 14px; y: 10px; text: "云同步"; color: #292524; font-size: 11px; font-weight: 600; }
                        Text { x: 14px; y: 31px; text: "在设备间同步偏好和会话索引"; color: #a8a29e; font-size: 9.5px; }
                        SettingsSwitch { x: parent.width - 54px; y: 20px; checked: root.setting-cloud-sync; toggled(value) => { root.setting-cloud-sync = value; } }
                    }
                }
            }

            Rectangle {
                x: parent.width - 230px; y: 56px; width: 230px; height: parent.height - 112px;
                background: #fdfbf7; border-width: 1px; border-color: #f0eee8;
                Text {
                    x: 24px; y: 28px; width: parent.width - 48px; height: 24px;
                    text: root.settings-page == 0 ? "通用概览" :
                          root.settings-page == 1 ? "模型概览" :
                          root.settings-page == 2 ? "安全概览" :
                          root.settings-page == 3 ? "工作区概览" :
                          root.settings-page == 4 ? "通知概览" :
                          root.settings-page == 5 ? "外观概览" :
                          root.settings-page == 6 ? "快捷键概览" : "账户概览";
                    color: #1c1917; font-size: 12px; font-weight: 700;
                }
                Rectangle {
                    x: 24px; y: 67px; width: parent.width - 48px; height: 118px;
                    border-radius: 16px; background: #ffffffd8;
                    Text { x: 14px; y: 13px; text: "当前配置"; color: #57534e; font-size: 10px; font-weight: 700; }
                    Text {
                        x: 14px; y: 38px; width: parent.width - 28px; height: 66px;
                        text: root.settings-page == 0 ? root.setting-language + "\n" + root.setting-startup + "\n自动保存：" + (root.setting-autosave ? "开启" : "关闭") :
                              root.settings-page == 1 ? root.setting-provider + "\n" + root.setting-main-model + "\n推理：" + root.setting-reasoning :
                              root.settings-page == 2 ? root.setting-command-approval + "\n网络：" + (root.setting-network ? "允许" : "禁止") + "\n二次确认：" + (root.setting-high-risk ? "开启" : "关闭") :
                              root.settings-page == 3 ? root.setting-workspace + "\n索引：" + root.setting-index-mode + "\nGit：" + (root.setting-git ? "开启" : "关闭") :
                              root.settings-page == 4 ? "总开关：" + (root.setting-notifications ? "开启" : "关闭") + "\n桌面：" + (root.setting-desktop-notifications ? "开启" : "关闭") + "\n免打扰：" + (root.setting-quiet-hours ? "开启" : "关闭") :
                              root.settings-page == 5 ? (root.setting-dark-theme ? "深色" : "浅色") + "\n密度：" + root.setting-density + "\n字号：" + root.setting-font-scale + "%" :
                              root.settings-page == 6 ? "4 个快捷键\n点击任一行可重新录制" : root.setting-nickname + "\n" + root.setting-email + "\nPro";
                        color: #78716c; font-size: 9.5px; wrap: word-wrap;
                    }
                }
                Text {
                    x: 24px; y: 211px; width: parent.width - 48px; height: 98px;
                    text: "设置保存到当前项目的 .tokmon/config.yaml。修改由 tokmond 原子发布，其他客户端可在下一次连接时读取。";
                    color: #8b5229; font-size: 9.5px; wrap: word-wrap;
                }
                Rectangle {
                    x: 24px; y: parent.height - 67px; width: parent.width - 48px; height: 38px;
                    border-radius: 12px; background: #ffffffc8; border-width: 1px; border-color: #ebdcd0;
                    StatusDot { x: 12px; y: 16px; tone: "success"; }
                    Text { x: 29px; width: parent.width - 38px; height: parent.height; text: "因果流只追加 · 设置可替换"; color: #8b5229; font-size: 9px; vertical-alignment: center; }
                }
            }

            Rectangle {
                x: 0px; y: parent.height - 56px; width: parent.width; height: 56px;
                background: #ffffff; border-width: 1px; border-color: #f0eee8;
                Rectangle {
                    x: 20px; y: 11px; width: 118px; height: 34px; border-radius: 12px;
                    background: reset-touch.has-hover ? #f5f5f4 : white;
                    border-width: 1px; border-color: #e7e5e4;
                    Text { text: "恢复默认设置"; color: #78716c; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                    reset-touch := TouchArea { clicked => {
                        root.setting-language = "简体中文"; root.setting-startup = "上次打开的会话";
                        root.setting-autosave = true; root.setting-provider = "local";
                        root.setting-provider-endpoint = ""; root.setting-provider-protocol = "openai-compatible";
                        root.setting-provider-auth = "protocol-default"; root.setting-provider-thinking = false;
                        root.setting-main-model = "local-deterministic"; root.setting-reasoning = "标准";
                        root.setting-command-approval = "按需确认"; root.setting-network = true;
                        root.setting-high-risk = true; root.setting-index-mode = "标准";
                        root.setting-workspace-sync = true; root.setting-git = true;
                        root.setting-notifications = true; root.setting-desktop-notifications = true;
                        root.setting-message-alerts = true; root.setting-quiet-hours = false;
                        root.setting-dark-theme = false; root.setting-accent = 0;
                        root.setting-density = "舒适"; root.setting-font-scale = 100;
                        root.setting-cloud-sync = true; root.shortcut-editing = -1;
                        root.reset-settings();
                    } }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    x: parent.width - 194px; y: 11px; width: 74px; height: 34px;
                    border-radius: 12px; background: cancel-touch.has-hover ? #f5f5f4 : white;
                    border-width: 1px; border-color: #e7e5e4;
                    Text { text: "取消"; color: #57534e; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                    cancel-touch := TouchArea { clicked => { root.cancel-settings(); root.settings-open = false; } }
                }
                Rectangle {
                    x: parent.width - 112px; y: 11px; width: 92px; height: 34px;
                    border-radius: 12px; background: #f7efe5;
                    border-width: 1px; border-color: #ebdcd0;
                    Text { text: "保存更改"; color: #8b5229; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.save-settings(); root.settings-open = false; } }
                }
            }
        }
    }
}
