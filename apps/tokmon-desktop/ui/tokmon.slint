import { NavigationItem, ModelChoice, TimelineItem, CodeLine, SlashCommandItem, ProjectFile, GanttSegment, TraceEvent } from "tokmon-models.slint";
import { Palette } from "tokmon-theme.slint";
import { SettingsOverlay } from "tokmon-settings.slint";
import { CodePanelSlot } from "tokmon-code-panel.slint";
import { SidebarPanel } from "tokmon-sidebar.slint";
import { WorkspacePanel } from "tokmon-workspace.slint";
import { CreateNavigationOverlay } from "tokmon-navigation-overlays.slint";
import { ChangeWorkspaceOverlay } from "tokmon-workspace-overlay.slint";

export component MainWindow inherits Window {
    title: "Tokmon — A Lens to Them All";
    no-frame: true;
    preferred-width: root.code-visible ? 1440px : 999px;
    preferred-height: 900px;
    min-width: root.code-visible ? 1040px : 840px;
    min-height: 680px;
    background: Palette.app-bg;
    // Slint currently resolves one family here without the browser's CSS
    // fallback chain. YaHei UI keeps Chinese glyph coverage while retaining
    // Windows-native UI metrics for mixed Chinese/Latin labels.
    default-font-family: "Microsoft YaHei UI";

    in property <[NavigationItem]> navigation;
    in property <[TimelineItem]> timeline;
    in property <[TimelineItem]> conversation-workflow;
    in property <[CodeLine]> code-lines;
    in property <[SlashCommandItem]> slash-commands;
    in property <[ModelChoice]> model-choices;
    in property <[TraceEvent]> trace-events;
    in property <[GanttSegment]> gantt;
    in property <[string]> trace-ticks;
    in property <[ProjectFile]> project-files;
    in property <[ProjectFile]> workspace-presets;
    in property <[CodeLine]> preview-lines;

    in-out property <string> session-title: "新会话";
    in-out property <string> status-text: "就绪";
    in-out property <string> model-name: "-";
    in-out property <string> access-mode: "完全访问";
    in-out property <string> effort: "标准";
    in-out property <string> composer-text;
    in-out property <string> last-message;
    in-out property <string> assistant-text;
    in-out property <string> daemon-state: "正在连接后台服务";
    in-out property <string> search-text;
    in-out property <string> chat-time;
    in-out property <string> trace-duration: "-";
    in-out property <string> workflow-duration: "0ms";
    in-out property <string> trace-provider: "-";
    in-out property <string> trace-model: "-";
    in-out property <string> trace-result: "等待输入";
    in-out property <string> trace-total-label: "0";
    in-out property <string> trace-prompt-label: "0";
    in-out property <string> trace-completion-label: "0";
    in-out property <string> trace-search;
    in-out property <int> trace-selected-num: -1;
    in-out property <string> create-navigation-kind: "会话";
    in-out property <string> create-navigation-name;
    in-out property <string> create-navigation-workspace;
    in-out property <string> create-navigation-group;
    in-out property <string> create-navigation-error;
    in-out property <string> change-workspace-path;
    in property <[string]> group-options;
    in-out property <string> selected-attachment;
    in-out property <string> settings-search;
    in-out property <string> setting-language: "简体中文";
    in-out property <string> setting-startup: "首页";
    in-out property <string> setting-autosave: "5 分钟";
    in-out property <string> setting-channel: "稳定版";
    in-out property <string> setting-file-access: "受信路径";
    in-out property <string> provider-kind: "官方";
    in-out property <string> setting-provider;
    in-out property <string> setting-provider-protocol: "openai-compatible";
    in-out property <string> setting-provider-endpoint;
    in-out property <string> setting-provider-auth: "bearer";
    in-out property <string> setting-provider-secret;
    in-out property <string> setting-provider-credential;
    in-out property <string> setting-main-model;
    in-out property <string> setting-reasoning: "高";
    in-out property <string> setting-command-approval: "按需确认";
    in-out property <string> setting-workspace;
    in-out property <string> setting-index-mode: "标准";
    in-out property <string> setting-density: "舒适";
    in-out property <string> setting-nickname;
    in-out property <string> setting-email;
    in-out property <string> settings-status;
    in-out property <string> workspace-group: "默认";
    in-out property <string> workspace-project;
    in-out property <string> workspace-short-path;
    in-out property <string> workspace-branch;
    in property <int> workspace-indexed-files: 0;
    in property <bool> workspace-has-git: false;
    in-out property <bool> workspace-locked: false;
    in-out property <string> selected-file-name;
    in-out property <string> preview-search;
    in-out property <string> preview-content;
    in property <int> file-added-lines: 0;
    in property <bool> chat-empty: true;
    in property <int> search-session-count: 0;
    in-out property <int> trace-turns: 0;
    in-out property <int> trace-calls: 0;
    in-out property <int> trace-input-tokens: 0;
    in-out property <int> trace-output-tokens: 0;
    in-out property <int> settings-page: 0;
    in-out property <int> setting-accent: 0;
    in-out property <int> setting-font-scale: 100;
    in-out property <int> shortcut-editing: -1;
    in-out property <int> workflow-explored: 0;
    in-out property <int> workflow-ran: 0;
    in-out property <int> workflow-done: 0;
    in-out property <int> request-tab: 0;
    in-out property <int> trace-filter-index: 0;
    in-out property <int> trace-page: 1;
    in-out property <int> trace-page-size: 20;
    in-out property <int> trace-total: 0;
    in-out property <int> trace-pages: 1;
    in-out property <int> account-field: -1;
    in-out property <bool> sidebar-visible: true;
    in-out property <bool> code-visible: false;
    in-out property <bool> trajectory-selected: false;
    in-out property <bool> file-preview-selected: false;
    in-out property <bool> task-expanded: true;
    in-out property <bool> conversation-workflow-expanded: true;
    in-out property <bool> title-editing: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> access-menu-open: false;
    in-out property <bool> model-menu-open: false;
    in-out property <bool> effort-menu-open: false;
    in-out property <bool> file-menu-open: false;
    in-out property <bool> code-menu-open: false;
    in-out property <bool> issues-open: false;
    in-out property <bool> attachment-menu-open: false;
    in-out property <bool> trace-filter-open: false;
    in-out property <bool> context-popover-open: false;
    in-out property <bool> context-button-hover: false;
    in-out property <bool> context-card-hover: false;
    in-out property <bool> context-close-pending: false;
    in-out property <bool> copy-notice-visible: false;
    in-out property <bool> change-workspace-open: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> slash-menu-visible: false;
    in-out property <bool> create-navigation-open: false;
    in-out property <bool> setting-network: true;
    in-out property <bool> setting-high-risk: true;
    in-out property <bool> setting-provider-thinking: false;
    in-out property <bool> setting-workspace-sync: true;
    in-out property <bool> setting-git: true;
    in-out property <bool> setting-notifications: true;
    in-out property <bool> setting-desktop-notifications: true;
    in-out property <bool> setting-message-alerts: true;
    in-out property <string> setting-quiet-hours: "22:00 - 08:00";
    in-out property <bool> setting-dark-theme: false;
    in-out property <bool> setting-cloud-sync: true;
    in-out property <length> sidebar-width: 240px;
    in-out property <length> code-panel-width: 440px;
    in property <[string]> agent-options;
    in property <[string]> agent-providers;
    in property <[string]> agent-models;

    callback send-message(string);
    callback new-session();
    callback select-navigation(int);
    callback search-changed(string);
    callback add-navigation();
    callback reconcile();
    callback save-settings();
    callback reset-settings();
    callback configure-provider(string, string, string, string, string, bool, string);
    callback store-provider-secret(string, string);
    callback test-provider(string);
    callback drag-window();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback set-code-panel-visible(bool);
    callback slash-query-changed(string);
    callback rename-session(string);
    callback create-navigation(string, string, string, string) -> bool;
    callback choose-attachment(bool) -> string;
    callback cancel-settings();
    callback refresh-trace();
    callback export-trace();
    callback settings-searched(string);
    callback quick-create(int);
    callback clear-search();
    callback select-project-file(int);
    callback copy-text(string);
    callback open-change-workspace();
    callback confirm-change-workspace(string);
    callback refresh-workspace();
    pure callback identify-project(string) -> string;
    pure callback project-in-group(string, string) -> bool;
    callback filter-preview(string);

    pure function startup-selected() -> int {
        root.setting-startup == "首页" ? 0 : 1
    }
    pure function approval-selected() -> int {
        root.setting-command-approval == "自动执行" ? 0 : root.setting-command-approval == "禁止执行" ? 2 : 1
    }
    pure function effort-selected() -> int {
        root.setting-reasoning == "低" ? 0 : root.setting-reasoning == "标准" ? 1 : root.setting-reasoning == "高" ? 2 : 3
    }
    pure function accent-name(idx: int) -> string {
        idx == 1 ? "玫红" : idx == 2 ? "幻紫" : idx == 3 ? "湛蓝" : idx == 4 ? "青绿" : idx == 5 ? "石墨" : "浅金"
    }
    pure function accent-hex(idx: int) -> color {
        idx == 1 ? #F43F5E : idx == 2 ? #A855F7 : idx == 3 ? #3B82F6 : idx == 4 ? #22C55E : idx == 5 ? #6B7280 : #F5A623
    }
    pure function page-range-label() -> string {
        root.trace-total == 0 ? "显示 0 条，共 0 条"
            : "显示 " + ((root.trace-page - 1) * root.trace-page-size + 1) + "-" + Math.min(root.trace-total, root.trace-page * root.trace-page-size) + " 条，共 " + root.trace-total + " 条"
    }
    pure function setting-provider-at(i: int) -> string {
        root.agent-providers[i]
    }
    pure function setting-model-at(i: int) -> string {
        root.agent-models[i]
    }
    pure function prompt-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 :
            root.trace-input-tokens * 100 / (root.trace-input-tokens + root.trace-output-tokens)
    }
    pure function completion-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 : 100 - root.prompt-share()
    }

    function close-click-popups() {
        root.access-menu-open = false;
        root.model-menu-open = false;
        root.effort-menu-open = false;
        root.attachment-menu-open = false;
        root.slash-menu-visible = false;
    }

    function close-composer-popups() {
        root.close-click-popups();
        root.context-popover-open = false;
        root.context-button-hover = false;
        root.context-card-hover = false;
        root.context-close-pending = false;
    }

    Timer {
        interval: 2s;
        running: root.copy-notice-visible;
        triggered => { root.copy-notice-visible = false; }
    }

    Timer {
        interval: 140ms;
        running: root.context-close-pending;
        triggered => {
            if !root.context-button-hover && !root.context-card-hover {
                root.context-popover-open = false;
            }
            root.context-close-pending = false;
        }
    }

    // A click-open menu installs an input backdrop behind the actual controls.
    // Foreground buttons keep receiving their own events; otherwise this catches
    // the next blank-area click and dismisses the composer menus.
    if root.access-menu-open || root.model-menu-open || root.effort-menu-open || root.attachment-menu-open || root.slash-menu-visible : TouchArea {
        clicked => { root.close-click-popups(); }
    }

    VerticalLayout {
        HorizontalLayout {
            spacing: 0px;
            SidebarPanel {
                navigation: root.navigation;
                daemon-state: root.daemon-state;
                search-session-count: root.search-session-count;
                search-text <=> root.search-text;
                settings-open <=> root.settings-open;
                sidebar-visible <=> root.sidebar-visible;
                sidebar-width <=> root.sidebar-width;
                new-session => { root.new-session(); }
                select-navigation(index) => { root.select-navigation(index); }
                search-changed(text) => { root.search-changed(text); }
                quick-create(index) => { root.quick-create(index); }
                clear-search => { root.clear-search(); }
                settings-searched(text) => { root.settings-searched(text); }
            }
            WorkspacePanel {
                conversation-workflow: root.conversation-workflow;
                slash-commands: root.slash-commands;
                model-choices: root.model-choices;
                trace-events: root.trace-events;
                gantt: root.gantt;
                trace-ticks: root.trace-ticks;
                project-files: root.project-files;
                workspace-presets: root.workspace-presets;
                session-title <=> root.session-title;
                model-name <=> root.model-name;
                access-mode <=> root.access-mode;
                effort <=> root.effort;
                composer-text <=> root.composer-text;
                last-message: root.last-message;
                assistant-text: root.assistant-text;
                chat-time: root.chat-time;
                trace-duration: root.trace-duration;
                workflow-duration: root.workflow-duration;
                trace-provider: root.trace-provider;
                trace-model: root.trace-model;
                trace-result: root.trace-result;
                trace-total-label: root.trace-total-label;
                trace-prompt-label: root.trace-prompt-label;
                trace-completion-label: root.trace-completion-label;
                trace-search <=> root.trace-search;
                selected-attachment <=> root.selected-attachment;
                setting-command-approval: root.setting-command-approval;
                setting-main-model <=> root.setting-main-model;
                setting-workspace: root.setting-workspace;
                workspace-group: root.workspace-group;
                workspace-project: root.workspace-project;
                workspace-short-path <=> root.workspace-short-path;
                workspace-branch: root.workspace-branch;
                workspace-indexed-files: root.workspace-indexed-files;
                workspace-has-git: root.workspace-has-git;
                workspace-locked: root.workspace-locked;
                chat-empty: root.chat-empty;
                trace-selected-num <=> root.trace-selected-num;
                trace-page <=> root.trace-page;
                trace-page-size <=> root.trace-page-size;
                trace-total: root.trace-total;
                trace-pages: root.trace-pages;
                trace-turns: root.trace-turns;
                trace-calls: root.trace-calls;
                trace-input-tokens: root.trace-input-tokens;
                trace-output-tokens: root.trace-output-tokens;
                request-tab <=> root.request-tab;
                trace-filter-index <=> root.trace-filter-index;
                workflow-explored: root.workflow-explored;
                workflow-ran: root.workflow-ran;
                workflow-done: root.workflow-done;
                sidebar-visible <=> root.sidebar-visible;
                code-visible: root.code-visible;
                trajectory-selected <=> root.trajectory-selected;
                conversation-workflow-expanded <=> root.conversation-workflow-expanded;
                title-editing <=> root.title-editing;
                access-menu-open <=> root.access-menu-open;
                model-menu-open <=> root.model-menu-open;
                effort-menu-open <=> root.effort-menu-open;
                slash-menu-visible <=> root.slash-menu-visible;
                context-popover-open <=> root.context-popover-open;
                context-button-hover <=> root.context-button-hover;
                context-card-hover <=> root.context-card-hover;
                context-close-pending <=> root.context-close-pending;
                trace-filter-open <=> root.trace-filter-open;
                send-message(text) => { root.send-message(text); }
                rename-session(title) => { root.rename-session(title); }
                choose-attachment(dir) => { root.choose-attachment(dir) }
                refresh-trace => { root.refresh-trace(); }
                export-trace => { root.export-trace(); }
                drag-window => { root.drag-window(); }
                minimize-window => { root.minimize-window(); }
                toggle-maximize-window => { root.toggle-maximize-window(); }
                close-window => { root.close-window(); }
                set-code-panel-visible(visible) => { root.set-code-panel-visible(visible); }
                open-change-workspace => { root.open-change-workspace(); }
                switch-workspace(path) => { root.confirm-change-workspace(path); }
                select-project-file(index) => { root.select-project-file(index); }
                copy-text(value) => { root.copy-text(value); }
                refresh-workspace => { root.refresh-workspace(); }
                open-workspace-settings => {
                    root.settings-search = "";
                    root.settings-page = 3;
                    root.settings-open = true;
                }
                return-focus => { hs.focus(); }
            }
            CodePanelSlot {
                code-visible: root.code-visible;
                host-width: root.width;
                sidebar-visible: root.sidebar-visible;
                sidebar-width: root.sidebar-width;
                project-files: root.project-files;
                code-lines: root.code-lines;
                preview-lines: root.preview-lines;
                file-added-lines: root.file-added-lines;
                selected-file-name: root.selected-file-name;
                preview-content: root.preview-content;
                status-text: root.status-text;
                trace-result: root.trace-result;
                assistant-text: root.assistant-text;
                code-panel-width <=> root.code-panel-width;
                file-preview-selected <=> root.file-preview-selected;
                code-menu-open <=> root.code-menu-open;
                file-menu-open <=> root.file-menu-open;
                copy-notice-visible <=> root.copy-notice-visible;
                preview-search <=> root.preview-search;
                issues-open <=> root.issues-open;
                return-focus => { hs.focus(); }
                drag-window => { root.drag-window(); }
                minimize-window => { root.minimize-window(); }
                toggle-maximize-window => { root.toggle-maximize-window(); }
                close-window => { root.close-window(); }
                set-code-panel-visible(visible) => { root.set-code-panel-visible(visible); }
                select-project-file(index) => { root.select-project-file(index); }
                reconcile => { root.reconcile(); }
                copy-text(value) => { root.copy-text(value); }
                filter-preview(value) => { root.filter-preview(value); }
            }
        }
    }
    hs := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-session();
                accept
            } else if event.modifiers.control && event.text == "," {
                root.settings-searched("");
                root.settings-open = true;
                accept
            } else if event.modifiers.control && event.modifiers.shift && (event.text == "p" || event.text == "P") {
                root.composer-text = "/";
                root.slash-query-changed("/");
                accept
            } else if event.text == "\u{1b}" || event.text == "Escape" {
                if root.create-navigation-open {
                    root.create-navigation-open = false;
                    accept
                } else if root.change-workspace-open {
                    root.change-workspace-open = false;
                    accept
                } else if root.settings-open {
                    root.cancel-settings();
                    root.settings-open = false;
                    hs.focus();
                    accept
                } else if root.access-menu-open || root.model-menu-open || root.effort-menu-open || root.slash-menu-visible || root.trace-filter-open || root.code-menu-open || root.issues-open || root.file-menu-open || root.context-popover-open {
                    root.access-menu-open = false;
                    root.model-menu-open = false;
                    root.effort-menu-open = false;
                    root.slash-menu-visible = false;
                    root.trace-filter-open = false;
                    root.code-menu-open = false;
                    root.issues-open = false;
                    root.file-menu-open = false;
                    root.context-popover-open = false;
                    accept
                } else { reject }
            } else { reject }
        }
    }

    if root.create-navigation-open : CreateNavigationOverlay {
        workspace-presets: root.workspace-presets;
        group-options: root.group-options;
        create-navigation-kind <=> root.create-navigation-kind;
        create-navigation-name <=> root.create-navigation-name;
        create-navigation-workspace <=> root.create-navigation-workspace;
        create-navigation-group <=> root.create-navigation-group;
        create-navigation-error <=> root.create-navigation-error;
        create-navigation-open <=> root.create-navigation-open;
        create-navigation(kind, name, group, workspace) => {
            root.create-navigation(kind, name, group, workspace)
        }
        choose-attachment(dir) => { root.choose-attachment(dir) }
        identify-project(path) => { root.identify-project(path) }
        project-in-group(group, path) => { root.project-in-group(group, path) }
        return-focus => { hs.focus(); }
    }
    if root.change-workspace-open : ChangeWorkspaceOverlay {
        workspace-presets: root.workspace-presets;
        change-workspace-path <=> root.change-workspace-path;
        change-workspace-open <=> root.change-workspace-open;
        choose-attachment(dir) => { root.choose-attachment(dir) }
        confirm-change-workspace(path) => { root.confirm-change-workspace(path); }
        return-focus => { hs.focus(); }
    }
    if root.settings-open : SettingsOverlay {
        settings-search <=> root.settings-search;
        settings-page <=> root.settings-page;
        settings-open <=> root.settings-open;
        model-name <=> root.model-name;
        provider-kind <=> root.provider-kind;
        account-field <=> root.account-field;
        agent-options: root.agent-options;
        setting-accent <=> root.setting-accent;
        setting-autosave <=> root.setting-autosave;
        setting-channel <=> root.setting-channel;
        setting-cloud-sync <=> root.setting-cloud-sync;
        setting-command-approval <=> root.setting-command-approval;
        setting-dark-theme <=> root.setting-dark-theme;
        setting-density <=> root.setting-density;
        setting-desktop-notifications <=> root.setting-desktop-notifications;
        setting-email <=> root.setting-email;
        setting-file-access <=> root.setting-file-access;
        setting-font-scale <=> root.setting-font-scale;
        setting-git <=> root.setting-git;
        setting-high-risk <=> root.setting-high-risk;
        setting-index-mode <=> root.setting-index-mode;
        setting-language <=> root.setting-language;
        setting-main-model <=> root.setting-main-model;
        setting-message-alerts <=> root.setting-message-alerts;
        setting-network <=> root.setting-network;
        setting-nickname <=> root.setting-nickname;
        setting-notifications <=> root.setting-notifications;
        setting-provider <=> root.setting-provider;
        setting-provider-auth <=> root.setting-provider-auth;
        setting-provider-credential <=> root.setting-provider-credential;
        setting-provider-endpoint <=> root.setting-provider-endpoint;
        setting-provider-protocol <=> root.setting-provider-protocol;
        setting-provider-secret <=> root.setting-provider-secret;
        setting-provider-thinking <=> root.setting-provider-thinking;
        setting-quiet-hours <=> root.setting-quiet-hours;
        setting-reasoning <=> root.setting-reasoning;
        setting-startup <=> root.setting-startup;
        setting-workspace <=> root.setting-workspace;
        setting-workspace-sync <=> root.setting-workspace-sync;
        return-focus => { hs.focus(); }
        accent-hex(i) => { root.accent-hex(i) }
        accent-name(i) => { root.accent-name(i) }
        approval-selected => { root.approval-selected() }
        cancel-settings => { root.cancel-settings(); }
        choose-attachment(dir) => { root.choose-attachment(dir) }
        effort-selected => { root.effort-selected() }
        reset-settings => { root.reset-settings(); }
        save-settings => { root.save-settings(); }
        settings-searched(text) => { root.settings-searched(text); }
        startup-selected => { root.startup-selected() }
        store-provider-secret(provider, secret) => { root.store-provider-secret(provider, secret); }
        test-provider(provider) => { root.test-provider(provider); }
        setting-provider-at(i) => { root.setting-provider-at(i) }
        setting-model-at(i) => { root.setting-model-at(i) }
    }
}
