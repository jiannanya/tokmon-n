                                if root.request-tab == 1 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "权限模式"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.access-mode; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "推理力度"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.effort; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "会话模型"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.model-name; font-family: "Consolas"; font-size: 12px; color: Palette.body; overflow: elide; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "命令审批"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.setting-command-approval; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                                if root.request-tab == 2 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "Prompt"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-prompt-label; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Completion"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-completion-label; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Total"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-total-label; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                                if root.request-tab == 3 : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout { spacing: 8px; Text { text: "Duration"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-duration; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Turns"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-turns; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 8px; Text { text: "Calls"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-calls; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
}
}
}

            Rectangle {
                visible: root.code-visible;
                width: root.code-panel-width;
                background: Palette.white;
                VerticalLayout {
                    HorizontalLayout {
                        height: 42px;
                        padding-left: 16px;
                        padding-right: 8px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            Rectangle {
                                width: ct1.width + 4px;
                                horizontal-stretch: 0;
                                ct1 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "代码审阅";
                                    font-size: 12.5px;
                                    font-weight: root.file-preview-selected ? 500 : 700;
                                    color: root.file-preview-selected ? Palette.dim : Palette.accent-text;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.file-preview-selected ? transparent : Palette.accent;
                                }
                                TouchArea {
                                    clicked => { root.file-preview-selected = false; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                width: ct2.width + 4px;
                                horizontal-stretch: 0;
                                ct2 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "文件预览";
                                    font-size: 12.5px;
                                    font-weight: root.file-preview-selected ? 700 : 500;
                                    color: root.file-preview-selected ? Palette.accent-text : Palette.dim;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.file-preview-selected ? Palette.accent : transparent;
                                }
                                TouchArea {
                                    clicked => { root.file-preview-selected = true; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            ToolIcon {
                                source: Icons.dots;
                                icon-size: 14px;
                                clicked => { root.code-menu-open = !root.code-menu-open; }
                            }
                            ToolIcon {
                                source: Icons.close;
                                icon-size: 14px;
                                clicked => { root.code-visible = false; }
                            }
                        }
                    }
                    if !root.file-preview-selected : Rectangle {
                        height: 34px;
                        background: Palette.surface;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    height: 22px;
                                    border-radius: 6px;
                                    background: Palette.white;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        Image { source: Icons.file-code; width: 13px; height: 13px; y: (parent.height - 13px) / 2; }
                                        Text {
                                            text: root.selected-file-name == "" ? (root.project-files.length > 0 ? root.project-files[0].name : "会话文件") : root.selected-file-name;
                                            font-family: "Consolas";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: Palette.strong;
                                            vertical-alignment: center;
                                        }
                                        Image { source: Icons.chev-down-faint; width: 9px; height: 5px; y: (parent.height - 5px) / 2; }
                                    }
                                    TouchArea {
                                        clicked => { root.code-menu-open = false; root.file-menu-open = !root.file-menu-open }
                                        mouse-cursor: pointer;
                                    }
                                    if root.file-menu-open : Rectangle {
                                        x: 0px;
                                        y: parent.height + 6px;
                                        width: 220px;
                                        height: Math.min(root.project-files.length, 8) * 30px + 8px;
                                        background: Palette.white;
                                        border-radius: 12px;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        drop-shadow-color: rgba(0, 0, 0, 0.14);
                                        drop-shadow-offset-y: 5px;
                                        drop-shadow-blur: 14px;
                                        VerticalLayout {
                                            padding: 4px;
                                            if root.project-files.length == 0 : Text {
                                                text: "会话尚未产生文件投影";
                                                font-size: 11px;
                                                color: Palette.faint;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                height: 26px;
                                            }
                                            for file[fi] in root.project-files : MenuOption {
                                                label: file.name;
                                                active: file.name == root.selected-file-name;
                                                chosen => {
                                                    root.select-project-file(fi);
                                                    root.file-menu-open = false;
                                                    hs.focus();
                                                }
                                            }
                                        }
                                        TouchArea { clicked => { root.file-menu-open = false } }
                                    }
                                }
                                Rectangle {
                                    height: 20px;
                                    border-radius: 4px;
                                    background: #DCFCE7;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "+" + (root.file-added-lines == 0 ? root.code-lines.length : root.file-added-lines) + " -0";
                                            font-family: "Consolas";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #15803D;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                ToolIcon { source: Icons.download; icon-size: 13px; clicked => { root.reconcile() } }
                            }
                        }
                        Rectangle {
                            y: parent.height - 0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.sep;
                        }
                    }
                    if !root.file-preview-selected : ListView {
                        vertical-stretch: 1;
                        for line in root.code-lines : Rectangle {
                            height: 22px;
                            HorizontalLayout {
                                Text {
                                    width: 40px;
                                    horizontal-stretch: 0;
                                    text: line.number;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    color: Palette.faint;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: line.text == "" ? " " : line.text;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: line.tone == "comment" ? #99A1AF : #1E2939;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if root.file-preview-selected : Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "内容预览" + (root.selected-file-name == "" ? "" : " · " + root.selected-file-name);
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Palette.ink;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 24px;
                                    border-radius: 8px;
                                    background: Palette.sep;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        Image { source: Icons.doc; width: 11px; height: 11px; y: (parent.height - 11px) / 2; }
                                        Text { text: "复制内容"; font-size: 11px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                    }
                                    TouchArea {
                                        clicked => { root.copy-text(root.preview-content) }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 8px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                Image {
                                    source: Icons.search;
                                    x: 9px;
                                    y: (parent.height - 13px) / 2;
                                    width: 13px;
                                    height: 13px;
                                }
                                preview-q := TextInput {
                                    x: 29px;
                                    width: parent.width - 37px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: Palette.body;
                                    text <=> root.preview-search;
                                    edited => { root.filter-preview(self.text) }
                                    accepted => { root.filter-preview(self.text) }
                                }
                                if root.preview-search == "" : Text {
                                    x: 29px;
                                    height: parent.height;
                                    text: "在投影内容中搜索...";
                                    font-size: 12px;
                                    color: Palette.faint;
                                    vertical-alignment: center;
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 6px;
                                    for line in root.preview-lines : Rectangle {
                                        height: text-item.preferred-height + 16px;
                                        border-radius: 10px;
                                        background: Palette.surface;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: "#" + line.number;
                                                    font-family: "Consolas";
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                    color: Palette.amber;
                                                    vertical-alignment: center;
                                                }
                                                Text { horizontal-stretch: 1; }
                                            }
                                            text-item := Text {
                                                text: line.text == "" ? " " : line.text;
                                                font-size: 12.5px;
                                                color: Palette.ink;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                    if root.preview-lines.length == 0 : Text {
                                        text: "// 暂无可预览的投影内容。";
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        color: Palette.faint;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 30px;
                        background: Palette.surface;
                        Rectangle {
                            y: 0px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.border;
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 6px;
                                Image { source: Icons.check-circle-green; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                Text { text: root.status-text; font-size: 11.5px; font-weight: 500; color: Palette.green; vertical-alignment: center; overflow: elide; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;
                                Text { text: "UTF-8"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                Rectangle {
                                    height: 20px;
                                    border-radius: 6px;
                                    horizontal-stretch: 0;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        Image { source: Icons.dots; width: 12px; height: 12px; y: (parent.height - 12px) / 2; }
                                        Text { text: "问题"; font-size: 11.5px; color: Palette.mid; vertical-alignment: center; }
                                    }
                                    TouchArea {
                                        clicked => { root.issues-open = !root.issues-open; }
                                        mouse-cursor: pointer;
                                    }
                                    if root.issues-open : Rectangle {
                                        x: parent.width - 230px;
                                        y: -110px;
                                        width: 220px;
                                        background: Palette.white;
                                        border-radius: 12px;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        drop-shadow-color: rgba(0, 0, 0, 0.14);
                                        drop-shadow-blur: 14px;
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 6px;
                                            Text { text: "问题面板"; font-size: 12px; font-weight: 600; color: Palette.ink; }
                                            Text { text: root.trace-result == "执行失败" ? root.assistant-text : "当前投影没有发现问题。"; font-size: 11.5px; color: Palette.dim; wrap: word-wrap; overflow: elide; }
                                        }
                                        TouchArea { clicked => { root.issues-open = false } }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.code-menu-open : Rectangle {
                    x: parent.width - 170px;
                    y: 44px;
                    width: 160px;
                    background: Palette.white;
                    border-radius: 12px;
                    border-width: 0.67px;
                    border-color: Palette.border;
                    drop-shadow-color: rgba(0, 0, 0, 0.14);
                    drop-shadow-offset-y: 5px;
                    drop-shadow-blur: 14px;
                    VerticalLayout {
                        padding: 4px;
                        MenuOption {
                            label: "重新审阅";
                            active: false;
                            chosen => { root.reconcile(); root.code-menu-open = false; hs.focus(); }
                        }
                        MenuOption {
                            label: "关闭面板";
                            active: false;
                            chosen => { root.code-visible = false; root.code-menu-open = false; hs.focus(); }
                        }
                    }
                    TouchArea { clicked => { root.code-menu-open = false } }
                }
            }
        Rectangle {
            width: root.code-visible ? 6px : 0px;
            background: cpt.has-hover || cpt.pressed ? Palette.hairline : transparent;
            cpt := TouchArea {
                enabled: root.code-visible;
                moved => {
                    root.code-panel-width = Math.max(320px, Math.min(560px,
                        root.code-panel-width - (self.mouse-x - self.pressed-x)));
                }
                mouse-cursor: ew-resize;
            }
        }
        }
    }
    hs := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-session();
                accept
            } else if event.modifiers.control && event.text == "," {
                root.settings-searched("");
                root.settings-open = true;
                accept
            } else if event.modifiers.control && event.modifiers.shift && (event.text == "p" || event.text == "P") {
                root.composer-text = "/";
                root.slash-query-changed("/");
                accept
            } else if event.text == "\u{1b}" || event.text == "Escape" {
                if root.create-navigation-open {
                    root.create-navigation-open = false;
                    accept
                } else if root.change-workspace-open {
                    root.change-workspace-open = false;
                    accept
                } else if root.settings-open {
                    root.cancel-settings();
                    root.settings-open = false;
                    hs.focus();
                    accept
                } else if root.access-menu-open || root.model-menu-open || root.effort-menu-open || root.slash-menu-visible || root.trace-filter-open || root.code-menu-open || root.issues-open || root.file-menu-open || root.context-popover-open {
                    root.access-menu-open = false;
                    root.model-menu-open = false;
                    root.effort-menu-open = false;
                    root.slash-menu-visible = false;
                    root.trace-filter-open = false;
                    root.code-menu-open = false;
                    root.issues-open = false;
                    root.file-menu-open = false;
                    root.context-popover-open = false;
                    accept
                } else { reject }
            } else { reject }
        }
    }

    if root.create-navigation-open : Rectangle {
        background: rgba(0, 0, 0, 0.35);
        TouchArea {
            clicked => { root.create-navigation-open = false }
        }
        Rectangle {
            width: 520px;
            y: parent.height / 2 - self.preferred-height / 2 - 40px;
            x: parent.width / 2 - self.width / 2;
            border-radius: 16px;
            background: Palette.white;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.25);
            drop-shadow-offset-y: 20px;
            drop-shadow-blur: 50px;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 16px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 8px;
                                background: #FEF8F4;
                                border-width: 0.67px;
                                border-color: #F5D9C3;
                                Image {
                                    source: Icons.logo;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - 14px) / 2;
                                    y: (parent.height - 14px) / 2;
                                }
                            }
                            Text {
                                text: root.create-navigation-kind == "会话" ? "新建会话设置" : root.create-navigation-kind == "项目" ? "新建项目设置" : "新建分组";
                                font-size: 15px;
                                font-weight: 700;
                                color: Palette.ink;
                                vertical-alignment: center;
                            }
                        }
                        ToolIcon {
                            source: Icons.close;
                            icon-size: 16px;
                            clicked => { root.create-navigation-open = false; hs.focus(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    SegTrack {
                        options: ["分组", "项目", "会话"];
                        selected: root.create-navigation-kind == "分组" ? 0 : root.create-navigation-kind == "项目" ? 1 : 2;
                        picked(i, o) => { root.create-navigation-kind = o }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: root.create-navigation-kind == "会话" ? "会话名称" : root.create-navigation-kind == "项目" ? "项目名称" : "分组名称"; font-size: 12px; font-weight: 500; color: Palette.strong; }
                        LineEdit {
                            text <=> root.create-navigation-name;
                            placeholder-text: root.create-navigation-kind == "会话" ? "请输入会话名称..." : "请输入名称...";
                            font-size: 13px;
                        }
                    }
                    if root.create-navigation-kind != "分组" : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "所属分组"; font-size: 12px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                            Text { text: root.create-navigation-kind == "会话" ? "会话归类分组" : "项目归类分组"; font-size: 11px; color: Palette.faint; vertical-alignment: center; }
                        }
                        SelectBox {
                            width: root.width - 48px;
                            value: root.create-navigation-group == "" ? (root.group-options.length > 0 ? root.group-options[0] : "默认") : root.create-navigation-group;
                            options: root.group-options;
                            selected(i, o) => { root.create-navigation-group = o }
                        }
                    }
                    if root.create-navigation-kind != "分组" : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "项目工作目录（项目空间）"; font-size: 12px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                            Text { text: "目录末尾即项目名称"; font-size: 11px; color: Palette.faint; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                clip: true;
                                TextInput {
                                    x: 14px;
                                    width: parent.width - 22px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: Palette.ink;
                                    text <=> root.create-navigation-workspace;
                                }
                            }
                            Rectangle {
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.sep;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 5px;
                                    alignment: center;
                                    Image { source: Icons.folder; width: 13px; height: 13px; y: (parent.height - 13px) / 2; }
                                    Text { text: "浏览..."; font-size: 12px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.create-navigation-workspace = root.choose-attachment(true);
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                Text { text: "识别项目:"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                Rectangle {
                                    height: 19px;
                                    border-radius: 4px;
                                    background: Palette.sep;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.identify-project(root.create-navigation-workspace);
                                            font-family: "Consolas";
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            color: Palette.ink;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                if root.project-in-group(root.create-navigation-group, root.create-navigation-workspace) : HorizontalLayout {
                                    spacing: 4px;
                                    Image { source: Icons.check-green; width: 11px; height: 11px; y: 4px; }
                                    Text {
                                        text: "已归属于「" + root.create-navigation-group + "」下的已有项目";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Palette.green;
                                        vertical-alignment: center;
                                    }
                                }
                                if !root.project-in-group(root.create-navigation-group, root.create-navigation-workspace) : HorizontalLayout {
                                    spacing: 4px;
                                    Image { source: Icons.plus-dim; width: 11px; height: 11px; y: 4px; }
                                    Text {
                                        text: "将在「" + root.create-navigation-group + "」下自动新建该项目";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Palette.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            padding-top: 4px;
                            Text { text: "常用项目空间快捷选择:"; font-size: 11px; color: Palette.faint; }
                            HorizontalLayout {
                                spacing: 6px;
                                for preset in root.workspace-presets : Rectangle {
                                    height: 22px;
                                    border-radius: 8px;
                                    background: preset.path == root.create-navigation-workspace ? #FEF8F4 : Palette.surface;
                                    border-width: 0.67px;
                                    border-color: preset.path == root.create-navigation-workspace ? Palette.accent : Palette.border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: preset.name;
                                            font-family: "Consolas";
                                            font-size: 10.5px;
                                            font-weight: preset.path == root.create-navigation-workspace ? 600 : 400;
                                            color: preset.path == root.create-navigation-workspace ? Palette.accent : Palette.mid;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.create-navigation-workspace = preset.path;
                                            root.create-navigation-group = preset.group-title;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                    if root.create-navigation-error != "" : Text {
                        text: root.create-navigation-error;
                        font-size: 11.5px;
                        color: Palette.red;
                    }
                }
                Rectangle {
                    height: 60px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-right: 24px;
                        padding-left: 24px;
                        spacing: 12px;
                        alignment: end;
                        Rectangle {
                            width: 76px;
                            height: 36px;
                            border-radius: 12px;
                            background: transparent;
                            border-width: 0.67px;
                            border-color: Palette.border;
                            HorizontalLayout { alignment: center; Text { text: "取消"; font-size: 13px; font-weight: 500; color: Palette.mid; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { root.create-navigation-open = false; hs.focus(); }
                                mouse-cursor: pointer;
                            }
                        }
                        Rectangle {
                            width: 132px;
                            height: 36px;
                            border-radius: 12px;
                            background: Palette.accent;
                            HorizontalLayout { alignment: center; Text { text: root.create-navigation-kind == "会话" ? "创建并进入会话" : "创建"; font-size: 13px; font-weight: 600; color: white; vertical-alignment: center; } }
                            TouchArea {
                                clicked => {
                                    if root.create-navigation(root.create-navigation-kind, root.create-navigation-name,
                                            root.create-navigation-group, root.create-navigation-workspace) {
                                        root.create-navigation-open = false;
                                        hs.focus();
                                    }
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        y: 0px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
            }
        }
    }
    if root.change-workspace-open : Rectangle {
        background: rgba(0, 0, 0, 0.35);
        TouchArea {
            clicked => { root.change-workspace-open = false }
        }
        Rectangle {
            width: 480px;
            y: parent.height / 2 - self.preferred-height / 2 - 40px;
            x: parent.width / 2 - self.width / 2;
            border-radius: 16px;
            background: Palette.white;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.25);
            drop-shadow-offset-y: 20px;
            drop-shadow-blur: 50px;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 16px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Image { source: Icons.folder; width: 16px; height: 16px; y: (parent.height - 16px) / 2; }
                            Text { text: "更换当前会话工作空间目录"; font-size: 14.5px; font-weight: 700; color: Palette.ink; vertical-alignment: center; }
                        }
                        ToolIcon {
                            source: Icons.close;
                            icon-size: 16px;
                            clicked => { root.change-workspace-open = false; hs.focus(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "当前会话尚未开始，您可以自定义工作空间路径。会话开始执行后，工作空间目录将锁定。";
                        font-size: 12px;
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "工作空间物理路径"; font-size: 12px; font-weight: 500; color: Palette.strong; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                clip: true;
                                TextInput {
                                    x: 14px;
                                    width: parent.width - 22px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: Palette.ink;
                                    text <=> root.change-workspace-path;
                                }
                            }
                            Rectangle {
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.sep;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text { text: "浏览..."; font-size: 12px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => { root.change-workspace-path = root.choose-attachment(true); hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "常用项目空间:"; font-size: 11.5px; color: Palette.dim; }
                        for preset in root.workspace-presets : Rectangle {
                            height: 32px;
                            border-radius: 10px;
                            background: preset.path == root.change-workspace-path ? #FEF8F4 : Palette.surface;
                            border-width: 0.67px;
                            border-color: preset.path == root.change-workspace-path ? Palette.accent : Palette.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text { text: preset.name; font-size: 11.5px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                Text { text: preset.path; font-family: "Consolas"; font-size: 10px; color: Palette.dim; overflow: elide; vertical-alignment: center; }
                            }
                            TouchArea {
                                clicked => { root.change-workspace-path = preset.path }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-right: 24px;
                        padding-left: 24px;
                        spacing: 12px;
                        alignment: end;
                        Rectangle {
                            width: 76px;
                            height: 34px;
                            border-radius: 12px;
                            background: transparent;
                            border-width: 0.67px;
                            border-color: Palette.border;
                            HorizontalLayout { alignment: center; Text { text: "取消"; font-size: 12.5px; font-weight: 500; color: Palette.mid; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { root.change-workspace-open = false; hs.focus(); }
                                mouse-cursor: pointer;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 34px;
                            border-radius: 12px;
                            background: Palette.accent;
                            HorizontalLayout { alignment: center; Text { text: "确认更换"; font-size: 12.5px; font-weight: 600; color: white; vertical-alignment: center; } }
                            TouchArea {
                                clicked => {
                                    root.confirm-change-workspace(root.change-workspace-path);
                                    root.change-workspace-open = false;
                                    hs.focus();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        y: 0px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
            }
        }
    }
    if root.settings-open : Rectangle {
        background: rgba(0, 0, 0, 0.35);
        TouchArea {
            clicked => {
                root.cancel-settings();
                root.settings-open = false;
                hs.focus();
            }
        }
        Rectangle {
            width: Math.min(1120px, parent.width - 32px);
            height: Math.min(720px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: Palette.white;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.25);
            drop-shadow-offset-y: 20px;
            drop-shadow-blur: 50px;
            clip: true;
            TouchArea { clicked => { hs.focus() } }
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 28px;
                        padding-right: 16px;
                        alignment: space-between;
                        Text { text: "设置"; font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: Palette.ink; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Rectangle {
                                width: 360px;
                                horizontal-stretch: 0;
                                height: 33px;
                                border-radius: 12px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                Image {
                                    source: Icons.search;
                                    x: 14px;
                                    y: (parent.height - 16px) / 2;
                                    width: 16px;
                                    height: 16px;
                                }
                                TextInput {
                                    x: 36px;
                                    width: parent.width - 44px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    color: Palette.body;
                                    text <=> root.settings-search;
                                    edited => { root.settings-searched(self.text) }
                                    accepted => { root.settings-searched(self.text) }
                                }
                                if root.settings-search == "" : Text {
                                    x: 36px;
                                    height: parent.height;
                                    text: "搜索设置项";
                                    font-size: 13px;
                                    color: Palette.faint;
                                    vertical-alignment: center;
                                }
                            }
                            ToolIcon {
                                source: Icons.close;
                                icon-size: 20px;
                                clicked => {
                                    root.cancel-settings();
                                    root.settings-open = false;
                                    hs.focus();
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    Rectangle {
                        width: 220px;
                        horizontal-stretch: 0;
                        background: Palette.rail;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            for nav-item[ni] in ["通用", "智能体与模型", "权限与安全", "工作区", "通知", "外观", "快捷键", "账户"] : Rectangle {
                                height: 40px;
                                border-radius: 12px;
                                background: root.settings-page == ni ? Palette.accent-bg : (nta.has-hover ? rgba(0, 0, 0, 0.03) : transparent);
                                drop-shadow-color: root.settings-page == ni ? Palette.shadow : transparent;
                                drop-shadow-offset-y: 1px;
                                drop-shadow-blur: 0px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: start;
                                    Image {
                                        source: ni == 0 ? Icons.gear : ni == 1 ? Icons.bot : ni == 2 ? Icons.shield : ni == 3 ? Icons.folder : ni == 4 ? Icons.bell : ni == 5 ? Icons.contrast : ni == 6 ? Icons.keyboard : Icons.person-amber;
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - 16px) / 2;
                                    }
                                    Text {
                                        text: nav-item;
                                        font-size: 13.5px;
                                        font-weight: root.settings-page == ni ? 600 : 500;
                                        color: root.settings-page == ni ? Palette.accent-text : Palette.mid;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                nta := TouchArea {
                                    clicked => {
                                        root.settings-page = ni;
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                if root.settings-page == 0 : VerticalLayout {
                                    RowShell {
                                        label: "应用语言";
                                        SelectBox {
                                            value: root.setting-language;
                                            options: ["简体中文", "English"];
                                            selected(i, o) => { root.setting-language = o }
                                        }
                                    }
                                    RowShell {
                                        label: "启动时打开";
                                        SegTrack {
                                            options: ["首页", "上次打开的会话"];
                                            selected: root.startup-selected();
                                            picked(i, o) => { root.setting-startup = o }
                                        }
                                    }
                                    RowShell {
                                        label: "自动保存";
                                        SelectBox {
                                            value: root.setting-autosave;
                                            options: ["关闭", "1 分钟", "5 分钟", "15 分钟"];
                                            selected(i, o) => { root.setting-autosave = o }
                                        }
                                    }
                                    RowShell {
                                        label: "更新通道";
                                        separated: false;
                                        SegTrack {
                                            warm: true;
                                            options: ["稳定版", "测试版"];
                                            selected: root.setting-channel == "稳定版" ? 0 : 1;
                                            picked(i, o) => { root.setting-channel = o }
                                        }
                                    }
                                }
                                if root.settings-page == 1 : VerticalLayout {
                                    RowShell {
                                        label: "默认智能体";
                                        SelectBox {
                                            value: root.setting-provider == "" ? "选择智能体档案" : root.setting-provider;
                                            options: root.agent-options;
                                            drop-up: false;
                                            selected(i, o) => {
                                                root.setting-provider = root.setting-provider-at(i);
                                                root.setting-main-model = root.setting-model-at(i);
                                                root.model-name = root.setting-model-at(i);
                                            }
                                        }
                                    }
                                    RowShell {
                                        label: "模型提供方";
                                        SegTrack {
                                            options: ["Tokmon 官方", "自定义"];
                                            selected: root.provider-kind == "自定义" ? 1 : 0;
                                            picked(i, o) => { root.provider-kind = o }
                                        }
                                    }
                                    if root.provider-kind == "自定义" : VerticalLayout {
                                        RowShell {
                                            label: "协议";
                                            SelectBox {
                                                value: root.setting-provider-protocol;
                                                options: ["openai-compatible", "anthropic", "responses"];
                                                selected(i, o) => { root.setting-provider-protocol = o }
                                            }
                                        }
                                        RowShell {
                                            label: "服务端点";
                                            LineEdit {
                                                width: 280px;
                                                text <=> root.setting-provider-endpoint;
                                                font-size: 12.5px;
                                            }
                                        }
                                        RowShell {
                                            label: "鉴权方式";
                                            SelectBox {
                                                value: root.setting-provider-auth;
                                                options: ["bearer", "api-key", "none"];
                                                selected(i, o) => { root.setting-provider-auth = o }
                                            }
                                        }
                                    }
                                    RowShell {
                                        label: "主模型";
                                        SelectBox {
                                            value: root.setting-main-model == "" ? "选择模型" : root.setting-main-model;
                                            options: root.agent-options;
                                            box-width: 237px;
                                            mono: true;
                                            selected(i, o) => {
                                                root.setting-main-model = root.setting-model-at(i);
                                                root.model-name = root.setting-model-at(i);
                                            }
                                        }
                                    }
                                    if root.provider-kind == "自定义" : RowShell {
                                        label: "API Key";
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                width: 200px;
                                                text <=> root.setting-provider-secret;
                                                placeholder-text: root.setting-provider-credential;
                                                font-size: 12px;
                                            }
                                            Rectangle {
                                                height: 30px;
                                                border-radius: 10px;
                                                background: Palette.accent-bg;
                                                border-width: 0.67px;
                                                border-color: Palette.accent-border;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    Text { text: "保存密钥"; font-size: 11.5px; font-weight: 500; color: Palette.accent-text; vertical-alignment: center; }
                                                }
                                                TouchArea {
                                                    clicked => { root.store-provider-secret(root.setting-provider, root.setting-provider-secret) }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                    RowShell {
                                        label: "推理强度";
                                        SegTrack {
                                            warm: true;
                                            options: ["低", "标准", "高", "最高"];
                                            selected: root.effort-selected();
                                            picked(i, o) => { root.setting-reasoning = o }
                                        }
                                    }
                                    RowShell {
                                        label: "思考模式";
                                        separated: false;
                                        ToggleSwitch {
                                            checked <=> root.setting-provider-thinking;
                                            toggled(v) => { root.setting-provider-thinking = v }
                                        }
                                    }
                                    RowShell {
                                        label: "连接测试";
                                        separated: false;
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 10px;
                                            background: Palette.sep;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Text { text: "测试当前提供商"; font-size: 11.5px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                            }
                                            TouchArea {
                                                clicked => { root.test-provider(root.setting-provider) }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }
                                if root.settings-page == 2 : VerticalLayout {
                                    RowShell {
                                        label: "文件访问";
                                        SelectBox {
                                            value: root.setting-file-access;
                                            options: ["受信路径", "仅工作区", "全部"];
                                            selected(i, o) => { root.setting-file-access = o }
                                        }
                                    }
                                    RowShell {
                                        label: "命令审批";
                                        SegTrack {
                                            warm: true;
                                            options: ["自动执行", "按需确认", "禁止执行"];
                                            selected: root.approval-selected();
                                            picked(i, o) => { root.setting-command-approval = o }
                                        }
                                    }
                                    RowShell {
                                        label: "网络访问";
                                        ToggleSwitch {
                                            checked <=> root.setting-network;
                                            toggled(v) => { root.setting-network = v }
                                        }
                                    }
                                    RowShell {
                                        label: "高风险二次确认";
                                        separated: false;
                                        ToggleSwitch {
                                            checked <=> root.setting-high-risk;
                                            toggled(v) => { root.setting-high-risk = v }
                                        }
                                    }
                                }
                                if root.settings-page == 3 : VerticalLayout {
                                    RowShell {
                                        label: "默认工作区";
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Rectangle {
                                                width: 280px;
                                                height: 32px;
                                                border-radius: 12px;
                                                background: Palette.surface;
                                                border-width: 0.67px;
                                                border-color: Palette.border;
                                                clip: true;
                                                TextInput {
                                                    x: 12px;
                                                    width: parent.width - 40px;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    font-family: "Consolas";
                                                    font-size: 12.5px;
                                                    color: Palette.ink;
                                                    text <=> root.setting-workspace;
                                                }
                                                Image {
                                                    source: Icons.folder;
                                                    x: parent.width - 26px;
                                                    y: (parent.height - 16px) / 2;
                                                    width: 16px;
                                                    height: 16px;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        root.setting-workspace = root.choose-attachment(true);
                                                        hs.focus();
                                                    }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                    RowShell {
                                        label: "索引模式";
                                        SelectBox {
                                            value: root.setting-index-mode;
                                            options: ["标准", "智能索引", "深度索引"];
                                            selected(i, o) => { root.setting-index-mode = o }
                                        }
                                    }
                                    RowShell {
                                        label: "自动同步";
                                        ToggleSwitch {
                                            checked <=> root.setting-workspace-sync;
                                            toggled(v) => { root.setting-workspace-sync = v }
                                        }
                                    }
                                    RowShell {
                                        label: "Git 集成";
                                        separated: false;
                                        ToggleSwitch {
                                            checked <=> root.setting-git;
                                            toggled(v) => { root.setting-git = v }
                                        }
                                    }
                                }
                                if root.settings-page == 4 : VerticalLayout {
                                    RowShell {
                                        label: "启用通知";
                                        ToggleSwitch {
                                            checked <=> root.setting-notifications;
                                            toggled(v) => { root.setting-notifications = v }
                                        }
                                    }
                                    RowShell {
                                        label: "桌面通知";
                                        ToggleSwitch {
                                            checked <=> root.setting-desktop-notifications;
                                            toggled(v) => { root.setting-desktop-notifications = v }
                                        }
                                    }
                                    RowShell {
                                        label: "消息提醒";
                                        ToggleSwitch {
                                            checked <=> root.setting-message-alerts;
                                            toggled(v) => { root.setting-message-alerts = v }
                                        }
                                    }
                                    RowShell {
                                        label: "免打扰";
                                        separated: false;
                                        SelectBox {
                                            value: root.setting-quiet-hours;
                                            options: ["关闭", "22:00 - 08:00", "23:00 - 07:00"];
                                            mono: true;
                                            drop-up: true;
                                            box-width: 147px;
                                            selected(i, o) => { root.setting-quiet-hours = o }
                                        }
                                    }
                                }
                                if root.settings-page == 5 : VerticalLayout {
                                    RowShell {
                                        label: "主题模式";
                                        SegTrack {
                                            warm: true;
                                            options: ["浅色", "深色"];
                                            selected: root.setting-dark-theme ? 1 : 0;
                                            picked(i, o) => { root.setting-dark-theme = o == "深色" }
                                        }
                                    }
                                    RowShell {
                                        label: "强调色";
                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: start;
                                            for swatch[si] in [0, 1, 2, 3, 4, 5] : SwatchDot {
                                                fill: root.accent-hex(si);
                                                active: root.setting-accent == si;
                                                picked => { root.setting-accent = si }
                                            }
                                        }
                                    }
                                    RowShell {
                                        label: "界面密度";
                                        SegTrack {
                                            warm: true;
                                            options: ["紧凑", "舒适", "宽松"];
                                            selected: root.setting-density == "紧凑" ? 0 : root.setting-density == "宽松" ? 2 : 1;
                                            picked(i, o) => { root.setting-density = o }
                                        }
                                    }
                                    RowShell {
                                        label: "字体大小";
                                        separated: false;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Slider {
                                                width: 196px;
                                                minimum: 80;
                                                maximum: 140;
                                                value: root.setting-font-scale;
                                                released(v) => {
                                                    root.setting-font-scale = Math.round(v / 5) * 5;
                                                    hs.focus();
                                                }
                                            }
                                            Text {
                                                text: root.setting-font-scale + "%";
                                                font-family: "Consolas";
                                                font-size: 12px;
                                                color: Palette.dim;
                                                vertical-alignment: center;
                                                width: 44px;
                                                horizontal-stretch: 0;
                                            }
                                        }
                                    }
                                }
                                if root.settings-page == 6 : VerticalLayout {
                                    spacing: 14px;
                                    property <[string]> actions: ["新建会话", "打开设置", "发送消息", "命令面板"];
                                    for action[ai] in self.actions : Rectangle {
                                        height: 54px;
                                        border-radius: 12px;
                                        background: Palette.surface;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            alignment: space-between;
                                            Text { text: action; font-size: 13px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: end;
                                                if ai == 0 : HorizontalLayout {
                                                    spacing: 4px;
                                                    KeyCap { label: "Ctrl"; }
                                                    Text { text: "+"; font-family: "Consolas"; font-size: 12px; color: Palette.faint; vertical-alignment: center; }
                                                    KeyCap { label: "N"; }
                                                }
                                                if ai == 1 : HorizontalLayout {
                                                    spacing: 4px;
                                                    KeyCap { label: "Ctrl"; }
                                                    Text { text: "+"; font-family: "Consolas"; font-size: 12px; color: Palette.faint; vertical-alignment: center; }
                                                    KeyCap { label: ","; }
                                                }
                                                if ai == 2 : KeyCap { label: "Enter"; }
                                                if ai == 3 : HorizontalLayout {
                                                    spacing: 4px;
                                                    KeyCap { label: "Ctrl"; }
                                                    Text { text: "+"; font-family: "Consolas"; font-size: 12px; color: Palette.faint; vertical-alignment: center; }
                                                    KeyCap { label: "Shift"; }
                                                    Text { text: "+"; font-family: "Consolas"; font-size: 12px; color: Palette.faint; vertical-alignment: center; }
                                                    KeyCap { label: "P"; }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: "快捷键立即生效：命令面板会聚焦输入框并列出 /lens、/lenses 等透镜指令。";
                                        font-size: 11.5px;
                                        color: Palette.dim;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.settings-page == 7 : VerticalLayout {
                                    spacing: 0px;
                                    HorizontalLayout {
                                        alignment: center;
                                        padding-top: 8px; padding-bottom: 8px; padding-left: 0px; padding-right: 0px;
                                        Rectangle {
                                            width: 64px;
                                            height: 64px;
                                            border-radius: 999px;
                                            background: #FEF08A;
                                            border-width: 2px;
                                            border-color: #FDE68A;
                                            Image {
                                                source: Icons.avatar-person;
                                                width: 32px;
                                                height: 32px;
                                                x: (parent.width - 32px) / 2;
                                                y: (parent.height - 32px) / 2;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        padding-top: 16px;
                                        spacing: 8px;
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 12px;
                                            background: Palette.surface;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: space-between;
                                                Text { text: "昵称"; font-size: 13px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    if root.account-field != 0 : Text { text: root.setting-nickname; font-size: 13px; color: Palette.mid; vertical-alignment: center; }
                                                    if root.account-field == 0 : LineEdit {
                                                        width: 200px;
                                                        text <=> root.setting-nickname;
                                                        font-size: 12.5px;
                                                        accepted => { root.account-field = -1 }
                                                    }
                                                    if root.account-field != 0 : Image { source: Icons.chev-right-faint; width: 16px; height: 16px; y: (parent.height - 16px) / 2; }
                                                    TouchArea {
                                                        clicked => { root.account-field = 0 }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 12px;
                                            background: Palette.surface;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: space-between;
                                                Text { text: "登录邮箱"; font-size: 13px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    if root.account-field != 1 : Text { text: root.setting-email == "" ? "未绑定邮箱" : root.setting-email; font-size: 13px; color: Palette.mid; vertical-alignment: center; }
                                                    if root.account-field == 1 : LineEdit {
                                                        width: 220px;
                                                        text <=> root.setting-email;
                                                        font-size: 12.5px;
                                                        accepted => { root.account-field = -1 }
                                                    }
                                                    if root.account-field != 1 : Image { source: Icons.chev-right-faint; width: 16px; height: 16px; y: (parent.height - 16px) / 2; }
                                                    TouchArea {
                                                        clicked => { root.account-field = 1 }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 12px;
                                            background: Palette.surface;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: space-between;
                                                Text { text: "当前方案"; font-size: 13px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text { text: "Pro"; font-size: 13px; font-weight: 600; color: Palette.amber; vertical-alignment: center; }
                                                    Image { source: Icons.chev-right-faint; width: 16px; height: 16px; y: (parent.height - 16px) / 2; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 12px;
                                            background: Palette.surface;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: space-between;
                                                Text { text: "云同步"; font-size: 13px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                ToggleSwitch {
                                                    checked <=> root.setting-cloud-sync;
                                                    toggled(v) => { root.setting-cloud-sync = v }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 230px;
                        horizontal-stretch: 0;
                        background: Palette.rail-warm;
                        VerticalLayout {
                            padding: 20px;
                            Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    Text {
                                        text: root.settings-page == 0 ? "通用概览" : root.settings-page == 1 ? "模型概览" : root.settings-page == 2 ? "安全概览" : root.settings-page == 3 ? "工作区概览" : root.settings-page == 4 ? "通知概览" : root.settings-page == 5 ? "外观概览" : root.settings-page == 6 ? "快捷键概览" : "账户概览";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: Palette.ink;
                                    }
                                    Rectangle {
                                        height: 0.67px;
                                        width: parent.width;
                                        background: #F3F1E9;
                                    }
                                    VerticalLayout {
                                        padding-top: 12px;
                                        spacing: 8px;
                                        if root.settings-page == 0 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "语言:"; val: root.setting-language; }
                                            OverviewLine { key: "启动:"; val: root.setting-startup; }
                                            OverviewLine { key: "更新通道:"; val: root.setting-channel; }
                                        }
                                        if root.settings-page == 1 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "默认智能体:"; val: root.setting-provider; }
                                            OverviewLine { key: "模型提供方:"; val: root.provider-kind == "自定义" ? "自定义" : "Tokmon 官方"; }
                                            OverviewLine { key: "主模型:"; val: root.setting-main-model; mono-value: true; }
                                        }
                                        if root.settings-page == 2 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "文件访问:"; val: root.setting-file-access; }
                                            OverviewLine { key: "命令审批:"; val: root.setting-command-approval; }
                                            OverviewLine { key: "确认状态:"; val: root.setting-high-risk ? "已开启二次确认" : "已关闭二次确认"; value-color: root.setting-high-risk ? #16A34A : #DC2626; }
                                        }
                                        if root.settings-page == 3 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "路径:"; val: root.setting-workspace; mono-value: true; }
                                            OverviewLine { key: "索引模式:"; val: root.setting-index-mode; }
                                            OverviewLine { key: "自动同步:"; val: root.setting-workspace-sync ? "已开启" : "已关闭"; }
                                        }
                                        if root.settings-page == 4 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "通知状态:"; val: root.setting-notifications ? "已启用" : "已禁用"; value-color: root.setting-notifications ? #16A34A : #DC2626; }
                                            OverviewLine { key: "桌面通知:"; val: root.setting-desktop-notifications ? "已启用" : "已禁用"; }
                                            OverviewLine { key: "免打扰时间:"; val: root.setting-quiet-hours; mono-value: true; }
                                        }
                                        if root.settings-page == 5 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "主题:"; val: root.setting-dark-theme ? "深色" : "浅色"; }
                                            OverviewLine { key: "强调色:"; val: root.accent-name(root.setting-accent); }
                                            OverviewLine { key: "密度:"; val: root.setting-density; }
                                        }
                                        if root.settings-page == 6 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "预设方案:"; val: "Tokmon 默认"; }
                                            OverviewLine { key: "已修改:"; val: "0 项"; }
                                            OverviewLine { key: "冲突状态:"; val: "无冲突"; value-color: #16A34A; }
                                        }
                                        if root.settings-page == 7 : VerticalLayout {
                                            spacing: 8px;
                                            OverviewLine { key: "昵称:"; val: root.setting-nickname; }
                                            OverviewLine { key: "方案:"; val: "Pro"; value-color: Palette.amber; }
                                            OverviewLine { key: "云同步:"; val: root.setting-cloud-sync ? "● 已开启" : "● 已关闭"; value-color: root.setting-cloud-sync ? #16A34A : #DC2626; }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 30px;
                                border-radius: 12px;
                                background: Palette.white;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "恢复默认设置"; font-size: 11.5px; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.reset-settings();
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;
                        alignment: space-between;
                        Text {
                            text: root.settings-status;
                            font-size: 11.5px;
                            color: Palette.faint;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;
                            Rectangle {
                                width: 76px;
                                height: 36px;
                                border-radius: 12px;
                                background: Palette.sep;
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "取消"; font-size: 13px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.cancel-settings();
                                        root.settings-open = false;
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                width: 96px;
                                height: 36px;
                                border-radius: 12px;
                                background: Palette.accent-bg;
                                border-width: 0.67px;
                                border-color: Palette.accent-border;
                                drop-shadow-color: Palette.shadow;
                                drop-shadow-offset-y: 1px;
                                drop-shadow-blur: 0px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "保存更改"; font-size: 13px; font-weight: 600; color: Palette.accent-text; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.save-settings();
                                        root.settings-open = false;
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: 0px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
            }
        }
    }
}
