                                                            Text { text: "对话轮次"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-turns + " 轮 · 模型调用 " + root.trace-calls + " 次"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "当前模型"; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
