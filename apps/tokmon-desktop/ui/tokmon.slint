                                                            Text { text: "输出 Completion"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-output-tokens + " (" + (100 - root.prompt-share()) + "%)"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
