import { LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";

export struct NavigationItem {
    id: string,
    ray: string,
    workspace: string,
    kind: string,
    title: string,
    icon: image,
    indent: int,
    selected: bool,
    expandable: bool,
    expanded: bool,
}

export struct ModelChoice {
    provider: string,
    model: string,
    label: string,
}

export struct TimelineItem {
    time: string,
    kind: string,
    title: string,
    detail: string,
    tone: string,
    progress: int,
}

export struct CodeLine {
    number: int,
    text: string,
    tone: string,
}

export struct SlashCommandItem {
    command: string,
    usage: string,
    summary: string,
    category: string,
}

export struct ProjectFile {
    name: string,
    path: string,
    group-title: string,
}

export struct GanttSegment {
    row: int,
    start: float,
    span: float,
    tint: color,
}

export struct TraceEvent {
    num: int,
    time: string,
    tone: string,
    role: string,
    title: string,
    detail: string,
    dur: string,
    tokens: string,
}

export global Palette {
    out property<color> app-bg: #F5F5F4;
    out property<color> surface: #FAFAF9;
    out property<color> surface-2: #FAF9F6;
    out property<color> white: #FFFFFF;
    out property<color> border: #E7E5E4;
    out property<color> hairline: #F0EEE8;
    out property<color> sep: #F5F5F4;
    out property<color> rail: #FBFBF9;
    out property<color> rail-warm: #FDFBF7;
    out property<color> input: #F9F9F8;
    out property<color> input-deep: #F0EEE8;
    out property<color> tabbar: #FAF9F6;
    out property<color> tab-line: #E8E6DF;
    out property<color> ink: #1C1917;
    out property<color> body: #292524;
    out property<color> strong: #44403C;
    out property<color> mid: #57534E;
    out property<color> dim: #78716C;
    out property<color> faint: #A8A29E;
    out property<color> accent: #C86A28;
    out property<color> accent-text: #8B5229;
    out property<color> accent-bg: #F7EFE5;
    out property<color> accent-border: #EBDCD0;
    out property<color> chip: #FEF3D6;
    out property<color> chip-line: #FDE68A;
    out property<color> chip-ink: #855702;
    out property<color> amber: #D97706;
    out property<color> green: #16A34A;
    out property<color> green-ink: #166534;
    out property<color> green-sub: #15803D;
    out property<color> green-bg: #F0FDF4;
    out property<color> green-line: #BBF7D0;
    out property<color> red: #EF4444;
    out property<color> bubble: #FCF8F3;
    out property<color> params: rgba(247, 239, 229, 0.6);
    out property<color> blue: #0284C7;
    out property<color> bar-gray: #6B7280;
    out property<color> shadow: rgba(0, 0, 0, 0.05);
}

