component ToolIcon inherits Rectangle {
    in property <image> source;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    callback clicked;
    background: ta.has-hover ? Palette.sep : transparent;
    border-radius: 8px;
    min-width: self.icon-size + 12px;
    min-height: self.icon-size + 12px;
    ta := TouchArea {
        enabled: parent.enabled;
        clicked => { parent.clicked() }
        mouse-cursor: pointer;
    }
    Image {
        source: parent.source;
        width: parent.icon-size;
        height: parent.icon-size;
        x: (parent.width - parent.icon-size) / 2;
        y: (parent.height - parent.icon-size) / 2;
    }
}

component StatusDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: self.tone == "success" ? #16A34A
        : self.tone == "warning" ? #D97706
        : self.tone == "danger" ? #EF4444 : #A8A29E;
}

component MenuOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? Palette.sep : (active ? Palette.accent-bg : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: 12.5px;
            color: root.active ? Palette.accent-text : Palette.body;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { parent.chosen() }
        mouse-cursor: pointer;
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 999px;
    background: self.checked ? Palette.accent : #E7E5E4;
    animate background { duration: 120ms; }
    Rectangle {
        x: parent.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: white;
        drop-shadow-color: rgba(0, 0, 0, 0.18);
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 5px;
        animate x { duration: 120ms; }
    }
    TouchArea {
        clicked => { root.toggled(!root.checked) }
        mouse-cursor: pointer;
    }
}

component SegTrack inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> warm: false;
    callback picked(int, string);
    background: Palette.sep;
    border-radius: 12px;
    border-width: 0.67px;
    border-color: Palette.border;
    height: 35px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding: 4px;
        spacing: 0px;
        for option[index] in root.options : Rectangle {
            background: index == root.selected ? (root.warm ? Palette.chip : Palette.accent-bg) : transparent;
            border-radius: 8px;
            drop-shadow-color: index == root.selected ? Palette.shadow : transparent;
            drop-shadow-offset-y: 1px;
            drop-shadow-blur: 0px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: option;
                    font-size: 12.5px;
                    font-weight: index == root.selected ? 600 : 500;
                    color: index == root.selected ? (root.warm ? Palette.chip-ink : Palette.accent-text) : Palette.dim;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => { root.picked(index, option) }
                mouse-cursor: pointer;
            }
        }
    }
}

component SelectBox inherits Rectangle {
    in property <string> value;
    in property <[string]> options;
    in property <bool> drop-up: false;
    in property <bool> mono: false;
    in property <length> box-width: 132px;
    callback selected(int, string);
    property <bool> open: false;
    width: self.box-width;
    height: 31.33px;
    border-radius: 12px;
    background: Palette.surface;
    border-width: 0.67px;
    border-color: Palette.border;
    Text {
        x: 14px;
        width: parent.width - 46px;
        text: parent.value;
        font-family: parent.mono ? "Consolas" : "Microsoft YaHei UI";
        font-size: 13px;
        color: Palette.ink;
        overflow: elide;
        vertical-alignment: center;
    }
    Image {
        source: Icons.chev-down-faint;
        width: 10px;
        height: 6px;
        x: parent.width - 22px;
        y: (parent.height - 6px) / 2;
    }
    TouchArea {
        clicked => { parent.open = !parent.open }
        mouse-cursor: pointer;
    }
    if self.open : Rectangle {
        x: 0px;
        y: parent.drop-up ? -self.height - 6px : parent.height + 6px;
        width: Math.max(parent.width, 190px);
        height: Math.min(root.options.length, 6) * 32px + 8px;
        background: Palette.white;
        border-radius: 12px;
        border-width: 0.67px;
        border-color: Palette.border;
        drop-shadow-color: rgba(0, 0, 0, 0.14);
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 16px;
        VerticalLayout {
            padding: 4px;
            for option[index] in root.options : MenuOption {
                label: option;
                active: option == root.value;
                chosen => {
                    root.selected(index, option);
                    root.open = false;
                }
            }
        }
        TouchArea { clicked => { root.open = false } }
    }
}

component RowShell inherits Rectangle {
    in property <string> label;
    in property <bool> separated: true;
    min-height: 47px;
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 16px;
        alignment: space-between;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 500;
            color: Palette.ink;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            @children
        }
    }
    if self.separated : Rectangle {
        y: parent.height - 0.67px;
        height: 0.67px;
        width: parent.width;
        background: Palette.sep;
    }
}

component OverviewLine inherits Rectangle {
    in property <string> key;
    in property <string> val;
    in property <color> value-color: Palette.ink;
    in property <bool> mono-value: false;
    height: 46px;
    VerticalLayout {
        Text {
            text: root.key;
            font-size: 12.5px;
            color: Palette.faint;
        }
        Text {
            text: root.val;
            font-family: root.mono-value ? "Consolas" : "Microsoft YaHei UI";
            font-size: root.mono-value ? 11px : 12.5px;
            font-weight: 700;
            color: root.value-color;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component KeyCap inherits Rectangle {
    in property <string> label;
    background: Palette.white;
    border-radius: 8px;
    border-width: 0.67px;
    border-color: Palette.border;
    drop-shadow-color: Palette.shadow;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 0px;
    min-width: 26px;
    height: 26px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            font-family: "Consolas";
            font-size: 12px;
            color: Palette.strong;
            vertical-alignment: center;
        }
    }
}

component SwatchDot inherits Rectangle {
    in property <color> fill;
    in property <bool> active;
    callback picked;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: self.fill;
    if root.active : Rectangle {
        x: -4px;
        y: -4px;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        border-width: 3px;
        border-color: root.fill;
        background: transparent;
    }
    TouchArea {
        clicked => { parent.picked() }
        mouse-cursor: pointer;
    }
}

component PillBadge inherits Rectangle {
    in property <string> label;
    in property <string> tone;
    height: 16px;
    border-radius: 4px;
    background: self.tone == "USER" ? #E0F2FE
        : self.tone == "CONTEXT" ? #DCFCE7
        : self.tone == "ASSISTANT" ? #F3E8FF
        : self.tone == "TOOL" ? #FEF3D6
        : self.tone == "ERROR" ? #FEE2E2 : #ECFDF5;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-family: "Consolas";
            font-weight: 700;
            font-size: 10.5px;
            color: root.tone == "USER" ? #0284C7
                : root.tone == "CONTEXT" ? #16A34A
                : root.tone == "ASSISTANT" ? #9333EA
                : root.tone == "TOOL" ? #B45309
                : root.tone == "ERROR" ? #DC2626 : #059669;
            vertical-alignment: center;
        }
    }
}

component StepDot inherits Rectangle {
    in property <string> tone;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: self.tone == "success" ? rgba(34, 197, 94, 0.2)
        : self.tone == "warning" ? #FEF3D6
        : self.tone == "danger" ? rgba(239, 68, 68, 0.15)
        : self.tone == "running" ? transparent : Palette.accent-bg;
    border-width: 0.67px;
    border-color: self.tone == "success" ? #22C55E
        : self.tone == "warning" ? #F59E0B
        : self.tone == "danger" ? #EF4444
        : self.tone == "running" ? #A8A29E : Palette.accent-border;
    if self.tone == "success" : Image {
        source: Icons.check-small;
        width: 10px;
        height: 10px;
        x: 2px;
        y: 2px;
    }
    if self.tone == "warning" || self.tone == "danger" : Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: root.tone == "warning" ? #D97706 : #EF4444;
        x: 4px;
        y: 4px;
    }
    if self.tone == "running" : Image {
        source: Icons.spinner;
        width: 10px;
        height: 10px;
        x: 2px;
        y: 2px;
    }
    if self.tone != "success" && self.tone != "warning" && self.tone != "danger" && self.tone != "running" : Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: Palette.accent;
        x: 4px;
        y: 4px;
    }
}

component SidebarRow inherits Rectangle {
    in property <NavigationItem> item;
    in property <int> row-index;
    callback selected;
    callback quick-create;
    height: 30px;
    border-radius: 6px;
    background: root.item.selected ? Palette.accent-bg : (ta.has-hover ? rgba(0, 0, 0, 0.03) : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 12px;
            horizontal-stretch: 0;
            visible: root.item.expandable;
            Image {
                source: root.item.expanded ? Icons.chev-down-faint : Icons.chev-right-faint;
                width: 12px;
                height: 12px;
                y: (parent.height - 12px) / 2;
            }
        }
        Rectangle {
            width: 12px;
            horizontal-stretch: 0;
            visible: !root.item.expandable;
        }
        Image {
            source: root.item.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - 14px) / 2;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.title;
            font-size: root.item.kind == "group" ? 13px : 12.5px;
            font-weight: root.item.selected ? 600 : (root.item.kind == "group" ? 600 : (root.item.kind == "project" ? 500 : 400));
            color: root.item.selected ? Palette.accent-text
                : root.item.kind == "session" ? Palette.mid : Palette.strong;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            width: 22px;
            height: 22px;
            horizontal-stretch: 0;
            border-radius: 6px;
            visible: root.item.expandable && ta.has-hover && !qta.has-hover;
            Image {
                source: Icons.plus-dim;
                width: 14px;
                height: 14px;
                x: (parent.width - 14px) / 2;
                y: (parent.height - 14px) / 2;
            }
            qta := TouchArea {
                clicked => { root.quick-create() }
                mouse-cursor: pointer;
            }
        }
    }
    ta := TouchArea {
        clicked => { parent.selected() }
        mouse-cursor: pointer;
    }
}

component WorkflowStepRow inherits Rectangle {
    in property <TimelineItem> item;
    property <bool> running-progress: root.item.progress >= 0 && root.item.progress < 100;
    property <bool> completed-card: root.item.kind == "act.completed" || root.item.kind == "task.completed" || (root.item.tone == "success" && (root.item.title == "任务已完成" || root.item.title == "act.completed"));
    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        VerticalLayout {
            width: 45px;
            horizontal-stretch: 0;
            Text {
                text: root.item.time;
                font-family: "Consolas";
                font-size: 11.5px;
                color: Palette.faint;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            width: 28px;
            horizontal-stretch: 0;
            padding-top: 3px;
            StepDot { tone: root.item.tone; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            padding-top: 1px;
            padding-bottom: 6px;
            if !root.completed-card : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Image {
                    source: root.item.kind == "fs.read" || root.item.kind == "fs.written" || root.item.kind == "fs.created" || root.item.kind == "fs.deleted" ? Icons.folder-dim
                        : root.item.kind == "process.started" || root.item.kind == "process.output" || root.item.kind == "process.exit" || root.item.kind == "tool.result" ? Icons.terminal
                        : root.item.kind == "model.tool-call" ? Icons.bot
                        : Icons.doc;
                    width: 14px;
                    height: 14px;
                    y: 2px;
                }
                Text {
                    text: root.item.title;
                    font-size: 12.5px;
                    font-weight: 500;
                    color: root.item.tone == "success" && (root.item.kind == "assistant.message" || root.item.kind == "act.completed") ? Palette.green-ink : Palette.body;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.running-progress ? "" : root.item.detail;
                    font-family: "Consolas";
                    font-size: 11.5px;
                    color: Palette.dim;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.completed-card : Rectangle {
                background: #F0FDF4;
                border-radius: 8px;
                border-width: 0.67px;
                border-color: #BBF7D0;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            source: Icons.check-circle-green;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                        Text {
                            text: root.item.title == "act.completed" ? "任务已完成" : root.item.title;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #15803D;
                            vertical-alignment: center;
                        }
                    }
                    if root.item.detail != "" : Text {
                        padding-left: 22px;
                        text: root.item.detail;
                        font-size: 11.5px;
                        color: #166534;
                        wrap: word-wrap;
                    }
                }
            }
            if root.running-progress : Rectangle {
                background: #FAF8F5;
                border-radius: 8px;
                border-width: 0.67px;
                border-color: #E8E6DF;
                height: 78px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.item.detail;
                            font-size: 12px;
                            color: Palette.strong;
                            overflow: elide;
                        }
                        Text {
                            text: "进度 " + root.item.progress + " %";
                            font-family: "Consolas";
                            font-weight: 600;
                            font-size: 12px;
                            color: Palette.accent-text;
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 999px;
                        background: #E8E6DF;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: Math.max(2px, parent.width * clamp(root.item.progress, 0, 100) / 100);
                            height: 8px;
                            border-radius: 999px;
                            background: @linear-gradient(90deg, #E08A7E 0%, #C86A28 100%);
                        }
                    }
                    Text {
                        text: "实时进度由 worker.progress 光子驱动 · 详细日志见轨迹面板";
                        font-size: 11px;
                        color: Palette.dim;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component TraceEventRow inherits Rectangle {
    in property <TraceEvent> event;
    in property <int> selected-num;
    callback pick;
    property <bool> hi: root.event.num == root.selected-num;
    height: 34px;
    background: self.hi ? rgba(254, 243, 214, 0.6) : (ta.has-hover ? rgba(0, 0, 0, 0.02) : transparent);
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 0px;
        alignment: start;
        Text {
            width: 28px;
            horizontal-stretch: 0;
            text: root.event.num;
            font-family: "Consolas";
            font-weight: root.hi ? 500 : 400;
            font-size: 12px;
            color: Palette.faint;
            vertical-alignment: center;
        }
        Text {
            width: 118px;
            horizontal-stretch: 0;
            text: root.event.time;
            font-family: "Consolas";
            font-weight: root.hi ? 500 : 400;
            font-size: 11.5px;
            color: Palette.faint;
            vertical-alignment: center;
        }
        Rectangle {
            width: 140px;
            horizontal-stretch: 0;
            PillBadge {
                label: root.event.tone == "OTHER" ? "PHOTON" : root.event.tone;
                tone: root.event.tone;
                y: (parent.height - 16px) / 2;
                x: 0px;
            }
        }
        Text {
            width: 96px;
            horizontal-stretch: 0;
            text: root.event.role;
            font-size: 12px;
            color: Palette.strong;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.event.detail;
            font-family: "Consolas";
            font-size: 11.5px;
            color: root.hi ? Palette.body : Palette.mid;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: 72px;
            horizontal-stretch: 0;
            text: root.event.dur;
            font-family: "Consolas";
            font-size: 12px;
            color: Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 64px;
            horizontal-stretch: 0;
            text: root.event.tokens;
            font-family: "Consolas";
            font-size: 12px;
            color: Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 0.67px;
        height: 0.67px;
        width: parent.width;
        background: Palette.sep;
    }
    ta := TouchArea {
        clicked => { parent.pick() }
        mouse-cursor: pointer;
    }
}

export component MainWindow inherits Window {
    title: "Tokmon — A Lens to Them All";
    no-frame: true;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1040px;
    min-height: 680px;
    background: Palette.app-bg;
    default-font-family: "Microsoft YaHei UI";

    in property <[NavigationItem]> navigation;
    in property <[TimelineItem]> timeline;
    in property <[TimelineItem]> conversation-workflow;
    in property <[CodeLine]> code-lines;
    in property <[SlashCommandItem]> slash-commands;
    in property <[ModelChoice]> model-choices;
    in property <[TraceEvent]> trace-events;
    in property <[GanttSegment]> gantt;
    in property <[string]> trace-ticks;
    in property <[ProjectFile]> project-files;
    in property <[ProjectFile]> workspace-presets;
    in property <[CodeLine]> preview-lines;

    in-out property <string> session-title: "新会话";
    in-out property <string> status-text: "就绪";
    in-out property <string> model-name: "-";
    in-out property <string> access-mode: "完全访问";
    in-out property <string> effort: "标准";
    in-out property <string> composer-text;
    in-out property <string> last-message;
    in-out property <string> assistant-text;
    in-out property <string> daemon-state: "正在连接后台服务";
    in-out property <string> search-text;
    in-out property <string> chat-time;
    in-out property <string> trace-duration: "-";
    in-out property <string> workflow-duration: "0ms";
    in-out property <string> trace-provider: "-";
    in-out property <string> trace-model: "-";
    in-out property <string> trace-result: "等待输入";
    in-out property <string> trace-total-label: "0";
    in-out property <string> trace-prompt-label: "0";
    in-out property <string> trace-completion-label: "0";
    in-out property <string> trace-search;
    in-out property <int> trace-selected-num: -1;
    in-out property <string> create-navigation-kind: "会话";
    in-out property <string> create-navigation-name;
    in-out property <string> create-navigation-workspace;
    in-out property <string> create-navigation-group;
    in-out property <string> create-navigation-error;
    in-out property <string> change-workspace-path;
    in property <[string]> group-options;
    in-out property <string> selected-attachment;
    in-out property <string> settings-search;
    in-out property <string> setting-language: "简体中文";
    in-out property <string> setting-startup: "首页";
    in-out property <string> setting-autosave: "5 分钟";
    in-out property <string> setting-channel: "稳定版";
    in-out property <string> setting-file-access: "受信路径";
    in-out property <string> provider-kind: "官方";
    in-out property <string> setting-provider;
    in-out property <string> setting-provider-protocol: "openai-compatible";
    in-out property <string> setting-provider-endpoint;
    in-out property <string> setting-provider-auth: "bearer";
    in-out property <string> setting-provider-secret;
    in-out property <string> setting-provider-credential;
    in-out property <string> setting-main-model;
    in-out property <string> setting-reasoning: "高";
    in-out property <string> setting-command-approval: "按需确认";
    in-out property <string> setting-workspace;
    in-out property <string> setting-index-mode: "标准";
    in-out property <string> setting-density: "舒适";
    in-out property <string> setting-nickname;
    in-out property <string> setting-email;
    in-out property <string> settings-status;
    in-out property <string> workspace-group: "默认";
    in-out property <string> workspace-project;
    in-out property <string> workspace-short-path;
    in-out property <string> workspace-branch;
    in property <int> workspace-indexed-files: 0;
    in property <bool> workspace-has-git: false;
    in-out property <bool> workspace-locked: false;
    in-out property <string> selected-file-name;
    in-out property <string> preview-search;
    in-out property <string> preview-content;
    in property <int> file-added-lines: 0;
    in property <bool> chat-empty: true;
    in property <int> search-session-count: 0;
    in-out property <int> trace-turns: 0;
    in-out property <int> trace-calls: 0;
    in-out property <int> trace-input-tokens: 0;
    in-out property <int> trace-output-tokens: 0;
    in-out property <int> settings-page: 0;
    in-out property <int> setting-accent: 0;
    in-out property <int> setting-font-scale: 100;
    in-out property <int> shortcut-editing: -1;
    in-out property <int> workflow-explored: 0;
    in-out property <int> workflow-ran: 0;
    in-out property <int> workflow-done: 0;
    in-out property <int> request-tab: 0;
    in-out property <int> trace-filter-index: 0;
    in-out property <int> trace-page: 1;
    in-out property <int> trace-page-size: 20;
    in-out property <int> trace-total: 0;
    in-out property <int> trace-pages: 1;
    in-out property <int> account-field: -1;
    in-out property <bool> sidebar-visible: true;
    in-out property <bool> code-visible: false;
    in-out property <bool> trajectory-selected: false;
    in-out property <bool> file-preview-selected: false;
    in-out property <bool> task-expanded: true;
    in-out property <bool> conversation-workflow-expanded: true;
    in-out property <bool> title-editing: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> access-menu-open: false;
    in-out property <bool> model-menu-open: false;
    in-out property <bool> effort-menu-open: false;
    in-out property <bool> file-menu-open: false;
    in-out property <bool> code-menu-open: false;
    in-out property <bool> issues-open: false;
    in-out property <bool> attachment-menu-open: false;
    in-out property <bool> trace-filter-open: false;
    in-out property <bool> context-popover-open: false;
    in-out property <bool> change-workspace-open: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> slash-menu-visible: false;
    in-out property <bool> create-navigation-open: false;
    in-out property <bool> setting-network: true;
    in-out property <bool> setting-high-risk: true;
    in-out property <bool> setting-provider-thinking: false;
    in-out property <bool> setting-workspace-sync: true;
    in-out property <bool> setting-git: true;
    in-out property <bool> setting-notifications: true;
    in-out property <bool> setting-desktop-notifications: true;
    in-out property <bool> setting-message-alerts: true;
    in-out property <string> setting-quiet-hours: "22:00 - 08:00";
    in-out property <bool> setting-dark-theme: false;
    in-out property <bool> setting-cloud-sync: true;
    in-out property <length> sidebar-width: 240px;
    in-out property <length> code-panel-width: 420px;
    in property <[string]> agent-options;
    in property <[string]> agent-providers;
    in property <[string]> agent-models;

    callback send-message(string);
    callback new-session();
    callback select-navigation(int);
    callback search-changed(string);
    callback add-navigation();
    callback reconcile();
    callback save-settings();
    callback reset-settings();
    callback configure-provider(string, string, string, string, string, bool, string);
    callback store-provider-secret(string, string);
    callback test-provider(string);
    callback drag-window();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback slash-query-changed(string);
    callback rename-session(string);
    callback create-navigation(string, string, string, string) -> bool;
    callback choose-attachment(bool) -> string;
    callback cancel-settings();
    callback refresh-trace();
    callback export-trace();
    callback settings-searched(string);
    callback quick-create(int);
    callback clear-search();
    callback select-project-file(int);
    callback copy-text(string);
    callback open-change-workspace();
    callback confirm-change-workspace(string);
    pure callback identify-project(string) -> string;
    pure callback project-in-group(string, string) -> bool;
    callback filter-preview(string);

    pure function startup-selected() -> int {
        root.setting-startup == "首页" ? 0 : 1
    }
    pure function approval-selected() -> int {
        root.setting-command-approval == "自动执行" ? 0 : root.setting-command-approval == "禁止执行" ? 2 : 1
    }
    pure function effort-selected() -> int {
        root.setting-reasoning == "低" ? 0 : root.setting-reasoning == "标准" ? 1 : root.setting-reasoning == "高" ? 2 : 3
    }
    pure function accent-name(idx: int) -> string {
        idx == 1 ? "玫红" : idx == 2 ? "幻紫" : idx == 3 ? "湛蓝" : idx == 4 ? "青绿" : idx == 5 ? "石墨" : "浅金"
    }
    pure function accent-hex(idx: int) -> color {
        idx == 1 ? #F43F5E : idx == 2 ? #A855F7 : idx == 3 ? #3B82F6 : idx == 4 ? #22C55E : idx == 5 ? #6B7280 : #F5A623
    }
    pure function page-range-label() -> string {
        root.trace-total == 0 ? "显示 0 条，共 0 条"
            : "显示 " + ((root.trace-page - 1) * root.trace-page-size + 1) + "-" + Math.min(root.trace-total, root.trace-page * root.trace-page-size) + " 条，共 " + root.trace-total + " 条"
    }
    pure function setting-provider-at(i: int) -> string {
        root.agent-providers[i]
    }
    pure function setting-model-at(i: int) -> string {
        root.agent-models[i]
    }
    pure function prompt-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 :
            root.trace-input-tokens * 100 / (root.trace-input-tokens + root.trace-output-tokens)
    }


    VerticalLayout {
        Rectangle {
            height: 32px;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                alignment: start;
                Image {
                    source: Icons.logo;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                }
                Text {
                    text: "Tokmon";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.dim;
                    vertical-alignment: center;
                }
                Text {
                    text: root.daemon-state;
                    font-size: 11px;
                    color: Palette.faint;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ToolIcon { source: Icons.minus; icon-size: 14px; clicked => { root.minimize-window() } }
                ToolIcon { source: Icons.stop; icon-size: 12px; clicked => { root.toggle-maximize-window() } }
                ToolIcon { source: Icons.close; icon-size: 14px; clicked => { root.close-window() } }
            }
            TouchArea {
                moved => { root.drag-window() }
                clicked => { hs.focus(); }
            }
            Rectangle {
                y: parent.height - 0.67px;
                height: 0.67px;
                width: parent.width;
                background: Palette.hairline;
            }
        }
        HorizontalLayout {
            Rectangle {
                visible: root.sidebar-visible;
                width: root.sidebar-width;
                background: #F9F9F8;
                VerticalLayout {
                    padding-top: 14px;
                    padding-bottom: 0px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            HorizontalLayout {
                                padding-top: 2px;
                                padding-bottom: 18px;
                                padding-left: 4px;
                                padding-right: 2px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Image {
                                        source: Icons.logo;
                                        width: 24px;
                                        height: 24px;
                                        y: (parent.height - 24px) / 2;
                                    }
                                    Text {
                                        text: "Tokmon";
                                        font-size: 18px;
                                        font-weight: 700;
                                        letter-spacing: -0.3px;
                                        color: Palette.ink;
                                        vertical-alignment: center;
                                    }
                                }
                                ToolIcon {
                                    source: Icons.panel-left;
                                    icon-size: 16px;
                                    clicked => { root.sidebar-visible = false }
                                }
                            }
                            Rectangle {
                                height: 42px;
                                border-radius: 12px;
                                background: Palette.accent-bg;
                                border-width: 0.67px;
                                border-color: Palette.accent-border;
                                drop-shadow-color: Palette.shadow;
                                drop-shadow-offset-y: 1px;
                                drop-shadow-blur: 0px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    alignment: center;
                                    Image {
                                        source: Icons.plus-amber;
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - 16px) / 2;
                                    }
                                    Text {
                                        text: "新建会话";
                                        font-size: 13.5px;
                                        font-weight: 500;
                                        color: Palette.accent-text;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.new-session() }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                height: 32px;
                                border-radius: 12px;
                                background: Palette.input-deep;
                                Image {
                                    source: Icons.search;
                                    x: 12px;
                                    y: (parent.height - 16px) / 2;
                                    width: 16px;
                                    height: 16px;
                                }
                                TextInput {
                                    x: 36px;
                                    width: parent.width - 44px;
                                    height: parent.height;
                                    text <=> root.search-text;
                                    font-size: 12.5px;
                                    color: Palette.body;
                                    edited => { root.search-changed(self.text) }
                                }
                                if root.search-text == "" : Text {
                                    x: 36px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text: "搜索项目或会话...";
                                    font-size: 12.5px;
                                    color: Palette.faint;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px;
                                alignment: space-between;
                                Text {
                                    text: "分组 / 项目 / 会话";
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    letter-spacing: 0.5px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if root.search-text != "" : Rectangle {
                                        height: 17px;
                                        border-radius: 4px;
                                        background: #FEF8F4;
                                        border-width: 0.67px;
                                        border-color: #F5D9C3;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "找到 " + root.search-session-count + " 个会话";
                                                font-size: 9.5px;
                                                font-weight: 500;
                                                color: Palette.accent;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    ToolIcon {
                                        source: Icons.plus-dim;
                                        icon-size: 14px;
                                        clicked => { root.add-navigation() }
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                if root.search-text != "" && root.navigation.length == 0 : VerticalLayout {
                                    padding-top: 28px;
                                    padding-bottom: 16px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 999px;
                                            background: Palette.sep;
                                            Image {
                                                source: Icons.search;
                                                width: 15px;
                                                height: 15px;
                                                x: (parent.width - 15px) / 2;
                                                y: (parent.height - 15px) / 2;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "未找到匹配的会话、项目或分组";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Palette.dim;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 96px;
                                            height: 24px;
                                            Text {
                                                text: "清除搜索条件";
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: Palette.accent;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => { root.clear-search() }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for item[index] in root.navigation : SidebarRow {
                                        item: item;
                                        row-index: index;
                                        selected => { root.select-navigation(index) }
                                        quick-create => { root.quick-create(index) }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 42px;
                        Rectangle {
                            y: 8px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.hairline;
                        }
                        HorizontalLayout {
                            padding-top: 14px; padding-bottom: 6px; padding-left: 10px; padding-right: 10px;
                            spacing: 10px;
                            alignment: start;
                            Image {
                                source: Icons.gear;
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                            }
                            Text {
                                text: "设置";
                                font-size: 13.5px;
                                font-weight: 500;
                                color: Palette.strong;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            StatusDot {
                                tone: root.daemon-state == "后台服务已连接" || root.daemon-state == "后台服务已自动启动" ? "success" : "warning";
                                y: (parent.height - 7px) / 2 + 4px;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.settings-searched("");
                                root.settings-open = true;
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
            Rectangle {
                visible: root.sidebar-visible;
                width: 6px;
                background: sbt.has-hover || sbt.pressed ? Palette.hairline : transparent;
                sbt := TouchArea {
                    moved => {
                        root.sidebar-width = Math.max(196px, Math.min(380px,
                            root.sidebar-width + (self.mouse-x - self.pressed-x)));
                    }
                    mouse-cursor: ew-resize;
                }
            }
            Rectangle {
                background: Palette.surface;
                VerticalLayout {
                    Rectangle {
                        height: 46px;
                        background: rgba(250, 250, 249, 0.94);
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if !root.title-editing : Text {
                                text: root.session-title;
                                font-size: 14.5px;
                                font-weight: 600;
                                letter-spacing: -0.25px;
                                color: Palette.ink;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if root.title-editing : LineEdit {
                                width: 240px;
                                text <=> root.session-title;
                                font-size: 14px;
                                accepted => {                                    root.rename-session(root.session-title);                                     root.title-editing = false;                                     hs.focus();                                }
                            }
                            ToolIcon {
                                source: Icons.pencil;
                                icon-size: 14px;
                                clicked => { root.title-editing = !root.title-editing }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            Text {
                                text: root.status-text;
                                font-size: 11px;
                                color: Palette.faint;
                                vertical-alignment: center;
                            }
                            ToolIcon {
                                source: Icons.panel-right;
                                icon-size: 16px;
                                clicked => { root.code-visible = !root.code-visible }
                            }
                            ToolIcon {
                                source: Icons.gear;
                                icon-size: 16px;
                                clicked => {
                                    root.settings-searched("");
                                    root.settings-open = true;
                                }
                            }
                        }
                        }
                    }
                    Rectangle {
                        height: 38px;
                        background: Palette.tabbar;
                        HorizontalLayout {
                            padding-left: 24px;
                            spacing: 24px;
                            alignment: start;
                            Rectangle {
                                width: t1.width + 2px;
                                horizontal-stretch: 0;
                                t1 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "对话";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 500 : 700;
                                    color: root.trajectory-selected ? Palette.dim : Palette.accent-text;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? transparent : Palette.accent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = false; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                width: t2.width + 2px;
                                horizontal-stretch: 0;
                                t2 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "轨迹";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 700 : 500;
                                    color: root.trajectory-selected ? Palette.accent-text : Palette.dim;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? Palette.accent : transparent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = true; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.tab-line;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if !root.trajectory-selected : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            if root.chat-empty : VerticalLayout {
                                padding-bottom: 120px;
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: center;
                                spacing: 14px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 16px;
                                        background: #FEF8F4;
                                        border-width: 0.67px;
                                        border-color: #F5D9C3;
                                        Image {
                                            source: Icons.logo;
                                            width: 26px;
                                            height: 26px;
                                            x: (parent.width - 26px) / 2;
                                            y: (parent.height - 26px) / 2;
                                        }
                                    }
                                }
                                Text {
                                    text: root.session-title;
                                    font-size: 17px;
                                    font-weight: 700;
                                    letter-spacing: -0.3px;
                                    color: Palette.ink;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    width: parent.width;
                                    text: "当前为新会话。工作空间已关联至 " + (root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path) + "。";
                                    font-size: 13px;
                                    color: Palette.dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "您可在下方工作空间栏点击「更换目录」调整路径。发送第一条指令后工作空间将锁定。";
                                    font-size: 11.5px;
                                    color: Palette.faint;
                                    horizontal-alignment: center;
                                }
                            }
                            ScrollView {
                                VerticalLayout {
                                    spacing: 24px;
                                    padding-top: 20px;
                                    padding-bottom: 160px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    if root.chat-time != "" : Text {
                                        text: root.chat-time;
                                        font-size: 11.5px;
                                        font-weight: 500;
                                        color: Palette.faint;
                                        horizontal-alignment: center;
                                    }
                                    if root.last-message != "" : HorizontalLayout {
                                        alignment: end;
                                        spacing: 10px;
                                        Rectangle {
                                            max-width: 560px;
                                            border-radius: 16px;
                                            background: Palette.bubble;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            drop-shadow-color: Palette.shadow;
                                            drop-shadow-offset-y: 1px;
                                            drop-shadow-blur: 0px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 6px;
                                                Text {
                                                    text: root.last-message;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    color: Palette.ink;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 999px;
                                            background: Palette.accent-bg;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            Image {
                                                source: Icons.person-amber;
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                            }
                                        }
                                    }
                                    if root.assistant-text != "" : HorizontalLayout {
                                        alignment: start;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 999px;
                                            background: Palette.accent-bg;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            drop-shadow-color: Palette.shadow;
                                            drop-shadow-offset-y: 1px;
                                            drop-shadow-blur: 0px;
                                            Image {
                                                source: Icons.logo;
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                            }
                                        }
                                        Text {
                                            text: root.assistant-text;
                                            font-size: 13.5px;
                                            color: Palette.body;
                                            wrap: word-wrap;
                                            vertical-alignment: top;
                                        }
                                    }
                                    if root.conversation-workflow.length > 0 : Rectangle {
                                        border-radius: 12px;
                                        background: Palette.white;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        drop-shadow-color: Palette.shadow;
                                        drop-shadow-offset-y: 1px;
                                        drop-shadow-blur: 0px;
                                        VerticalLayout {
                                            padding: 16px;
                                            HorizontalLayout {
                                                padding-bottom: 12px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 24px;
                                                    alignment: start;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Text { text: "🕒"; font-size: 12px; vertical-alignment: center; }
                                                        Text {
                                                            text: "已工作 ";
                                                            font-size: 12px;
                                                            font-weight: 500;
                                                            color: Palette.dim;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.workflow-duration;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            color: Palette.ink;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.search; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "已探索 " + root.workflow-explored + " 项"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.terminal; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "已运行 " + root.workflow-ran + " 条命令"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.check-circle-green; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "完成任务 " + root.workflow-done + "/1"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: end;
                                                    Text {
                                                        text: root.conversation-workflow-expanded ? "收起步骤" : "展开步骤";
                                                        font-size: 11.5px;
                                                        font-weight: 500;
                                                        color: Palette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                    ToolIcon {
                                                        source: root.conversation-workflow-expanded ? Icons.chev-down : Icons.chev-right-faint;
                                                        icon-size: 14px;
                                                        clicked => { root.conversation-workflow-expanded = !root.conversation-workflow-expanded }
                                                    }
                                                }
                                            }
                                            if root.conversation-workflow-expanded : Rectangle {
                                                VerticalLayout {
                                                    for step[index] in root.conversation-workflow : WorkflowStepRow {
                                                        item: step;
                                                    }
                                                }
                                                Rectangle {
                                                    x: 58.5px;
                                                    y: 18px;
                                                    width: 1px;
                                                    height: parent.height - 26px;
                                                    background: Palette.border;
                                                    z: -1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            composer := Rectangle {
                                y: parent.height - 164px;
                                width: parent.width;
                                height: 164px;
                                background: @linear-gradient(0deg, rgba(250, 250, 249, 1) 0%, rgba(250, 250, 249, 0.92) 55%, rgba(250, 250, 249, 0) 100%);
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: Math.min(760px, parent.width - 48px);
                                        height: 130px;
                                        vertical-stretch: 0;
                                        y: 18px;
                                        VerticalLayout {
                                            spacing: 7px;
                                            Rectangle {
                                                height: 27px;
                                                border-radius: 12px;
                                                background: rgba(255, 255, 255, 0.95);
                                                border-width: 0.67px;
                                                border-color: Palette.border;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 6px;
                                                    spacing: 6px;
                                                    alignment: start;
                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 5px;
                                                        background: #FEF8F4;
                                                        border-width: 0.67px;
                                                        border-color: #F5D9C3;
                                                        Image {
                                                            source: Icons.folder;
                                                            width: 11px;
                                                            height: 11px;
                                                            x: (parent.width - 11px) / 2;
                                                            y: (parent.height - 11px) / 2;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.workspace-group;
                                                        font-size: 10px;
                                                        font-weight: 500;
                                                        color: Palette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: "/";
                                                        font-size: 9px;
                                                        color: #D6D3D1;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.workspace-project;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        letter-spacing: -0.2px;
                                                        color: Palette.ink;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        height: 17px;
                                                        border-radius: 4px;
                                                        background: Palette.sep;
                                                        border-width: 0.67px;
                                                        border-color: Palette.border;
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            Text {
                                                                text: root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path;
                                                                font-family: "Consolas";
                                                                font-size: 9.5px;
                                                                color: Palette.dim;
                                                                overflow: elide;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if root.workspace-has-git : Rectangle {
                                                        height: 17px;
                                                        border-radius: 4px;
                                                        background: #FEF8F4;
                                                        border-width: 0.67px;
                                                        border-color: #F5D9C3;
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            spacing: 3px;
                                                            Text {
                                                                text: root.workspace-branch;
                                                                font-family: "Consolas";
                                                                font-size: 9px;
                                                                color: Palette.accent;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Rectangle {
                                                        height: 17px;
                                                        border-radius: 4px;
                                                        background: Palette.sep;
                                                        border-width: 0.67px;
                                                        border-color: Palette.border;
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            spacing: 4px;
                                                            Rectangle {
                                                                width: 6px;
                                                                height: 6px;
                                                                border-radius: 999px;
                                                                background: #16A34A;
                                                                y: (parent.height - 6px) / 2;
                                                            }
                                                            Text {
                                                                text: root.workspace-indexed-files + " 文件就绪";
                                                                font-size: 9.5px;
                                                                color: Palette.dim;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if !root.workspace-locked : Rectangle {
                                                        height: 19px;
                                                        border-radius: 5px;
                                                        background: #FEF8F4;
                                                        border-width: 0.67px;
                                                        border-color: #F5D9C3;
                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            Image {
                                                                source: Icons.folder;
                                                                width: 10px;
                                                                height: 10px;
                                                                y: (parent.height - 10px) / 2;
                                                            }
                                                            Text {
                                                                text: "更换目录";
                                                                font-size: 10px;
                                                                font-weight: 500;
                                                                color: Palette.accent;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        TouchArea {
                                                            clicked => { root.open-change-workspace() }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    if root.workspace-locked : HorizontalLayout {
                                                        spacing: 4px;
                                                        alignment: end;
                                                        Text {
                                                            text: "目录已锁定";
                                                            font-size: 10px;
                                                            color: Palette.faint;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { hs.focus() }
                                                }
                                            }
                                            Rectangle {
                                                border-radius: 16px;
                                                background: Palette.white;
                                                border-width: 0.67px;
                                                border-color: Palette.border;
                                                drop-shadow-color: rgba(0, 0, 0, 0.1);
                                                drop-shadow-offset-y: 8px;
                                                drop-shadow-offset-x: 0px;
                                                drop-shadow-blur: 14px;
                                                VerticalLayout {
                                                    padding: 12px;
                                                    Rectangle {
                                                        height: 34px;
                                                        composer-edit := TextInput {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            vertical-alignment: center;
                                                            text <=> root.composer-text;
                                                            font-size: 13.5px;
                                                            color: Palette.body;
                                                            accepted => {
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    hs.focus();
                                                                }
                                                            }
                                                        }
                                                        if root.composer-text == "" : Text {
                                                            y: 8px;
                                                            text: "提出后续修改要求";
                                                            font-size: 13.5px;
                                                            color: Palette.faint;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                            HorizontalLayout {
                                                padding-top: 4px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    ToolIcon {
                                                        source: Icons.doc;
                                                        icon-size: 16px;
                                                        clicked => {
                                                            root.selected-attachment = root.choose-attachment(false);
                                                            if root.selected-attachment != "" {
                                                                root.composer-text = root.composer-text + " " + root.selected-attachment;
                                                            }
                                                        }
                                                    }
                                                    Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.shield; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.access-mode; font-size: 12.5px; font-weight: 500; color: Palette.amber; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.model-menu-open = false;
                                                                root.effort-menu-open = false;
                                                                root.access-menu-open = !root.access-menu-open;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: end;
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        background: cta.has-hover ? Palette.sep : transparent;
                                                        Image {
                                                            source: Icons.spinner;
                                                            width: 15px;
                                                            height: 15px;
                                                            x: (parent.width - 15px) / 2;
                                                            y: (parent.height - 15px) / 2;
                                                        }
                                                        cta := TouchArea {
                                                            clicked => {
                                                                root.access-menu-open = false;
                                                                root.effort-menu-open = false;
                                                                root.model-menu-open = false;
                                                                root.context-popover-open = !root.context-popover-open;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    ToolIcon {
                                                        source: Icons.sliders;
                                                        icon-size: 14px;
                                                        clicked => {
                                                            root.access-menu-open = false;
                                                            root.effort-menu-open = !root.effort-menu-open;
                                                        }
                                                    }
                                                    Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: root.model-name;
                                                                font-family: "Consolas";
                                                                font-size: 12px;
                                                                font-weight: 500;
                                                                color: Palette.strong;
                                                                vertical-alignment: center;
                                                            }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.access-menu-open = false;
                                                                root.effort-menu-open = false;
                                                                root.model-menu-open = !root.model-menu-open;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.rocket; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.effort; font-size: 12.5px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.access-menu-open = false;
                                                                root.effort-menu-open = !root.effort-menu-open;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 12px;
                                                        background: root.composer-text == "" ? Palette.bar-gray : Palette.accent;
                                                        drop-shadow-color: Palette.shadow;
                                                        drop-shadow-offset-y: 1px;
                                                        drop-shadow-blur: 2px;
                                                        Image {
                                                            source: Icons.send;
                                                            width: 16px;
                                                            height: 16px;
                                                            x: (parent.width - 16px) / 2;
                                                            y: (parent.height - 16px) / 2;
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    hs.focus();
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.access-menu-open : Rectangle {
                                            x: parent.width - 320px;
                                            y: -138px;
                                            width: 180px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                MenuOption {
                                                    label: "完全访问";
                                                    active: root.access-mode == "完全访问";
                                                    chosen => { root.access-mode = "完全访问"; root.access-menu-open = false; hs.focus(); }
                                                }
                                                MenuOption {
                                                    label: "受限访问";
                                                    active: root.access-mode == "受限访问";
                                                    chosen => { root.access-mode = "受限访问"; root.access-menu-open = false; hs.focus(); }
                                                }
                                                MenuOption {
                                                    label: "只读模式";
                                                    active: root.access-mode == "只读模式";
                                                    chosen => { root.access-mode = "只读模式"; root.access-menu-open = false; hs.focus(); }
                                                }
                                            }
                                            TouchArea { clicked => { root.access-menu-open = false } }
                                        }
                                        if root.effort-menu-open : Rectangle {
                                            x: parent.width - 200px;
                                            y: -178px;
                                            width: 150px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                for opt in ["低", "标准", "高", "最高"] : MenuOption {
                                                    label: opt;
                                                    active: root.effort == opt;
                                                    chosen => { root.effort = opt; root.effort-menu-open = false; hs.focus(); }
                                                }
                                            }
                                            TouchArea { clicked => { root.effort-menu-open = false } }
                                        }
                                        if root.model-menu-open : Rectangle {
                                            x: parent.width - 430px;
                                            y: -Math.min(root.model-choices.length * 32px + 8px, 200px) - 78px;
                                            width: 340px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                for choice in root.model-choices : MenuOption {
                                                    label: choice.label;
                                                    active: choice.model == root.model-name;
                                                    chosen => {
                                                        root.model-name = choice.model;
                                                        root.setting-main-model = choice.model;
                                                        root.model-menu-open = false;
                                                        hs.focus();
                                                    }
                                                }
                                            }
                                            TouchArea { clicked => { root.model-menu-open = false } }
                                        }
                                        if root.slash-menu-visible && root.slash-commands.length > 0 : Rectangle {
                                            x: 12px;
                                            y: -Math.min(root.slash-commands.length * 44px + 8px, 240px) - 80px;
                                            width: parent.width - 24px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
