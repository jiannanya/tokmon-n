                                    HorizontalLayout { spacing: 8px; Text { text: "Tool calls"; width: 84px; horizontal-stretch: 0; font-size: 12px; color: Palette.dim; vertical-alignment: center; } Text { text: root.trace-calls; font-family: "Consolas"; font-size: 12px; color: Palette.body; vertical-alignment: center; } }
