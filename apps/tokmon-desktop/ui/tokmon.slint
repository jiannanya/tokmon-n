import { LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";
import { NavigationItem, ModelChoice, TimelineItem, CodeLine, SlashCommandItem, ProjectFile, GanttSegment, TraceEvent } from "tokmon-models.slint";
import { Palette, Icons } from "tokmon-theme.slint";
import { ToolIcon, StatusDot, MenuOption, ToggleSwitch, SegTrack, SelectBox, RowShell, OverviewLine, KeyCap, SwatchDot, PillBadge, StepDot, SidebarRow, WorkflowStepRow, TraceEventRow, WorkspaceStatusBar } from "tokmon-components.slint";
import { SettingsOverlay } from "tokmon-settings.slint";
import { TrajectoryPanel } from "tokmon-trajectory.slint";
import { CodePanelSlot } from "tokmon-code-panel.slint";

export component MainWindow inherits Window {
    title: "Tokmon — A Lens to Them All";
    no-frame: true;
    preferred-width: root.code-visible ? 1440px : 999px;
    preferred-height: 900px;
    min-width: root.code-visible ? 1040px : 840px;
    min-height: 680px;
    background: Palette.app-bg;
    // Slint currently resolves one family here without the browser's CSS
    // fallback chain. YaHei UI keeps Chinese glyph coverage while retaining
    // Windows-native UI metrics for mixed Chinese/Latin labels.
    default-font-family: "Microsoft YaHei UI";

    in property <[NavigationItem]> navigation;
    in property <[TimelineItem]> timeline;
    in property <[TimelineItem]> conversation-workflow;
    in property <[CodeLine]> code-lines;
    in property <[SlashCommandItem]> slash-commands;
    in property <[ModelChoice]> model-choices;
    in property <[TraceEvent]> trace-events;
    in property <[GanttSegment]> gantt;
    in property <[string]> trace-ticks;
    in property <[ProjectFile]> project-files;
    in property <[ProjectFile]> workspace-presets;
    in property <[CodeLine]> preview-lines;

    in-out property <string> session-title: "新会话";
    in-out property <string> status-text: "就绪";
    in-out property <string> model-name: "-";
    in-out property <string> access-mode: "完全访问";
    in-out property <string> effort: "标准";
    in-out property <string> composer-text;
    in-out property <string> last-message;
    in-out property <string> assistant-text;
    in-out property <string> daemon-state: "正在连接后台服务";
    in-out property <string> search-text;
    in-out property <string> chat-time;
    in-out property <string> trace-duration: "-";
    in-out property <string> workflow-duration: "0ms";
    in-out property <string> trace-provider: "-";
    in-out property <string> trace-model: "-";
    in-out property <string> trace-result: "等待输入";
    in-out property <string> trace-total-label: "0";
    in-out property <string> trace-prompt-label: "0";
    in-out property <string> trace-completion-label: "0";
    in-out property <string> trace-search;
    in-out property <int> trace-selected-num: -1;
    in-out property <string> create-navigation-kind: "会话";
    in-out property <string> create-navigation-name;
    in-out property <string> create-navigation-workspace;
    in-out property <string> create-navigation-group;
    in-out property <string> create-navigation-error;
    in-out property <string> change-workspace-path;
    in property <[string]> group-options;
    in-out property <string> selected-attachment;
    in-out property <string> settings-search;
    in-out property <string> setting-language: "简体中文";
    in-out property <string> setting-startup: "首页";
    in-out property <string> setting-autosave: "5 分钟";
    in-out property <string> setting-channel: "稳定版";
    in-out property <string> setting-file-access: "受信路径";
    in-out property <string> provider-kind: "官方";
    in-out property <string> setting-provider;
    in-out property <string> setting-provider-protocol: "openai-compatible";
    in-out property <string> setting-provider-endpoint;
    in-out property <string> setting-provider-auth: "bearer";
    in-out property <string> setting-provider-secret;
    in-out property <string> setting-provider-credential;
    in-out property <string> setting-main-model;
    in-out property <string> setting-reasoning: "高";
    in-out property <string> setting-command-approval: "按需确认";
    in-out property <string> setting-workspace;
    in-out property <string> setting-index-mode: "标准";
    in-out property <string> setting-density: "舒适";
    in-out property <string> setting-nickname;
    in-out property <string> setting-email;
    in-out property <string> settings-status;
    in-out property <string> workspace-group: "默认";
    in-out property <string> workspace-project;
    in-out property <string> workspace-short-path;
    in-out property <string> workspace-branch;
    in property <int> workspace-indexed-files: 0;
    in property <bool> workspace-has-git: false;
    in-out property <bool> workspace-locked: false;
    in-out property <string> selected-file-name;
    in-out property <string> preview-search;
    in-out property <string> preview-content;
    in property <int> file-added-lines: 0;
    in property <bool> chat-empty: true;
    in property <int> search-session-count: 0;
    in-out property <int> trace-turns: 0;
    in-out property <int> trace-calls: 0;
    in-out property <int> trace-input-tokens: 0;
    in-out property <int> trace-output-tokens: 0;
    in-out property <int> settings-page: 0;
    in-out property <int> setting-accent: 0;
    in-out property <int> setting-font-scale: 100;
    in-out property <int> shortcut-editing: -1;
    in-out property <int> workflow-explored: 0;
    in-out property <int> workflow-ran: 0;
    in-out property <int> workflow-done: 0;
    in-out property <int> request-tab: 0;
    in-out property <int> trace-filter-index: 0;
    in-out property <int> trace-page: 1;
    in-out property <int> trace-page-size: 20;
    in-out property <int> trace-total: 0;
    in-out property <int> trace-pages: 1;
    in-out property <int> account-field: -1;
    in-out property <bool> sidebar-visible: true;
    in-out property <bool> code-visible: false;
    in-out property <bool> trajectory-selected: false;
    in-out property <bool> file-preview-selected: false;
    in-out property <bool> task-expanded: true;
    in-out property <bool> conversation-workflow-expanded: true;
    in-out property <bool> title-editing: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> access-menu-open: false;
    in-out property <bool> model-menu-open: false;
    in-out property <bool> effort-menu-open: false;
    in-out property <bool> file-menu-open: false;
    in-out property <bool> code-menu-open: false;
    in-out property <bool> issues-open: false;
    in-out property <bool> attachment-menu-open: false;
    in-out property <bool> trace-filter-open: false;
    in-out property <bool> context-popover-open: false;
    in-out property <bool> context-button-hover: false;
    in-out property <bool> context-card-hover: false;
    in-out property <bool> context-close-pending: false;
    in-out property <bool> copy-notice-visible: false;
    in-out property <bool> change-workspace-open: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> slash-menu-visible: false;
    in-out property <bool> create-navigation-open: false;
    in-out property <bool> setting-network: true;
    in-out property <bool> setting-high-risk: true;
    in-out property <bool> setting-provider-thinking: false;
    in-out property <bool> setting-workspace-sync: true;
    in-out property <bool> setting-git: true;
    in-out property <bool> setting-notifications: true;
    in-out property <bool> setting-desktop-notifications: true;
    in-out property <bool> setting-message-alerts: true;
    in-out property <string> setting-quiet-hours: "22:00 - 08:00";
    in-out property <bool> setting-dark-theme: false;
    in-out property <bool> setting-cloud-sync: true;
    in-out property <length> sidebar-width: 240px;
    in-out property <length> code-panel-width: 440px;
    in property <[string]> agent-options;
    in property <[string]> agent-providers;
    in property <[string]> agent-models;

    callback send-message(string);
    callback new-session();
    callback select-navigation(int);
    callback search-changed(string);
    callback add-navigation();
    callback reconcile();
    callback save-settings();
    callback reset-settings();
    callback configure-provider(string, string, string, string, string, bool, string);
    callback store-provider-secret(string, string);
    callback test-provider(string);
    callback drag-window();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback set-code-panel-visible(bool);
    callback slash-query-changed(string);
    callback rename-session(string);
    callback create-navigation(string, string, string, string) -> bool;
    callback choose-attachment(bool) -> string;
    callback cancel-settings();
    callback refresh-trace();
    callback export-trace();
    callback settings-searched(string);
    callback quick-create(int);
    callback clear-search();
    callback select-project-file(int);
    callback copy-text(string);
    callback open-change-workspace();
    callback confirm-change-workspace(string);
    pure callback identify-project(string) -> string;
    pure callback project-in-group(string, string) -> bool;
    callback filter-preview(string);

    pure function startup-selected() -> int {
        root.setting-startup == "首页" ? 0 : 1
    }
    pure function approval-selected() -> int {
        root.setting-command-approval == "自动执行" ? 0 : root.setting-command-approval == "禁止执行" ? 2 : 1
    }
    pure function effort-selected() -> int {
        root.setting-reasoning == "低" ? 0 : root.setting-reasoning == "标准" ? 1 : root.setting-reasoning == "高" ? 2 : 3
    }
    pure function accent-name(idx: int) -> string {
        idx == 1 ? "玫红" : idx == 2 ? "幻紫" : idx == 3 ? "湛蓝" : idx == 4 ? "青绿" : idx == 5 ? "石墨" : "浅金"
    }
    pure function accent-hex(idx: int) -> color {
        idx == 1 ? #F43F5E : idx == 2 ? #A855F7 : idx == 3 ? #3B82F6 : idx == 4 ? #22C55E : idx == 5 ? #6B7280 : #F5A623
    }
    pure function page-range-label() -> string {
        root.trace-total == 0 ? "显示 0 条，共 0 条"
            : "显示 " + ((root.trace-page - 1) * root.trace-page-size + 1) + "-" + Math.min(root.trace-total, root.trace-page * root.trace-page-size) + " 条，共 " + root.trace-total + " 条"
    }
    pure function setting-provider-at(i: int) -> string {
        root.agent-providers[i]
    }
    pure function setting-model-at(i: int) -> string {
        root.agent-models[i]
    }
    pure function prompt-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 :
            root.trace-input-tokens * 100 / (root.trace-input-tokens + root.trace-output-tokens)
    }
    pure function completion-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 : 100 - root.prompt-share()
    }

    function close-click-popups() {
        root.access-menu-open = false;
        root.model-menu-open = false;
        root.effort-menu-open = false;
        root.attachment-menu-open = false;
        root.slash-menu-visible = false;
    }

    function close-composer-popups() {
        root.close-click-popups();
        root.context-popover-open = false;
        root.context-button-hover = false;
        root.context-card-hover = false;
        root.context-close-pending = false;
    }

    Timer {
        interval: 2s;
        running: root.copy-notice-visible;
        triggered => { root.copy-notice-visible = false; }
    }

    Timer {
        interval: 140ms;
        running: root.context-close-pending;
        triggered => {
            if !root.context-button-hover && !root.context-card-hover {
                root.context-popover-open = false;
            }
            root.context-close-pending = false;
        }
    }

    // A click-open menu installs an input backdrop behind the actual controls.
    // Foreground buttons keep receiving their own events; otherwise this catches
    // the next blank-area click and dismisses the composer menus.
    if root.access-menu-open || root.model-menu-open || root.effort-menu-open || root.attachment-menu-open || root.slash-menu-visible : TouchArea {
        clicked => { root.close-click-popups(); }
    }

    VerticalLayout {
        HorizontalLayout {
            Rectangle {
                visible: root.sidebar-visible;
                width: root.sidebar-visible ? root.sidebar-width : 0px;
                clip: true;
                background: #F9F9F8;
                VerticalLayout {
                    // 46px pinned header followed by the 12px padded scroll content.
                    // The header/content boundary is drawn by the absolute hairline below.
                    padding-top: 9px;
                    padding-bottom: 0px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            HorizontalLayout {
                                padding-top: 2px;
                                padding-bottom: 23px;
                                padding-left: 4px;
                                padding-right: 2px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Image {
                                        source: Icons.logo;
                                        width: 24px;
                                        height: 24px;
                                        y: (parent.height - 24px) / 2;
                                    }
                                    Text {
                                        text: "Tokmon";
                                        font-size: 17px;
                                        font-weight: 700;
                                        letter-spacing: -0.3px;
                                        color: Palette.ink;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                height: 42px;
                                border-radius: 12px;
                                background: Palette.accent-bg;
                                border-width: 0.67px;
                                border-color: Palette.accent-border;
                                drop-shadow-color: Palette.shadow;
                                drop-shadow-offset-y: 1px;
                                drop-shadow-blur: 0px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    alignment: center;
                                    Image {
                                        source: Icons.plus-amber;
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - 16px) / 2;
                                    }
                                    Text {
                                        text: "新建会话";
                                        font-size: 13.5px;
                                        font-weight: 500;
                                        color: Palette.accent-text;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.new-session() }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle { height: 14px; }
                            Rectangle {
                                height: 32px;
                                border-radius: 12px;
                                background: Palette.input-deep;
                                Image {
                                    source: Icons.search;
                                    x: 12px;
                                    y: (parent.height - 16px) / 2;
                                    width: 16px;
                                    height: 16px;
                                }
                                TextInput {
                                    x: 36px;
                                    width: parent.width - 44px;
                                    height: parent.height;
                                    text <=> root.search-text;
                                    font-size: 12.5px;
                                    color: Palette.body;
                                    edited => { root.search-changed(self.text) }
                                }
                                if root.search-text == "" : Text {
                                    x: 36px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text: "搜索会话、项目或分组...";
                                    font-size: 12.5px;
                                    color: Palette.faint;
                                }
                            }
                            Rectangle { height: 14px; }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px;
                                alignment: space-between;
                                Text {
                                    text: "分组 / 项目 / 会话";
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    letter-spacing: 0.5px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                                if root.search-text != "" : HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 17px;
                                        border-radius: 4px;
                                        background: #FEF8F4;
                                        border-width: 0.67px;
                                        border-color: #F5D9C3;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "找到 " + root.search-session-count + " 个会话";
                                                font-size: 9.5px;
                                                font-weight: 500;
                                                color: Palette.accent;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: false;
                                property <length> nav-viewport-height: root.navigation.length * 30px;
                                property <length> nav-thumb-height: Math.max(36px,
                                    self.height * self.height / Math.max(self.height, self.nav-viewport-height));
                                if root.search-text != "" && root.navigation.length == 0 : VerticalLayout {
                                    padding-top: 28px;
                                    padding-bottom: 16px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 999px;
                                            background: Palette.sep;
                                            Image {
                                                source: Icons.search;
                                                width: 15px;
                                                height: 15px;
                                                x: (parent.width - 15px) / 2;
                                                y: (parent.height - 15px) / 2;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "未找到匹配的会话、项目或分组";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Palette.dim;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 96px;
                                            height: 24px;
                                            Text {
                                                text: "清除搜索条件";
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: Palette.accent;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => { root.clear-search() }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }
                                sidebar-nav := Flickable {
                                    width: parent.width - 10px;
                                    height: parent.height;
                                    viewport-width: self.width;
                                    viewport-height: parent.nav-viewport-height;
                                    VerticalLayout {
                                        width: sidebar-nav.width;
                                        for item[index] in root.navigation : SidebarRow {
                                            item: item;
                                            row-index: index;
                                            selected => { root.select-navigation(index) }
                                            quick-create => { root.quick-create(index) }
                                        }
                                    }
                                }
                                if self.nav-viewport-height > self.height : Rectangle {
                                    x: parent.width + 3px;
                                    y: Math.max(0px, Math.min(parent.height - self.height,
                                        -sidebar-nav.viewport-y * (parent.height - self.height)
                                            / (parent.nav-viewport-height - parent.height)));
                                    width: 4px;
                                    height: parent.nav-thumb-height;
                                    border-radius: 999px;
                                    background: #E7E4DC;
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 42px;
                        Rectangle {
                            y: 8px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.hairline;
                        }
                        HorizontalLayout {
                            padding-top: 14px; padding-bottom: 6px; padding-left: 10px; padding-right: 10px;
                            spacing: 10px;
                            alignment: start;
                            Image {
                                source: Icons.gear;
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                            }
                            Text {
                                text: "设置";
                                font-size: 13.5px;
                                font-weight: 500;
                                color: Palette.strong;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            StatusDot {
                                tone: root.daemon-state == "后台服务已连接" || root.daemon-state == "后台服务已自动启动" ? "success" : "warning";
                                y: (parent.height - 7px) / 2 + 4px;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.settings-searched("");
                                root.settings-open = true;
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
                Rectangle {
                    y: 46px;
                    height: 0.67px;
                    width: parent.width;
                    background: Palette.border;
                }
            }
            Rectangle {
                visible: root.sidebar-visible;
                width: root.sidebar-visible ? 1px : 0px;
                background: sbt.has-hover || sbt.pressed ? Palette.accent : Palette.border;
                z: 10;
                sbt := TouchArea {
                    x: -3px;
                    width: 7px;
                    moved => {
                        root.sidebar-width = Math.max(196px, Math.min(420px,
                            root.sidebar-width + (self.mouse-x - self.pressed-x)));
                    }
                    mouse-cursor: ew-resize;
                }
                Rectangle {
                    x: -8px;
                    y: 10px;
                    width: 24px;
                    height: 24px;
                    border-radius: 6px;
                    background: white;
                    border-width: 0.67px;
                    border-color: #E5E2DA;
                    drop-shadow-color: Palette.shadow;
                    drop-shadow-offset-y: 1px;
                    z: 10;
                    Image {
                        source: Icons.panel-left;
                        width: 14px;
                        height: 14px;
                        x: 5px;
                        y: 5px;
                    }
                    TouchArea {
                        clicked => { root.sidebar-visible = false }
                        mouse-cursor: pointer;
                    }
                }
            }
            Rectangle {
                min-width: 480px;
                horizontal-stretch: 1;
                background: Palette.surface;
                VerticalLayout {
                    Rectangle {
                        height: 46px;
                        background: rgba(250, 250, 249, 0.94);
                        TouchArea {
                            moved => { root.drag-window() }
                            clicked => { hs.focus(); }
                        }
                        HorizontalLayout {
                            padding-left: root.sidebar-visible ? 16px : 40px;
                            padding-right: 16px;
                            alignment: space-between;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if !root.title-editing : Text {
                                text: root.session-title;
                                font-size: 14.5px;
                                font-weight: 600;
                                letter-spacing: -0.25px;
                                color: Palette.ink;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if root.title-editing : LineEdit {
                                width: 240px;
                                text <=> root.session-title;
                                font-size: 14px;
                                accepted => {                                    root.rename-session(root.session-title);                                     root.title-editing = false;                                     hs.focus();                                }
                            }
                            ToolIcon {
                                source: Icons.pencil;
                                icon-size: 14px;
                                clicked => { root.title-editing = !root.title-editing }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            ToolIcon {
                                source: Icons.panel-right;
                                icon-size: 16px;
                                clicked => {
                                    root.close-composer-popups();
                                    root.set-code-panel-visible(!root.code-visible);
                                }
                            }
                            if !root.code-visible : HorizontalLayout {
                                spacing: 0px;
                                ToolIcon { source: Icons.minus; icon-size: 14px; clicked => { root.minimize-window() } }
                                ToolIcon { source: Icons.stop; icon-size: 12px; clicked => { root.toggle-maximize-window() } }
                                ToolIcon { source: Icons.close; icon-size: 14px; clicked => { root.close-window() } }
                            }
                        }
                        }
                        if !root.sidebar-visible : Rectangle {
                            x: 6px;
                            y: 10px;
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: #FEF8F4;
                            border-width: 0.67px;
                            border-color: Palette.accent-border;
                            drop-shadow-color: Palette.shadow;
                            drop-shadow-offset-y: 1px;
                            Image {
                                source: Icons.panel-left;
                                width: 14px;
                                height: 14px;
                                x: 5px;
                                y: 5px;
                            }
                            TouchArea {
                                clicked => { root.sidebar-visible = true }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        height: 38px;
                        background: Palette.tabbar;
                        HorizontalLayout {
                            padding-left: 24px;
                            spacing: 24px;
                            alignment: start;
                            Rectangle {
                                width: t1.width + 2px;
                                horizontal-stretch: 0;
                                t1 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "对话";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 500 : 700;
                                    color: root.trajectory-selected ? Palette.dim : Palette.accent-text;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? transparent : Palette.accent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = false; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                width: t2.width + 2px;
                                horizontal-stretch: 0;
                                t2 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "轨迹";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 700 : 500;
                                    color: root.trajectory-selected ? Palette.accent-text : Palette.dim;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? Palette.accent : transparent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = true; hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.tab-line;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if !root.trajectory-selected : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            if root.chat-empty : VerticalLayout {
                                padding-bottom: 120px;
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: center;
                                spacing: 14px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 16px;
                                        background: #FEF8F4;
                                        border-width: 0.67px;
                                        border-color: #F5D9C3;
                                        Image {
                                            source: Icons.logo;
                                            width: 26px;
                                            height: 26px;
                                            x: (parent.width - 26px) / 2;
                                            y: (parent.height - 26px) / 2;
                                        }
                                    }
                                }
                                Text {
                                    text: root.session-title;
                                    font-size: 17px;
                                    font-weight: 700;
                                    letter-spacing: -0.3px;
                                    color: Palette.ink;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    width: parent.width;
                                    text: "当前为新会话。工作空间已关联至 " + (root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path) + "。";
                                    font-size: 13px;
                                    color: Palette.dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "您可在下方工作空间栏点击「更换目录」调整路径。发送第一条指令后工作空间将锁定。";
                                    font-size: 11.5px;
                                    color: Palette.faint;
                                    horizontal-alignment: center;
                                }
                            }
                            ScrollView {
                                VerticalLayout {
                                    spacing: 24px;
                                    padding-top: 20px;
                                    padding-bottom: 160px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    if root.chat-time != "" : Text {
                                        text: root.chat-time;
                                        font-size: 11.5px;
                                        font-weight: 500;
                                        color: Palette.faint;
                                        horizontal-alignment: center;
                                    }
                                    if root.last-message != "" : HorizontalLayout {
                                        alignment: end;
                                        spacing: 10px;
                                        Rectangle {
                                            max-width: 560px;
                                            border-radius: 16px;
                                            background: Palette.bubble;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            drop-shadow-color: Palette.shadow;
                                            drop-shadow-offset-y: 1px;
                                            drop-shadow-blur: 0px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 6px;
                                                Text {
                                                    text: root.last-message;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    color: Palette.ink;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 999px;
                                            background: Palette.accent-bg;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            Image {
                                                source: Icons.person-amber;
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                            }
                                        }
                                    }
                                    if root.assistant-text != "" : HorizontalLayout {
                                        alignment: start;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 999px;
                                            background: Palette.accent-bg;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            drop-shadow-color: Palette.shadow;
                                            drop-shadow-offset-y: 1px;
                                            drop-shadow-blur: 0px;
                                            Image {
                                                source: Icons.logo;
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                            }
                                        }
                                        Text {
                                            text: root.assistant-text;
                                            font-size: 13.5px;
                                            color: Palette.body;
                                            wrap: word-wrap;
                                            vertical-alignment: top;
                                        }
                                    }
                                    if root.conversation-workflow.length > 0 : Rectangle {
                                        border-radius: 12px;
                                        background: Palette.white;
                                        border-width: 0.67px;
                                        border-color: Palette.border;
                                        drop-shadow-color: Palette.shadow;
                                        drop-shadow-offset-y: 1px;
                                        drop-shadow-blur: 0px;
                                        VerticalLayout {
                                            padding: 16px;
                                            HorizontalLayout {
                                                padding-bottom: 12px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 24px;
                                                    alignment: start;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Text { text: "🕒"; font-size: 12px; vertical-alignment: center; }
                                                        Text {
                                                            text: "已工作 ";
                                                            font-size: 12px;
                                                            font-weight: 500;
                                                            color: Palette.dim;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.workflow-duration;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            color: Palette.ink;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.search; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "已探索 " + root.workflow-explored + " 项"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.terminal; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "已运行 " + root.workflow-ran + " 条命令"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image { source: Icons.check-circle-green; width: 14px; height: 14px; y: 2px; }
                                                        Text { text: "完成任务 " + root.workflow-done + "/1"; font-size: 12px; font-weight: 500; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: end;
                                                    Text {
                                                        text: root.conversation-workflow-expanded ? "收起步骤" : "展开步骤";
                                                        font-size: 11.5px;
                                                        font-weight: 500;
                                                        color: Palette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                    ToolIcon {
                                                        source: root.conversation-workflow-expanded ? Icons.chev-down : Icons.chev-right-faint;
                                                        icon-size: 14px;
                                                        clicked => { root.conversation-workflow-expanded = !root.conversation-workflow-expanded }
                                                    }
                                                }
                                            }
                                            if root.conversation-workflow-expanded : Rectangle {
                                                VerticalLayout {
                                                    for step[index] in root.conversation-workflow : WorkflowStepRow {
                                                        item: step;
                                                    }
                                                }
                                                Rectangle {
                                                    x: 58.5px;
                                                    y: 18px;
                                                    width: 1px;
                                                    height: parent.height - 26px;
                                                    background: Palette.border;
                                                    z: -1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            composer := Rectangle {
                                y: parent.height - 164px;
                                width: parent.width;
                                height: 164px;
                                background: @linear-gradient(0deg, rgba(250, 250, 249, 1) 0%, rgba(250, 250, 249, 0.92) 55%, rgba(250, 250, 249, 0) 100%);
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: Math.min(760px, parent.width - 48px);
                                        height: 130px;
                                        vertical-stretch: 0;
                                        y: 18px;
                                        VerticalLayout {
                                            spacing: 7px;
                                            WorkspaceStatusBar {
                                                group-name: root.workspace-group;
                                                project-name: root.workspace-project;
                                                short-path: root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path;
                                                has-git: root.workspace-has-git;
                                                branch-name: root.workspace-branch;
                                                indexed-files: root.workspace-indexed-files;
                                                locked: root.workspace-locked;
                                                change-workspace => { root.open-change-workspace() }
                                            }
                                            Rectangle {
                                                border-radius: 16px;
                                                background: Palette.white;
                                                border-width: 0.67px;
                                                border-color: Palette.border;
                                                drop-shadow-color: rgba(0, 0, 0, 0.1);
                                                drop-shadow-offset-y: 8px;
                                                drop-shadow-offset-x: 0px;
                                                drop-shadow-blur: 14px;
                                                VerticalLayout {
                                                    padding: 12px;
                                                    Rectangle {
                                                        height: 34px;
                                                        composer-edit := TextInput {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            vertical-alignment: center;
                                                            text <=> root.composer-text;
                                                            font-size: 13.5px;
                                                            color: Palette.body;
                                                            accepted => {
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    hs.focus();
                                                                }
                                                            }
                                                        }
                                                        if root.composer-text == "" : Text {
                                                            y: 8px;
                                                            text: "提出后续修改要求";
                                                            font-size: 13.5px;
                                                            color: Palette.faint;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                            HorizontalLayout {
                                                padding-top: 4px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    ToolIcon {
                                                        source: Icons.doc;
                                                        icon-size: 16px;
                                                        clicked => {
                                                            root.close-composer-popups();
                                                            root.selected-attachment = root.choose-attachment(false);
                                                            if root.selected-attachment != "" {
                                                                root.composer-text = root.composer-text + " " + root.selected-attachment;
                                                            }
                                                        }
                                                    }
                                                    access-button := Rectangle {
                                                        width: 104px;
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.shield; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.access-mode; font-size: 12.5px; font-weight: 500; color: Palette.amber; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.access-menu-open {
                                                                    root.access-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.access-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: end;
                                                    context-button := Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        background: cta.has-hover ? Palette.sep : transparent;
                                                        Image {
                                                            source: Icons.spinner;
                                                            width: 15px;
                                                            height: 15px;
                                                            x: (parent.width - 15px) / 2;
                                                            y: (parent.height - 15px) / 2;
                                                        }
                                                        cta := TouchArea {
                                                            changed has-hover => {
                                                                root.context-button-hover = self.has-hover;
                                                                if self.has-hover {
                                                                    root.close-click-popups();
                                                                    root.context-close-pending = false;
                                                                    root.context-popover-open = true;
                                                                } else if !root.context-card-hover {
                                                                    root.context-close-pending = true;
                                                                }
                                                            }
                                                            clicked => {
                                                                root.close-click-popups();
                                                                root.context-close-pending = false;
                                                                root.context-popover-open = true;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    model-button := Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: root.model-name;
                                                                font-family: "Consolas";
                                                                font-size: 12px;
                                                                font-weight: 500;
                                                                color: Palette.strong;
                                                                vertical-alignment: center;
                                                            }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.model-menu-open {
                                                                    root.model-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.model-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    effort-button := Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.rocket; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.effort; font-size: 12.5px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.effort-menu-open {
                                                                    root.effort-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.effort-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 12px;
                                                        background: root.composer-text == "" ? Palette.bar-gray : Palette.accent;
                                                        drop-shadow-color: Palette.shadow;
                                                        drop-shadow-offset-y: 1px;
                                                        drop-shadow-blur: 2px;
                                                        Image {
                                                            source: Icons.send;
                                                            width: 16px;
                                                            height: 16px;
                                                            x: (parent.width - 16px) / 2;
                                                            y: (parent.height - 16px) / 2;
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.close-composer-popups();
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    hs.focus();
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.access-menu-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                access-button.absolute-position.x - parent.absolute-position.x));
                                            y: access-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 144px;
                                            height: 98px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                MenuOption {
                                                    label: "完全访问";
                                                    active: root.access-mode == "完全访问";
                                                    chosen => { root.access-mode = "完全访问"; root.access-menu-open = false; hs.focus(); }
                                                }
                                                MenuOption {
                                                    label: "受限访问";
                                                    active: root.access-mode == "受限访问";
                                                    chosen => { root.access-mode = "受限访问"; root.access-menu-open = false; hs.focus(); }
                                                }
                                                MenuOption {
                                                    label: "只读模式";
                                                    active: root.access-mode == "只读模式";
                                                    chosen => { root.access-mode = "只读模式"; root.access-menu-open = false; hs.focus(); }
                                                }
                                            }
                                        }
                                        if root.effort-menu-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                effort-button.absolute-position.x - parent.absolute-position.x + effort-button.width - self.width));
                                            y: effort-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 128px;
                                            height: 154px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 26px;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        height: parent.height;
                                                        text: "推理强度";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Palette.faint;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        y: parent.height - 0.67px;
                                                        width: parent.width;
                                                        height: 0.67px;
                                                        background: Palette.sep;
                                                    }
                                                }
                                                for opt in ["低", "标准", "高", "最高"] : MenuOption {
                                                    label: opt;
                                                    active: root.effort == opt;
                                                    chosen => { root.effort = opt; root.effort-menu-open = false; hs.focus(); }
                                                }
                                            }
                                        }
                                        if root.model-menu-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                model-button.absolute-position.x - parent.absolute-position.x + model-button.width - self.width));
                                            y: model-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 224px;
                                            height: Math.min(root.model-choices.length * 30px + 34px, 200px);
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 26px;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        height: parent.height;
                                                        text: "选择模型";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Palette.faint;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        y: parent.height - 0.67px;
                                                        width: parent.width;
                                                        height: 0.67px;
                                                        background: Palette.sep;
                                                    }
                                                }
                                                for choice in root.model-choices : MenuOption {
                                                    label: choice.label;
                                                    active: choice.model == root.model-name;
                                                    chosen => {
                                                        root.model-name = choice.model;
                                                        root.setting-main-model = choice.model;
                                                        root.model-menu-open = false;
                                                        hs.focus();
                                                    }
                                                }
                                            }
                                        }
                                        if root.slash-menu-visible && root.slash-commands.length > 0 : Rectangle {
                                            x: 12px;
                                            y: -Math.min(root.slash-commands.length * 44px + 8px, 240px) - 80px;
                                            width: parent.width - 24px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                for cmd in root.slash-commands : Rectangle {
                                                    height: 44px;
                                                    border-radius: 8px;
                                                    background: sta.has-hover ? Palette.sep : transparent;
                                                    Text {
                                                        x: 10px;
                                                        y: 5px;
                                                        text: "/" + cmd.command + "  " + cmd.usage;
                                                        font-family: "Consolas";
                                                        font-weight: 600;
                                                        font-size: 12.5px;
                                                        color: Palette.accent-text;
                                                    }
                                                    Text {
                                                        x: 10px;
                                                        y: 23px;
                                                        text: cmd.summary;
                                                        font-size: 11px;
                                                        color: Palette.dim;
                                                    }
                                                    sta := TouchArea {
                                                        clicked => {
                                                            root.composer-text = "/" + cmd.command + " ";
                                                            root.slash-menu-visible = false;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                            TouchArea { clicked => { root.slash-menu-visible = false } }
                                        }
                                        if root.context-popover-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                context-button.absolute-position.x - parent.absolute-position.x + context-button.width - self.width));
                                            y: context-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 320px;
                                            height: 353px;
                                            background: Palette.white;
                                            border-radius: 16px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -6px;
                                            drop-shadow-blur: 20px;
                                            VerticalLayout {
                                                padding: 16px;
                                                spacing: 12px;
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text {
                                                        text: "上下文容量";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: Palette.ink;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.trace-total-label + " tokens";
                                                        font-family: "Consolas";
                                                        font-size: 11.5px;
                                                        color: Palette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle {
                                                    height: 8px;
                                                    border-radius: 999px;
                                                    background: #F3F4F6;
                                                    Rectangle {
                                                        x: 0px;
                                                        y: 0px;
                                                        width: Math.max(2px, parent.width * clamp(root.prompt-share(), 1, 100) / 100);
                                                        height: 8px;
                                                        border-radius: 999px;
                                                        background: #F5A623;
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #3B82F6; y: (parent.height - 8px) / 2; }
                                                            Text { text: "消息 / Prompt"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-input-tokens + " (" + root.prompt-share() + "%)"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #60A5FA; y: (parent.height - 8px) / 2; }
                                                            Text { text: "模型生成 / Completion"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-output-tokens + " (" + root.completion-share() + "%)"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #93C5FD; y: (parent.height - 8px) / 2; }
                                                            Text { text: "对话轮次"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-turns + " 轮"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #BFDBFE; y: (parent.height - 8px) / 2; }
                                                            Text { text: "模型调用"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-calls + " 次"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #DBEAFE; y: (parent.height - 8px) / 2; }
                                                            Text { text: "透镜事件"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-total + " 条"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #E5E7EB; y: (parent.height - 8px) / 2; }
                                                            Text { text: "缓存命中"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: "模型未提供"; font-family: "Consolas"; font-size: 11px; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                }
                                                Rectangle { height: 0.67px; background: Palette.sep; }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "当前模型"; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                                                    Text { text: root.model-name; font-family: "Consolas"; font-size: 11px; font-weight: 600; color: Palette.ink; overflow: elide; vertical-alignment: center; }
                                                }
                                                Rectangle { height: 0.67px; background: Palette.sep; }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        Text { text: "剩余额度"; font-size: 12px; font-weight: 700; color: Palette.ink; vertical-alignment: center; }
                                                        Text { text: "实时数据"; font-size: 11px; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    Text {
                                                        text: "当前模型提供方未返回额度信息";
                                                        font-size: 11px;
                                                        color: Palette.dim;
                                                    }
                                                }
                                            }
                                            context-card-touch := TouchArea {
                                                changed has-hover => {
                                                    root.context-card-hover = self.has-hover;
                                                    if self.has-hover {
                                                        root.context-close-pending = false;
                                                    } else if !root.context-button-hover {
                                                        root.context-close-pending = true;
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                    }
                                }
                            }

                                if root.trace-filter-open : Rectangle {
                                x: parent.width - 150px;
                                y: 44px;
                                width: 140px;
                                background: Palette.white;
                                border-radius: 12px;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                drop-shadow-color: rgba(0, 0, 0, 0.14);
                                drop-shadow-offset-y: 5px;
                                drop-shadow-blur: 14px;
                                VerticalLayout {
                                    padding: 4px;
                                    for opt in ["全部", "USER", "CONTEXT", "ASSISTANT", "TOOL"] : MenuOption {
                                        label: opt == "全部" ? "全部" : opt;
                                        active: root.trace-filter-index == (opt == "全部" ? 0 : opt == "USER" ? 1 : opt == "CONTEXT" ? 2 : opt == "ASSISTANT" ? 3 : 4);
                                        chosen => {
                                            root.trace-filter-index = opt == "USER" ? 1 : opt == "CONTEXT" ? 2 : opt == "ASSISTANT" ? 3 : opt == "TOOL" ? 4 : 0;
                                            root.trace-page = 1;
                                            root.trace-filter-open = false;
                                            root.refresh-trace();
                                        }
                                    }
                                }
                                TouchArea { clicked => { root.trace-filter-open = false } }
                            }
}
if root.trajectory-selected : TrajectoryPanel {
    width: parent.width;
    height: parent.height;
    trace-events: root.trace-events;
    gantt: root.gantt;
    trace-ticks: root.trace-ticks;
    model-name: root.model-name;
    access-mode: root.access-mode;
    effort: root.effort;
    assistant-text: root.assistant-text;
    setting-command-approval: root.setting-command-approval;
    trace-duration: root.trace-duration;
    trace-provider: root.trace-provider;
    trace-model: root.trace-model;
    trace-result: root.trace-result;
    trace-total-label: root.trace-total-label;
    trace-prompt-label: root.trace-prompt-label;
    trace-completion-label: root.trace-completion-label;
    trace-turns: root.trace-turns;
    trace-calls: root.trace-calls;
    trace-total: root.trace-total;
    trace-pages: root.trace-pages;
    trace-search <=> root.trace-search;
    trace-selected-num <=> root.trace-selected-num;
    request-tab <=> root.request-tab;
    trace-filter-index <=> root.trace-filter-index;
    trace-page <=> root.trace-page;
    trace-page-size <=> root.trace-page-size;
    trace-filter-open <=> root.trace-filter-open;
    refresh-trace => { root.refresh-trace(); }
    export-trace => { root.export-trace(); }
    page-range-label => { root.page-range-label() }
}
}
}
}

            // The right projection is a sibling of the center workspace. Its slot
            // collapses with the native window, so no hidden background is reserved.
            CodePanelSlot {
                code-visible: root.code-visible;
                host-width: root.width;
                sidebar-visible: root.sidebar-visible;
                sidebar-width: root.sidebar-width;
                project-files: root.project-files;
                code-lines: root.code-lines;
                preview-lines: root.preview-lines;
                file-added-lines: root.file-added-lines;
                selected-file-name: root.selected-file-name;
                preview-content: root.preview-content;
                status-text: root.status-text;
                trace-result: root.trace-result;
                assistant-text: root.assistant-text;
                code-panel-width <=> root.code-panel-width;
                file-preview-selected <=> root.file-preview-selected;
                code-menu-open <=> root.code-menu-open;
                file-menu-open <=> root.file-menu-open;
                copy-notice-visible <=> root.copy-notice-visible;
                preview-search <=> root.preview-search;
                issues-open <=> root.issues-open;
                return-focus => { hs.focus(); }
                drag-window => { root.drag-window(); }
                minimize-window => { root.minimize-window(); }
                toggle-maximize-window => { root.toggle-maximize-window(); }
                close-window => { root.close-window(); }
                set-code-panel-visible(visible) => { root.set-code-panel-visible(visible); }
                select-project-file(index) => { root.select-project-file(index); }
                reconcile => { root.reconcile(); }
                copy-text(value) => { root.copy-text(value); }
                filter-preview(value) => { root.filter-preview(value); }
            }
        }
    }
    hs := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-session();
                accept
            } else if event.modifiers.control && event.text == "," {
                root.settings-searched("");
                root.settings-open = true;
                accept
            } else if event.modifiers.control && event.modifiers.shift && (event.text == "p" || event.text == "P") {
                root.composer-text = "/";
                root.slash-query-changed("/");
                accept
            } else if event.text == "\u{1b}" || event.text == "Escape" {
                if root.create-navigation-open {
                    root.create-navigation-open = false;
                    accept
                } else if root.change-workspace-open {
                    root.change-workspace-open = false;
                    accept
                } else if root.settings-open {
                    root.cancel-settings();
                    root.settings-open = false;
                    hs.focus();
                    accept
                } else if root.access-menu-open || root.model-menu-open || root.effort-menu-open || root.slash-menu-visible || root.trace-filter-open || root.code-menu-open || root.issues-open || root.file-menu-open || root.context-popover-open {
                    root.access-menu-open = false;
                    root.model-menu-open = false;
                    root.effort-menu-open = false;
                    root.slash-menu-visible = false;
                    root.trace-filter-open = false;
                    root.code-menu-open = false;
                    root.issues-open = false;
                    root.file-menu-open = false;
                    root.context-popover-open = false;
                    accept
                } else { reject }
            } else { reject }
        }
    }

    if root.create-navigation-open : Rectangle {
        background: rgba(0, 0, 0, 0.35);
        TouchArea {
            clicked => { root.create-navigation-open = false }
        }
        Rectangle {
            width: 520px;
            height: root.create-navigation-kind == "分组" ? 230px : 451px;
            y: (parent.height - self.height) / 2;
            x: parent.width / 2 - self.width / 2;
            border-radius: 16px;
            background: Palette.white;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.25);
            drop-shadow-offset-y: 20px;
            drop-shadow-blur: 50px;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 16px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 8px;
                                background: #FEF8F4;
                                border-width: 0.67px;
                                border-color: #F5D9C3;
                                Image {
                                    source: Icons.sparkles;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - 14px) / 2;
                                    y: (parent.height - 14px) / 2;
                                }
                            }
                            Text {
                                text: root.create-navigation-kind == "会话" ? "新建会话设置" : root.create-navigation-kind == "项目" ? "新建项目设置" : "新建分组";
                                font-size: 15px;
                                font-weight: 700;
                                color: Palette.ink;
                                vertical-alignment: center;
                            }
                        }
                        ToolIcon {
                            source: Icons.close;
                            icon-size: 16px;
                            clicked => { root.create-navigation-open = false; hs.focus(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: root.create-navigation-kind == "会话" ? "会话名称" : root.create-navigation-kind == "项目" ? "项目名称" : "分组名称"; font-size: 12px; font-weight: 500; color: Palette.strong; }
                        LineEdit {
                            text <=> root.create-navigation-name;
                            placeholder-text: root.create-navigation-kind == "会话" ? "请输入会话名称..." : "请输入名称...";
                            font-size: 13px;
                        }
                    }
                    if root.create-navigation-kind != "分组" : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "所属分组"; font-size: 12px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                            Text { text: root.create-navigation-kind == "会话" ? "会话归类分组" : "项目归类分组"; font-size: 11px; color: Palette.faint; vertical-alignment: center; }
                        }
                        SelectBox {
                            width: parent.width;
                            value: root.create-navigation-group == "" ? (root.group-options.length > 0 ? root.group-options[0] : "默认") : root.create-navigation-group;
                            options: root.group-options;
                            selected(i, o) => { root.create-navigation-group = o }
                        }
                    }
                    if root.create-navigation-kind != "分组" : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "项目工作目录（项目空间）"; font-size: 12px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                            Text { text: "目录末尾即项目名称"; font-size: 11px; color: Palette.faint; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                clip: true;
                                TextInput {
                                    x: 14px;
                                    width: parent.width - 22px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: Palette.ink;
                                    text <=> root.create-navigation-workspace;
                                }
                            }
                            Rectangle {
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.sep;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 5px;
                                    alignment: center;
                                    Image { source: Icons.folder; width: 13px; height: 13px; y: (parent.height - 13px) / 2; }
                                    Text { text: "浏览..."; font-size: 12px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.create-navigation-workspace = root.choose-attachment(true);
                                        hs.focus();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                Text { text: "识别项目:"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                Rectangle {
                                    height: 19px;
                                    border-radius: 4px;
                                    background: Palette.sep;
                                    border-width: 0.67px;
                                    border-color: Palette.border;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.identify-project(root.create-navigation-workspace);
                                            font-family: "Consolas";
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            color: Palette.ink;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                if root.project-in-group(root.create-navigation-group, root.create-navigation-workspace) : HorizontalLayout {
                                    spacing: 4px;
                                    Image { source: Icons.check-green; width: 11px; height: 11px; y: 4px; }
                                    Text {
                                        text: "已归属于「" + root.create-navigation-group + "」下的已有项目";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Palette.green;
                                        vertical-alignment: center;
                                    }
                                }
                                if !root.project-in-group(root.create-navigation-group, root.create-navigation-workspace) : HorizontalLayout {
                                    spacing: 4px;
                                    Image { source: Icons.plus-dim; width: 11px; height: 11px; y: 4px; }
                                    Text {
                                        text: "将在「" + root.create-navigation-group + "」下自动新建该项目";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Palette.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            padding-top: 4px;
                            Text { text: "常用项目空间快捷选择:"; font-size: 11px; color: Palette.faint; }
                            HorizontalLayout {
                                spacing: 6px;
                                for preset[pi] in root.workspace-presets : Rectangle {
                                    visible: pi < 4;
                                    height: 22px;
                                    border-radius: 8px;
                                    background: preset.path == root.create-navigation-workspace ? #FEF8F4 : Palette.surface;
                                    border-width: 0.67px;
                                    border-color: preset.path == root.create-navigation-workspace ? Palette.accent : Palette.border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: preset.name;
                                            font-family: "Consolas";
                                            font-size: 10.5px;
                                            font-weight: preset.path == root.create-navigation-workspace ? 600 : 400;
                                            color: preset.path == root.create-navigation-workspace ? Palette.accent : Palette.mid;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.create-navigation-workspace = preset.path;
                                            root.create-navigation-group = preset.group-title;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                    if root.create-navigation-error != "" : Text {
                        text: root.create-navigation-error;
                        font-size: 11.5px;
                        color: Palette.red;
                    }
                }
                Rectangle {
                    height: 60px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-right: 24px;
                        padding-left: 24px;
                        spacing: 12px;
                        alignment: end;
                        Rectangle {
                            width: 76px;
                            height: 36px;
                            border-radius: 12px;
                            background: transparent;
                            border-width: 0.67px;
                            border-color: Palette.border;
                            HorizontalLayout { alignment: center; Text { text: "取消"; font-size: 13px; font-weight: 500; color: Palette.mid; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { root.create-navigation-open = false; hs.focus(); }
                                mouse-cursor: pointer;
                            }
                        }
                        Rectangle {
                            width: 132px;
                            height: 36px;
                            border-radius: 12px;
                            background: Palette.accent;
                            HorizontalLayout { alignment: center; Text { text: root.create-navigation-kind == "会话" ? "创建并进入会话" : "创建"; font-size: 13px; font-weight: 600; color: white; vertical-alignment: center; } }
                            TouchArea {
                                clicked => {
                                    if root.create-navigation(root.create-navigation-kind, root.create-navigation-name,
                                            root.create-navigation-group, root.create-navigation-workspace) {
                                        root.create-navigation-open = false;
                                        hs.focus();
                                    }
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        y: 0px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
            }
        }
    }
    if root.change-workspace-open : Rectangle {
        background: rgba(0, 0, 0, 0.35);
        TouchArea {
            clicked => { root.change-workspace-open = false }
        }
        Rectangle {
            width: 480px;
            y: parent.height / 2 - self.preferred-height / 2 - 40px;
            x: parent.width / 2 - self.width / 2;
            border-radius: 16px;
            background: Palette.white;
            border-width: 0.67px;
            border-color: Palette.border;
            drop-shadow-color: rgba(0, 0, 0, 0.25);
            drop-shadow-offset-y: 20px;
            drop-shadow-blur: 50px;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 16px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Image { source: Icons.folder; width: 16px; height: 16px; y: (parent.height - 16px) / 2; }
                            Text { text: "更换当前会话工作空间目录"; font-size: 14.5px; font-weight: 700; color: Palette.ink; vertical-alignment: center; }
                        }
                        ToolIcon {
                            source: Icons.close;
                            icon-size: 16px;
                            clicked => { root.change-workspace-open = false; hs.focus(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 0.67px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "当前会话尚未开始，您可以自定义工作空间路径。会话开始执行后，工作空间目录将锁定。";
                        font-size: 12px;
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "工作空间物理路径"; font-size: 12px; font-weight: 500; color: Palette.strong; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.input;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                clip: true;
                                TextInput {
                                    x: 14px;
                                    width: parent.width - 22px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: Palette.ink;
                                    text <=> root.change-workspace-path;
                                }
                            }
                            Rectangle {
                                height: 34px;
                                border-radius: 12px;
                                background: Palette.sep;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text { text: "浏览..."; font-size: 12px; font-weight: 500; color: Palette.mid; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => { root.change-workspace-path = root.choose-attachment(true); hs.focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "常用项目空间:"; font-size: 11.5px; color: Palette.dim; }
                        for preset in root.workspace-presets : Rectangle {
                            height: 32px;
                            border-radius: 10px;
                            background: preset.path == root.change-workspace-path ? #FEF8F4 : Palette.surface;
                            border-width: 0.67px;
                            border-color: preset.path == root.change-workspace-path ? Palette.accent : Palette.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text { text: preset.name; font-size: 11.5px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                Text { text: preset.path; font-family: "Consolas"; font-size: 10px; color: Palette.dim; overflow: elide; vertical-alignment: center; }
                            }
                            TouchArea {
                                clicked => { root.change-workspace-path = preset.path }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    background: #FAF9F6;
                    HorizontalLayout {
                        padding-right: 24px;
                        padding-left: 24px;
                        spacing: 12px;
                        alignment: end;
                        Rectangle {
                            width: 76px;
                            height: 34px;
                            border-radius: 12px;
                            background: transparent;
                            border-width: 0.67px;
                            border-color: Palette.border;
                            HorizontalLayout { alignment: center; Text { text: "取消"; font-size: 12.5px; font-weight: 500; color: Palette.mid; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { root.change-workspace-open = false; hs.focus(); }
                                mouse-cursor: pointer;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 34px;
                            border-radius: 12px;
                            background: Palette.accent;
                            HorizontalLayout { alignment: center; Text { text: "确认更换"; font-size: 12.5px; font-weight: 600; color: white; vertical-alignment: center; } }
                            TouchArea {
                                clicked => {
                                    root.confirm-change-workspace(root.change-workspace-path);
                                    root.change-workspace-open = false;
                                    hs.focus();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        y: 0px;
                        height: 0.67px;
                        width: parent.width;
                        background: Palette.hairline;
                    }
                }
            }
        }
    }
    if root.settings-open : SettingsOverlay {
        settings-search <=> root.settings-search;
        settings-page <=> root.settings-page;
        settings-open <=> root.settings-open;
        model-name <=> root.model-name;
        provider-kind <=> root.provider-kind;
        account-field <=> root.account-field;
        agent-options: root.agent-options;
        setting-accent <=> root.setting-accent;
        setting-autosave <=> root.setting-autosave;
        setting-channel <=> root.setting-channel;
        setting-cloud-sync <=> root.setting-cloud-sync;
        setting-command-approval <=> root.setting-command-approval;
        setting-dark-theme <=> root.setting-dark-theme;
        setting-density <=> root.setting-density;
        setting-desktop-notifications <=> root.setting-desktop-notifications;
        setting-email <=> root.setting-email;
        setting-file-access <=> root.setting-file-access;
        setting-font-scale <=> root.setting-font-scale;
        setting-git <=> root.setting-git;
        setting-high-risk <=> root.setting-high-risk;
        setting-index-mode <=> root.setting-index-mode;
        setting-language <=> root.setting-language;
        setting-main-model <=> root.setting-main-model;
        setting-message-alerts <=> root.setting-message-alerts;
        setting-network <=> root.setting-network;
        setting-nickname <=> root.setting-nickname;
        setting-notifications <=> root.setting-notifications;
        setting-provider <=> root.setting-provider;
        setting-provider-auth <=> root.setting-provider-auth;
        setting-provider-credential <=> root.setting-provider-credential;
        setting-provider-endpoint <=> root.setting-provider-endpoint;
        setting-provider-protocol <=> root.setting-provider-protocol;
        setting-provider-secret <=> root.setting-provider-secret;
        setting-provider-thinking <=> root.setting-provider-thinking;
        setting-quiet-hours <=> root.setting-quiet-hours;
        setting-reasoning <=> root.setting-reasoning;
        setting-startup <=> root.setting-startup;
        setting-workspace <=> root.setting-workspace;
        setting-workspace-sync <=> root.setting-workspace-sync;
        return-focus => { hs.focus(); }
        accent-hex(i) => { root.accent-hex(i) }
        accent-name(i) => { root.accent-name(i) }
        approval-selected => { root.approval-selected() }
        cancel-settings => { root.cancel-settings(); }
        choose-attachment(dir) => { root.choose-attachment(dir) }
        effort-selected => { root.effort-selected() }
        reset-settings => { root.reset-settings(); }
        save-settings => { root.save-settings(); }
        settings-searched(text) => { root.settings-searched(text); }
        startup-selected => { root.startup-selected() }
        store-provider-secret(provider, secret) => { root.store-provider-secret(provider, secret); }
        test-provider(provider) => { root.test-provider(provider); }
        setting-provider-at(i) => { root.setting-provider-at(i) }
        setting-model-at(i) => { root.setting-model-at(i) }
    }
}
