import { LineEdit, ScrollView } from "std-widgets.slint";
import { ModelChoice, TimelineItem, SlashCommandItem, ProjectFile, GanttSegment, TraceEvent, ChatBlock } from "tokmon-models.slint";
import { Palette, Icons } from "tokmon-theme.slint";
import { ToolIcon, MenuOption, WorkflowStepRow, ThoughtProcessCard, ChatBlockRow } from "tokmon-components.slint";
import { TrajectoryPanel } from "tokmon-trajectory.slint";
import { EnvironmentPanel } from "tokmon-environment-panel.slint";
import { SessionEmptyState, ComposerContextTab } from "tokmon-session-initial.slint";

export component WorkspacePanel inherits Rectangle {
    in property <[TimelineItem]> conversation-workflow;
    in property <[SlashCommandItem]> slash-commands;
    in property <[ModelChoice]> model-choices;
    in property <[TraceEvent]> trace-events;
    in property <[GanttSegment]> gantt;
    in property <[string]> trace-ticks;
    in property <[ProjectFile]> project-files;
    in property <[ProjectFile]> workspace-presets;

    in-out property <string> session-title;
    in-out property <string> model-name;
    in-out property <string> access-mode;
    in-out property <string> effort;
    in-out property <string> composer-text;
    in property <string> last-message;
    in property <string> assistant-text;
    // Chain-of-thought text for the current turn, rendered by the collapsible
    // thought-process card above the assistant reply.
    in property <string> thought-text;
    // Parsed markdown blocks of the current assistant reply (md4c).
    in property <[ChatBlock]> assistant-blocks;
    in property <string> chat-time;
    in property <string> trace-duration;
    in property <string> workflow-duration;
    in property <string> trace-provider;
    in property <string> trace-model;
    in property <string> trace-result;
    in property <string> trace-total-label;
    in property <string> trace-prompt-label;
    in property <string> trace-completion-label;
    in-out property <string> trace-search;
    in-out property <string> selected-attachment;
    in property <string> setting-command-approval;
    in property <string> setting-provider;
    in-out property <string> setting-main-model;
    in property <string> setting-workspace;
    in property <string> workspace-group;
    in property <string> workspace-project;
    in-out property <string> workspace-short-path;
    in property <string> workspace-branch;

    in property <int> workspace-indexed-files;
    in property <bool> workspace-has-git;
    in property <bool> workspace-locked;
    in property <bool> chat-empty;
    in-out property <bool> environment-panel-open;
    in-out property <int> trace-selected-num;
    in-out property <int> trace-page;
    in-out property <int> trace-page-size;
    in property <int> trace-total;
    in property <int> trace-pages;
    in property <int> trace-turns;
    in property <int> trace-calls;
    in property <int> trace-input-tokens;
    in property <int> trace-output-tokens;
    in-out property <int> request-tab;
    in-out property <int> trace-filter-index;
    in property <int> workflow-explored;
    in property <int> workflow-ran;
    in property <int> workflow-done;

    in-out property <bool> sidebar-visible;
    in property <bool> code-visible;
    in-out property <bool> trajectory-selected;
    in-out property <bool> conversation-workflow-expanded;
    in-out property <bool> title-editing;
    out property <bool> title-confirm-hovered;
    property <string> title-edit-draft;
    property <bool> title-editor-focus-pending;
    property <bool> title-editor-exit-pending;
    in-out property <bool> access-menu-open;
    in-out property <bool> model-menu-open;
    in-out property <bool> effort-menu-open;
    in-out property <bool> slash-menu-visible;
    in-out property <bool> context-popover-open;
    in-out property <bool> context-button-hover;
    in-out property <bool> context-card-hover;
    in-out property <bool> context-close-pending;
    in-out property <bool> trace-filter-open;
    property <length> environment-button-x: -1px;
    property <length> environment-button-y: 48px;

    callback send-message(string);
    callback slash-query-changed(string);
    callback rename-session(string);
    callback choose-attachment(bool) -> string;
    callback refresh-trace();
    callback export-trace();
    callback drag-window();
    callback update-window-drag();
    callback end-window-drag();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback set-code-panel-visible(bool);
    callback open-change-workspace();
    callback switch-workspace(string);
    callback select-project-file(int);
    callback copy-text(string);
    callback refresh-workspace();
    callback open-workspace-settings();
    callback select-model(string, string);
    callback return-focus();

    pure function page-range-label() -> string {
        root.trace-total == 0 ? "显示 0 条，共 0 条"
            : "显示 " + ((root.trace-page - 1) * root.trace-page-size + 1) + "-" + Math.min(root.trace-total, root.trace-page * root.trace-page-size) + " 条，共 " + root.trace-total + " 条"
    }

    pure function prompt-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 :
            root.trace-input-tokens * 100 / (root.trace-input-tokens + root.trace-output-tokens)
    }

    pure function completion-share() -> int {
        root.trace-input-tokens + root.trace-output-tokens == 0 ? 0 : 100 - root.prompt-share()
    }

    function close-click-popups() {
        root.access-menu-open = false;
        root.model-menu-open = false;
        root.effort-menu-open = false;
        root.slash-menu-visible = false;
    }

    function close-composer-popups() {
        root.close-click-popups();
        root.context-popover-open = false;
        root.context-button-hover = false;
        root.context-card-hover = false;
        root.context-close-pending = false;
    }

    function begin-title-edit() {
        root.title-edit-draft = root.session-title;
        root.title-editor-exit-pending = false;
        // Explicitly focus the freshly-created editor. Without this, the first
        // click only focused it and a second click was needed to place the caret.
        root.title-editor-focus-pending = true;
        // Set the focus intent before instantiating the conditional editor so
        // its initial unfocused state is not mistaken for a user blur.
        root.title-editing = true;
    }

    function leave-title-edit() {
        if !root.title-editing {
            return;
        }
        // Saving is tied to the edit-state transition. This keeps transient
        // focus changes from becoming a second, independent save mechanism.
        root.title-editing = false;
        root.title-editor-focus-pending = false;
        root.title-editor-exit-pending = false;
        root.return-focus();
    }

    changed title-editing => {
        if !root.title-editing && root.title-edit-draft != "" {
            root.session-title = root.title-edit-draft;
            root.rename-session(root.title-edit-draft);
        }
    }

    function begin-titlebar-drag() {
        if root.title-editing {
            root.leave-title-edit();
        } else {
            root.return-focus();
        }
        root.drag-window();
    }

    pure function resolved-environment-button-x() -> length {
        Math.max(8px, Math.min(
            root.environment-button-x < 0px ? root.width - 64px : root.environment-button-x,
            root.width - 56px
        ))
    }

    pure function resolved-environment-button-y() -> length {
        Math.max(48px, Math.min(root.environment-button-y, root.height - 56px))
    }

    // Baseline width consumed by the edge-following rule below.
    property <length> environment-last-width: -1px;

    // When the middle column is resized — divider drags against either side
    // column or sidebar collapse/expand — a floating button resting close to
    // an edge rides along with that edge so its gap stays constant, matching
    // the prototype's absolute positioning. Interior positions keep their
    // workspace-relative offset.
    pure function follow-environment-edge(old-width: length) -> length {
        if old-width <= 0px || root.environment-button-x < 0px {
            // Sentinel keeps the dynamic default position, which already
            // tracks the right edge through resolved-environment-button-x().
            return root.environment-button-x;
        }
        let delta = root.width - old-width;
        if delta == 0px {
            return root.environment-button-x;
        }
        let resolved-old = Math.max(8px, Math.min(root.environment-button-x, old-width - 56px));
        let gap-left = resolved-old - 8px;
        let gap-right = old-width - resolved-old - 48px;
        if Math.min(gap-left, gap-right) > 96px {
            return root.environment-button-x;
        }
        if gap-right <= gap-left {
            return Math.max(8px, Math.min(resolved-old + delta, root.width - 56px));
        }
        return root.environment-button-x;
    }

    changed width => {
        root.environment-button-x = root.follow-environment-edge(root.environment-last-width);
        root.environment-last-width = root.width;
    }

                min-width: 480px;
                horizontal-stretch: 1;
                background: Palette.surface;
                VerticalLayout {
                    Rectangle {
                        height: 46px;
                        background: rgba(250, 250, 249, 0.94);
                        header-content := HorizontalLayout {
                            padding-left: root.sidebar-visible ? 16px : 40px;
                            padding-right: 16px;
                            spacing: 0px;
                            alignment: start;
                        title-actions := HorizontalLayout {
                            // Give the hit-test geometry the same bounded width as
                            // the rendered content. Without an explicit width this
                            // nested layout can report only its minimum width and a
                            // neighboring drag zone would cover the pencil/input.
                            width: root.title-editing
                                ? 240px
                                // The label has an explicit bounded width. Add only
                                // the 8px gap and the pencil's 26px minimum width so
                                // the adjacent drag region starts immediately after
                                // the visible controls instead of leaving a dead zone.
                                : Math.min(300px, session-title-label.preferred-width) + 34px;
                            horizontal-stretch: 0;
                            spacing: root.title-editing ? 0px : 8px;
                            alignment: start;
                            session-title-label := Text {
                                visible: !root.title-editing;
                                width: root.title-editing
                                    ? 0px
                                    : Math.min(300px, self.preferred-width);
                                text: root.session-title;
                                font-size: 14.5px;
                                font-weight: 600;
                                letter-spacing: -0.25px;
                                color: Palette.ink;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if root.title-editing : HorizontalLayout {
                                width: 240px;
                                height: 32px;
                                vertical-stretch: 0;
                                y: (title-actions.height - self.height) / 2;
                                spacing: 4px;
                                // Keep the editor above the adjacent native drag
                                // region so clicks always reach the TextInput.
                                z: 10;
                                Timer {
                                    interval: 1ms;
                                    running: root.title-editor-focus-pending;
                                    triggered => {
                                        title-edit-input.focus();
                                        // Starting an edit should replace the current
                                        // title when the user types. A later click can
                                        // still place the caret for partial edits.
                                        title-edit-input.select-all();
                                        root.title-editor-focus-pending = false;
                                    }
                                }
                                Timer {
                                    // Let a pointer click finish before deciding whether
                                    // focus really moved outside the editor. This avoids
                                    // turning an internal caret click into a save.
                                    interval: 40ms;
                                    running: root.title-editor-exit-pending;
                                    triggered => {
                                        root.title-editor-exit-pending = false;
                                        if root.title-editing && !title-edit-input.has-focus {
                                            root.leave-title-edit();
                                        }
                                    }
                                }
                                input-frame := Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    clip: true;
                                    title-edit-input := LineEdit {
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> root.title-edit-draft;
                                        horizontal-alignment: left;
                                        font-size: 14px;
                                        accepted(value) => {
                                            root.leave-title-edit();
                                        }
                                        changed has-focus => {
                                            if self.has-focus {
                                                root.title-editor-exit-pending = false;
                                            } else if root.title-editing && !root.title-editor-focus-pending {
                                                root.title-editor-exit-pending = true;
                                            }
                                        }
                                    }
                                    // LineEdit includes a style-provided clear button.
                                    // Mask and intercept that area so title editing exposes
                                    // exactly one action: the confirmation button below.
                                    Rectangle {
                                        x: parent.width - 31px;
                                        y: 1px;
                                        width: 30px;
                                        height: parent.height - 2px;
                                        background: Palette.white;
                                        z: 20;
                                        TouchArea {
                                            clicked => { title-edit-input.focus(); }
                                            mouse-cursor: text;
                                        }
                                    }
                                }
                                confirm-title-button := ToolIcon {
                                    width: 27px;
                                    height: 28px;
                                    vertical-stretch: 0;
                                    source: Icons.check-small;
                                    icon-size: 12px;
                                    changed hovered => {
                                        root.title-confirm-hovered = self.hovered;
                                    }
                                    clicked => { root.leave-title-edit(); }
                                }
                            }
                            if !root.title-editing : edit-title-button := ToolIcon {
                                source: Icons.pencil;
                                icon-size: 14px;
                                clicked => { root.begin-title-edit(); }
                            }
                        }
                        // This is a real layout spacer, not an overlay. Therefore
                        // its TouchArea can only receive events from the visible
                        // blank space between the title controls and window buttons.
                        titlebar-blank-space := Rectangle {
                            min-width: 0px;
                            preferred-width: 100000px;
                            max-width: 100000px;
                            horizontal-stretch: 1;
                            TouchArea {
                                x: 0px;
                                y: 7px;
                                width: parent.width;
                                height: parent.height - self.y;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        root.begin-titlebar-drag();
                                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                        root.end-window-drag();
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.update-window-drag();
                                    }
                                }
                            }
                        }
                        window-actions := HorizontalLayout {
                            // 28px panel button + optional 4px gap and 76px native
                            // window controls. This keeps the right blank drag zone
                            // completely outside every hover/click target.
                            width: root.code-visible ? 28px : 108px;
                            horizontal-stretch: 0;
                            spacing: 4px;
                            alignment: end;
                            ToolIcon {
                                source: Icons.panel-right;
                                icon-size: 16px;
                                clicked => {
                                    root.close-composer-popups();
                                    root.set-code-panel-visible(!root.code-visible);
                                }
                            }
                            if !root.code-visible : HorizontalLayout {
                                spacing: 0px;
                                ToolIcon { source: Icons.minus; icon-size: 14px; clicked => { root.minimize-window() } }
                                ToolIcon { source: Icons.stop; icon-size: 12px; clicked => { root.toggle-maximize-window() } }
                                ToolIcon { source: Icons.close; icon-size: 14px; clicked => { root.close-window() } }
                            }
                        }
                        }
                        if !root.sidebar-visible : Rectangle {
                            x: 6px;
                            y: 10px;
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: #FEF8F4;
                            border-width: 0.67px;
                            border-color: Palette.accent-border;
                            drop-shadow-color: Palette.shadow;
                            drop-shadow-offset-y: 1px;
                            Image {
                                source: Icons.panel-left;
                                width: 14px;
                                height: 14px;
                                x: 5px;
                                y: 5px;
                            }
                            TouchArea {
                                clicked => { root.sidebar-visible = true }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                    Rectangle {
                        height: 38px;
                        background: Palette.tabbar;
                        HorizontalLayout {
                            padding-left: 24px;
                            spacing: 24px;
                            alignment: start;
                            Rectangle {
                                width: t1.width + 2px;
                                horizontal-stretch: 0;
                                t1 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "对话";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 500 : 700;
                                    color: root.trajectory-selected ? Palette.dim : Palette.accent-text;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? transparent : Palette.accent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = false; root.return-focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                            Rectangle {
                                width: t2.width + 2px;
                                horizontal-stretch: 0;
                                t2 := Text {
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "轨迹";
                                    font-size: 13.5px;
                                    font-weight: root.trajectory-selected ? 700 : 500;
                                    color: root.trajectory-selected ? Palette.accent-text : Palette.dim;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    width: parent.width;
                                    background: root.trajectory-selected ? Palette.accent : transparent;
                                }
                                TouchArea {
                                    clicked => { root.trajectory-selected = true; root.return-focus(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 0.67px;
                            height: 0.67px;
                            width: parent.width;
                            background: Palette.tab-line;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if !root.trajectory-selected : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            if root.chat-empty : SessionEmptyState {
                                width: parent.width;
                                height: parent.height;
                                workspace-project: root.workspace-project;
                                workspace-path: root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path;
                                starter-chosen(prompt) => {
                                    root.composer-text = prompt;
                                    composer-edit.focus();
                                }
                            }
                            if !root.chat-empty : ScrollView {
                                VerticalLayout {
                                    // Keep message rows constrained to the
                                    // viewport. Rich Markdown must wrap instead
                                    // of growing the scroll content horizontally.
                                    width: parent.width;
                                    spacing: 24px;
                                    padding-top: 20px;
                                    padding-bottom: 160px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    // The scroll viewport imposes its own minimum
                                    // height, so every content row must refuse the
                                    // extra space (vertical-stretch: 0) and the
                                    // trailing spring absorbs it. Otherwise the
                                    // layout spreads surplus height across rows,
                                    // inflating bubbles and gaps.
                                    if root.chat-time != "" : Text {
                                        text: root.chat-time;
                                        font-size: 11.5px;
                                        font-weight: 500;
                                        color: Palette.faint;
                                        horizontal-alignment: center;
                                        vertical-stretch: 0;
                                    }
                                    if root.last-message != "" : HorizontalLayout {
                                        alignment: end;
                                        vertical-stretch: 0;
                                        Rectangle {
                                            max-width: 560px;
                                            vertical-stretch: 0;
                                            border-radius: 16px;
                                            background: Palette.bubble;
                                            border-width: 0.67px;
                                            border-color: Palette.accent-border;
                                            drop-shadow-color: Palette.shadow;
                                            drop-shadow-offset-y: 1px;
                                            drop-shadow-blur: 0px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 6px;
                                                Text {
                                                    text: root.last-message;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    color: Palette.ink;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                    if root.thought-text != "" : ThoughtProcessCard {
                                        content: root.thought-text;
                                    }
                                    if root.assistant-blocks.length > 0 : VerticalLayout {
                                        spacing: 6px;
                                        vertical-stretch: 0;
                                        for blk in root.assistant-blocks : ChatBlockRow {
                                            block: blk;
                                        }
                                    }
                                    if root.assistant-text != "" && root.assistant-blocks.length == 0 : Text {
                                        text: root.assistant-text;
                                        font-size: 13.5px;
                                        color: Palette.body;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                        vertical-stretch: 0;
                                    }
                                    if root.conversation-workflow.length > 0 : Rectangle {
                                        border-radius: 12px;
                                        background: #F4F4F4;
                                        border-width: 0.67px;
                                        border-color: #E5E5E5;
                                        clip: true;
                                        vertical-stretch: 0;
                                        // Collapsed state mirrors the thought-process
                                        // card: one slim bar with a status dot, a
                                        // truncated summary and a chevron.
                                        if !root.conversation-workflow-expanded : Rectangle {
                                            height: 27px;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 999px;
                                                    background: Palette.green;
                                                    y: (parent.height - 6px) / 2;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.workflow-done > 0
                                                        ? "工作流执行完成 · 已探索 " + root.workflow-explored + " 项 · 运行 " + root.workflow-ran + " 条命令 · 任务 " + root.workflow-done + "/1 (用时 " + root.workflow-duration + ")"
                                                        : "工作流执行中 · 已探索 " + root.workflow-explored + " 项 · 运行 " + root.workflow-ran + " 条命令";
                                                    font-size: 12px;
                                                    color: #8E8E93;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Image {
                                                    source: Icons.chev-down;
                                                    width: 14px;
                                                    height: 14px;
                                                    y: (parent.height - 14px) / 2;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.conversation-workflow-expanded = true; }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                        if root.conversation-workflow-expanded : VerticalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-top: 13px;
                                            padding-bottom: 16px;
                                            spacing: 14px;
                                            Rectangle {
                                                height: 22px;
                                                HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 24px;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: start;
                                                        Rectangle {
                                                            width: 6px;
                                                            height: 6px;
                                                            border-radius: 999px;
                                                            background: Palette.green;
                                                            y: (parent.height - 6px) / 2;
                                                        }
                                                        Text {
                                                            text: "工作流执行";
                                                            font-size: 13.5px;
                                                            font-weight: 500;
                                                            color: #262626;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 16px;
                                                        alignment: start;
                                                        HorizontalLayout {
                                                            spacing: 4px;
                                                            alignment: start;
                                                            Text { text: "已工作"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                                            Text { text: root.workflow-duration; font-size: 11.5px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 4px;
                                                            alignment: start;
                                                            Text { text: "已探索"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                                            Text { text: root.workflow-explored + " 项"; font-size: 11.5px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 4px;
                                                            alignment: start;
                                                            Text { text: "已运行"; font-size: 11.5px; color: Palette.dim; vertical-alignment: center; }
                                                            Text { text: root.workflow-ran + " 条命令"; font-size: 11.5px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                                                        }
                                                        Text {
                                                            text: root.workflow-done + "/1 完成";
                                                            font-size: 11.5px;
                                                            font-weight: 600;
                                                            color: Palette.green;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    Rectangle { min-width: 0px; horizontal-stretch: 1; }
                                                    Image {
                                                        source: Icons.chev-down;
                                                        width: 15px;
                                                        height: 15px;
                                                        transform-rotation: 180deg;
                                                        y: (parent.height - 15px) / 2;
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { root.conversation-workflow-expanded = false; }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                            Rectangle {
                                                // Step timeline rows share the gray card,
                                                // with the connecting line behind the dots.
                                                VerticalLayout {
                                                    spacing: 7px;
                                                    for step[index] in root.conversation-workflow : WorkflowStepRow {
                                                        item: step;
                                                    }
                                                }
                                                Rectangle {
                                                    x: 58.5px;
                                                    y: 18px;
                                                    width: 1px;
                                                    height: parent.height - 26px;
                                                    background: #DFDEDA;
                                                    z: -1;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        // Absorbs any surplus scroll-viewport height so
                                        // the rows above keep their natural thickness.
                                        min-height: 0px;
                                        vertical-stretch: 1;
                                    }
                                }
                            }
                            composer := Rectangle {
                                // Keep an 8px bottom breathing space (half of the
                                // previous 16px gap) without changing input height.
                                y: parent.height - 156px;
                                width: parent.width;
                                height: 156px;
                                background: @linear-gradient(0deg, rgba(250, 250, 249, 1) 0%, rgba(250, 250, 249, 0.92) 55%, rgba(250, 250, 249, 0) 100%);
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: Math.min(760px, parent.width - 48px);
                                        height: 130px;
                                        vertical-stretch: 0;
                                        y: 18px;
                                        VerticalLayout {
                                            spacing: 0px;
                                            ComposerContextTab {
                                                z: 2;
                                                workspace-project: root.workspace-project;
                                                workspace-path: root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path;
                                                workspace-branch: root.workspace-branch;
                                                has-git: root.workspace-has-git;
                                                can-change-workspace: root.chat-empty && !root.workspace-locked;
                                                change-workspace => { root.open-change-workspace(); }
                                            }
                                            Rectangle {
                                                // Keep the composer surface above the workspace badge.
                                                // A menu's z value cannot escape its parent's stacking
                                                // context, which previously let the badge cover it.
                                                z: 3;
                                                border-radius: 16px;
                                                background: Palette.white;
                                                border-width: 0.67px;
                                                border-color: Palette.border;
                                                drop-shadow-color: rgba(0, 0, 0, 0.1);
                                                drop-shadow-offset-y: 8px;
                                                drop-shadow-offset-x: 0px;
                                                drop-shadow-blur: 14px;
                                                VerticalLayout {
                                                    padding: 12px;
                                                    Rectangle {
                                                        height: 34px;
                                                        composer-edit := TextInput {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            vertical-alignment: center;
                                                            text <=> root.composer-text;
                                                            font-size: 13.5px;
                                                            color: Palette.body;
                                                            accepted => {
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    root.return-focus();
                                                                }
                                                            }
                                                        }
                                                        if root.composer-text == "" : Text {
                                                            x: 0px;
                                                            y: 8px;
                                                            width: parent.width;
                                                            text: root.chat-empty ? "随心输入需求，或点击上方卡片快速开始..." : "提出后续修改要求";
                                                            font-size: 13.5px;
                                                            color: Palette.faint;
                                                            horizontal-alignment: left;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                            HorizontalLayout {
                                                padding-top: 4px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    ToolIcon {
                                                        source: Icons.doc;
                                                        icon-size: 16px;
                                                        clicked => {
                                                            root.close-composer-popups();
                                                            root.selected-attachment = root.choose-attachment(false);
                                                            if root.selected-attachment != "" {
                                                                root.composer-text = root.composer-text + " " + root.selected-attachment;
                                                            }
                                                        }
                                                    }
                                                    access-button := Rectangle {
                                                        width: 104px;
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.shield; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.access-mode; font-size: 12.5px; font-weight: 500; color: Palette.amber; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.access-menu-open {
                                                                    root.access-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.access-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: end;
                                                    context-button := Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        background: cta.has-hover ? Palette.sep : transparent;
                                                        Image {
                                                            source: Icons.spinner;
                                                            width: 15px;
                                                            height: 15px;
                                                            x: (parent.width - 15px) / 2;
                                                            y: (parent.height - 15px) / 2;
                                                        }
                                                        cta := TouchArea {
                                                            changed has-hover => {
                                                                root.context-button-hover = self.has-hover;
                                                                if self.has-hover {
                                                                    root.close-click-popups();
                                                                    root.context-close-pending = false;
                                                                    root.context-popover-open = true;
                                                                } else if !root.context-card-hover {
                                                                    root.context-close-pending = true;
                                                                }
                                                            }
                                                            clicked => {
                                                                root.close-click-popups();
                                                                root.context-close-pending = false;
                                                                root.context-popover-open = true;
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    model-button := Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: root.setting-provider + " · " + root.model-name;
                                                                font-family: "Consolas";
                                                                font-size: 12px;
                                                                font-weight: 500;
                                                                color: Palette.strong;
                                                                vertical-alignment: center;
                                                            }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.model-menu-open {
                                                                    root.model-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.model-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    effort-button := Rectangle {
                                                        height: 28px;
                                                        border-radius: 8px;
                                                        horizontal-stretch: 0;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Image { source: Icons.rocket; width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
                                                            Text { text: root.effort; font-size: 12.5px; font-weight: 500; color: Palette.strong; vertical-alignment: center; }
                                                            Image { source: Icons.chev-down-faint; width: 10px; height: 6px; y: (parent.height - 6px) / 2; }
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                if root.effort-menu-open {
                                                                    root.effort-menu-open = false;
                                                                } else {
                                                                    root.close-composer-popups();
                                                                    root.effort-menu-open = true;
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 12px;
                                                        background: root.composer-text == "" ? Palette.bar-gray : Palette.accent;
                                                        drop-shadow-color: Palette.shadow;
                                                        drop-shadow-offset-y: 1px;
                                                        drop-shadow-blur: 2px;
                                                        Image {
                                                            source: Icons.send;
                                                            width: 16px;
                                                            height: 16px;
                                                            x: (parent.width - 16px) / 2;
                                                            y: (parent.height - 16px) / 2;
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.close-composer-popups();
                                                                if root.composer-text != "" {
                                                                    root.send-message(root.composer-text);
                                                                    root.composer-text = "";
                                                                    root.return-focus();
                                                                }
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.access-menu-open : Rectangle {
                                            // Menus must render above the context/workspace badge.
                                            z: 20;
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                access-button.absolute-position.x - parent.absolute-position.x));
                                            y: access-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 144px;
                                            height: 98px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                MenuOption {
                                                    label: "完全访问";
                                                    active: root.access-mode == "完全访问";
                                                    chosen => { root.access-mode = "完全访问"; root.access-menu-open = false; root.return-focus(); }
                                                }
                                                MenuOption {
                                                    label: "受限访问";
                                                    active: root.access-mode == "受限访问";
                                                    chosen => { root.access-mode = "受限访问"; root.access-menu-open = false; root.return-focus(); }
                                                }
                                                MenuOption {
                                                    label: "只读模式";
                                                    active: root.access-mode == "只读模式";
                                                    chosen => { root.access-mode = "只读模式"; root.access-menu-open = false; root.return-focus(); }
                                                }
                                            }
                                        }
                                        if root.effort-menu-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                effort-button.absolute-position.x - parent.absolute-position.x + effort-button.width - self.width));
                                            y: effort-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 128px;
                                            height: 154px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 26px;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        height: parent.height;
                                                        text: "推理强度";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Palette.faint;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        y: parent.height - 0.67px;
                                                        width: parent.width;
                                                        height: 0.67px;
                                                        background: Palette.sep;
                                                    }
                                                }
                                                for opt in ["低", "标准", "高", "最高"] : MenuOption {
                                                    label: opt;
                                                    active: root.effort == opt;
                                                    chosen => { root.effort = opt; root.effort-menu-open = false; root.return-focus(); }
                                                }
                                            }
                                        }
                                        if root.model-menu-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                model-button.absolute-position.x - parent.absolute-position.x + model-button.width - self.width));
                                            y: model-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 224px;
                                            height: Math.min(root.model-choices.length * 30px + 34px, 200px);
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 26px;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        height: parent.height;
                                                        text: "选择模型";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Palette.faint;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        y: parent.height - 0.67px;
                                                        width: parent.width;
                                                        height: 0.67px;
                                                        background: Palette.sep;
                                                    }
                                                }
                                                for choice in root.model-choices : MenuOption {
                                                    label: choice.label;
                                                    active: choice.provider == root.setting-provider && choice.model == root.model-name;
                                                    chosen => {
                                                        root.select-model(choice.provider, choice.model);
                                                        root.model-menu-open = false;
                                                        root.return-focus();
                                                    }
                                                }
                                            }
                                        }
                                        if root.slash-menu-visible && root.slash-commands.length > 0 : Rectangle {
                                            x: 12px;
                                            y: -Math.min(root.slash-commands.length * 44px + 8px, 240px) - 80px;
                                            width: parent.width - 24px;
                                            background: Palette.white;
                                            border-radius: 12px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -4px;
                                            drop-shadow-blur: 14px;
                                            VerticalLayout {
                                                padding: 4px;
                                                for cmd in root.slash-commands : Rectangle {
                                                    height: 44px;
                                                    border-radius: 8px;
                                                    background: sta.has-hover ? Palette.sep : transparent;
                                                    Text {
                                                        x: 10px;
                                                        y: 5px;
                                                        text: "/" + cmd.command + "  " + cmd.usage;
                                                        font-family: "Consolas";
                                                        font-weight: 600;
                                                        font-size: 12.5px;
                                                        color: Palette.accent-text;
                                                    }
                                                    Text {
                                                        x: 10px;
                                                        y: 23px;
                                                        text: cmd.summary;
                                                        font-size: 11px;
                                                        color: Palette.dim;
                                                    }
                                                    sta := TouchArea {
                                                        clicked => {
                                                            root.composer-text = "/" + cmd.command + " ";
                                                            root.slash-menu-visible = false;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                            TouchArea { clicked => { root.slash-menu-visible = false } }
                                        }
                                        if root.context-popover-open : Rectangle {
                                            x: Math.max(0px, Math.min(parent.width - self.width,
                                                context-button.absolute-position.x - parent.absolute-position.x + context-button.width - self.width));
                                            y: context-button.absolute-position.y - parent.absolute-position.y - self.height - 8px;
                                            width: 320px;
                                            height: 353px;
                                            background: Palette.white;
                                            border-radius: 16px;
                                            border-width: 0.67px;
                                            border-color: Palette.border;
                                            drop-shadow-color: rgba(0, 0, 0, 0.14);
                                            drop-shadow-offset-y: -6px;
                                            drop-shadow-blur: 20px;
                                            VerticalLayout {
                                                padding: 16px;
                                                spacing: 12px;
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text {
                                                        text: "上下文容量";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: Palette.ink;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.trace-total-label + " tokens";
                                                        font-family: "Consolas";
                                                        font-size: 11.5px;
                                                        color: Palette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle {
                                                    height: 8px;
                                                    border-radius: 999px;
                                                    background: #F3F4F6;
                                                    Rectangle {
                                                        x: 0px;
                                                        y: 0px;
                                                        width: Math.max(2px, parent.width * clamp(root.prompt-share(), 1, 100) / 100);
                                                        height: 8px;
                                                        border-radius: 999px;
                                                        background: #F5A623;
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #3B82F6; y: (parent.height - 8px) / 2; }
                                                            Text { text: "消息 / Prompt"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-input-tokens + " (" + root.prompt-share() + "%)"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #60A5FA; y: (parent.height - 8px) / 2; }
                                                            Text { text: "模型生成 / Completion"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-output-tokens + " (" + root.completion-share() + "%)"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #93C5FD; y: (parent.height - 8px) / 2; }
                                                            Text { text: "对话轮次"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-turns + " 轮"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #BFDBFE; y: (parent.height - 8px) / 2; }
                                                            Text { text: "模型调用"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-calls + " 次"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #DBEAFE; y: (parent.height - 8px) / 2; }
                                                            Text { text: "透镜事件"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: root.trace-total + " 条"; font-family: "Consolas"; font-size: 12px; font-weight: 500; color: Palette.ink; vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle { width: 8px; height: 8px; border-radius: 999px; background: #E5E7EB; y: (parent.height - 8px) / 2; }
                                                            Text { text: "缓存命中"; font-size: 12px; color: Palette.body; vertical-alignment: center; }
                                                        }
                                                        Text { text: "模型未提供"; font-family: "Consolas"; font-size: 11px; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                }
                                                Rectangle { height: 0.67px; background: Palette.sep; }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "当前模型"; font-size: 12px; color: Palette.mid; vertical-alignment: center; }
                                                    Text { text: root.model-name; font-family: "Consolas"; font-size: 11px; font-weight: 600; color: Palette.ink; overflow: elide; vertical-alignment: center; }
                                                }
                                                Rectangle { height: 0.67px; background: Palette.sep; }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        Text { text: "剩余额度"; font-size: 12px; font-weight: 700; color: Palette.ink; vertical-alignment: center; }
                                                        Text { text: "实时数据"; font-size: 11px; color: Palette.dim; vertical-alignment: center; }
                                                    }
                                                    Text {
                                                        text: "当前模型提供方未返回额度信息";
                                                        font-size: 11px;
                                                        color: Palette.dim;
                                                    }
                                                }
                                            }
                                            context-card-touch := TouchArea {
                                                changed has-hover => {
                                                    root.context-card-hover = self.has-hover;
                                                    if self.has-hover {
                                                        root.context-close-pending = false;
                                                    } else if !root.context-button-hover {
                                                        root.context-close-pending = true;
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                    }
                                }
                            }

                                if root.trace-filter-open : Rectangle {
                                x: parent.width - 150px;
                                y: 44px;
                                width: 140px;
                                background: Palette.white;
                                border-radius: 12px;
                                border-width: 0.67px;
                                border-color: Palette.border;
                                drop-shadow-color: rgba(0, 0, 0, 0.14);
                                drop-shadow-offset-y: 5px;
                                drop-shadow-blur: 14px;
                                VerticalLayout {
                                    padding: 4px;
                                    for opt in ["全部", "USER", "CONTEXT", "ASSISTANT", "TOOL"] : MenuOption {
                                        label: opt == "全部" ? "全部" : opt;
                                        active: root.trace-filter-index == (opt == "全部" ? 0 : opt == "USER" ? 1 : opt == "CONTEXT" ? 2 : opt == "ASSISTANT" ? 3 : 4);
                                        chosen => {
                                            root.trace-filter-index = opt == "USER" ? 1 : opt == "CONTEXT" ? 2 : opt == "ASSISTANT" ? 3 : opt == "TOOL" ? 4 : 0;
                                            root.trace-page = 1;
                                            root.trace-filter-open = false;
                                            root.refresh-trace();
                                        }
                                    }
                                }
                                TouchArea { clicked => { root.trace-filter-open = false } }
                            }
}
if root.trajectory-selected : TrajectoryPanel {
    width: parent.width;
    height: parent.height;
    trace-events: root.trace-events;
    gantt: root.gantt;
    trace-ticks: root.trace-ticks;
    model-name: root.model-name;
    access-mode: root.access-mode;
    effort: root.effort;
    assistant-text: root.assistant-text;
    setting-command-approval: root.setting-command-approval;
    trace-duration: root.trace-duration;
    trace-provider: root.trace-provider;
    trace-model: root.trace-model;
    trace-result: root.trace-result;
    trace-total-label: root.trace-total-label;
    trace-prompt-label: root.trace-prompt-label;
    trace-completion-label: root.trace-completion-label;
    trace-turns: root.trace-turns;
    trace-calls: root.trace-calls;
    trace-total: root.trace-total;
    trace-pages: root.trace-pages;
    trace-search <=> root.trace-search;
    trace-selected-num <=> root.trace-selected-num;
    request-tab <=> root.request-tab;
    trace-filter-index <=> root.trace-filter-index;
    trace-page <=> root.trace-page;
    trace-page-size <=> root.trace-page-size;
    trace-filter-open <=> root.trace-filter-open;
    refresh-trace => { root.refresh-trace(); }
    export-trace => { root.export-trace(); }
    page-range-label => { root.page-range-label() }
}
}
}

environment-panel := EnvironmentPanel {
    x: root.environment-panel-open
        ? Math.max(8px, Math.min(root.resolved-environment-button-x(), parent.width - self.width - 8px))
        : root.resolved-environment-button-x();
    y: root.environment-panel-open
        ? Math.max(48px, Math.min(root.resolved-environment-button-y(), parent.height - self.height - 8px))
        : root.resolved-environment-button-y();
    z: 120;
    project-files: root.project-files;
    workspace-presets: root.workspace-presets;
    workspace-project: root.workspace-project;
    workspace-path: root.workspace-short-path == "" ? root.setting-workspace : root.workspace-short-path;
    workspace-full-path: root.setting-workspace;
    workspace-branch: root.workspace-branch;
    indexed-files: root.workspace-indexed-files;
    has-git: root.workspace-has-git;
    locked: root.workspace-locked;
    collapsed-tooltip-right: root.resolved-environment-button-x() < 217px;
    collapsed-tooltip-above: root.resolved-environment-button-y() > root.height - 104px;
    open <=> root.environment-panel-open;
    move-collapsed(delta-x, delta-y) => {
        root.environment-button-x = Math.max(8px, Math.min(
            environment-panel.x + delta-x,
            root.width - 56px
        ));
        root.environment-button-y = Math.max(48px, Math.min(
            environment-panel.y + delta-y,
            root.height - 56px
        ));
    }
    open-project-file(index) => {
        root.select-project-file(index);
        root.set-code-panel-visible(true);
    }
    open-change-workspace => { root.open-change-workspace(); }
    switch-workspace(path) => { root.switch-workspace(path); }
    copy-text(value) => { root.copy-text(value); }
    refresh-workspace => { root.refresh-workspace(); }
    open-workspace-settings => { root.open-workspace-settings(); }
}
}
