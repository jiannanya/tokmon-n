<template name="desk-shell" content="desk-document-content">
<head>
  <link type="text/rcss" href="../themes/legacy-palette.rcss"/>
  <link type="text/rcss" href="../themes/legacy-metrics.rcss"/>
  <link type="text/rcss" href="../themes/legacy-components.rcss"/>
  <link type="text/template" href="right-panel.rml"/>
  <link type="text/template" href="settings-dialog.rml"/>
  <link type="text/template" href="overlays.rml"/>
  <link type="text/template" href="trajectory.rml"/>
</head>
<body id="app-shell" data-model="desk" data-class-dark="view.settings.theme_mode == '深色'">
  <div id="sidebar" class="sidebar">
    <div id="brand-row" class="brand-row drag-region">
      <svg class="brand-logo" data-attr-src="view.asset_root + '/figma/icon-00.svg'"></svg>
      <span class="brand-name">Tokmon</span>
      <button id="sidebar-toggle" class="brand-collapse" title="折叠侧边栏"><svg data-attr-src="view.asset_root + '/figma/icon-01.svg'"></svg></button>
    </div>
    <button id="new-session-button" class="new-session-button"><svg data-attr-src="view.asset_root + '/figma/icon-02.svg'"></svg><span>新建会话</span></button>
    <div class="search-box"><svg data-attr-src="view.asset_root + '/figma/icon-03.svg'"></svg><span id="navigation-search-placeholder" class="search-placeholder">搜索会话、项目或分组...</span><input id="navigation-search" type="text"/></div>
    <div class="tree-caption">分组 / 项目 / 会话</div>
    <div id="navigation-tree" class="navigation-tree">
      <div data-for="row : view.navigation" data-attr-class="'tree-row ' + row.classes" data-style-padding-left="row.padding" data-attr-nav-id="row.id">
        <span class="chevron">{{row.chevron}}</span><svg data-attr-src="row.icon"></svg><span>{{row.title}}</span>
      </div>
      <div class="navigation-empty" data-if="view.navigation_empty">没有匹配的会话、项目或分组</div>
    </div>
    <i id="navigation-scrollbar-thumb" class="navigation-scrollbar-thumb hidden"></i>
    <button id="settings-button" class="settings-button"><i class="settings-divider"></i><svg data-attr-src="view.asset_root + '/figma/icon-13.svg'"></svg><span>设置</span><i class="settings-status-dot"></i></button>
  </div>

  <div id="sidebar-resizer" class="panel-resizer sidebar-resizer"></div>

  <div id="workspace" class="workspace">
    <div id="workspace-titlebar" class="workspace-titlebar drag-region">
      <button id="sidebar-restore" class="titlebar-restore" title="展开侧边栏"><svg data-attr-src="view.asset_root + '/figma/icon-01.svg'"></svg></button>
      <button id="right-restore" class="titlebar-restore right-restore" title="展开代码审阅"><svg data-attr-src="view.asset_root + '/figma/icon-15.svg'"></svg></button>
      <span id="session-title" class="session-title">{{view.session_title}}</span>
      <button id="title-edit" class="title-edit" title="重命名会话"><svg data-attr-src="view.asset_root + '/figma/icon-14.svg'"></svg></button>
      <span class="workspace-chip"><svg data-attr-src="view.asset_root + '/figma/icon-18.svg'"></svg><span>{{view.workspace_name}}</span></span>
      <div class="workspace-mode-tabs">
        <button id="chat-mode" class="mode-tab-button active"><svg data-attr-src="view.asset_root + '/figma/icon-21.svg'"></svg><span>对话</span><i class="active-indicator"></i></button>
        <button id="trajectory-mode" class="mode-tab-button"><svg data-attr-src="view.asset_root + '/figma/icon-45.svg'"></svg><span>轨迹</span><i class="active-indicator"></i></button>
      </div>
    </div>
    <div id="environment-panel" class="environment-panel hidden">
      <div class="environment-panel-head"><strong>环境信息</strong><span class="environment-panel-status"></span><button id="environment-close" title="收起环境信息">◎</button></div>
      <div class="environment-grid">
        <div class="environment-row"><span>变更</span><span id="environment-change-count">正在读取…</span></div>
        <div class="environment-row"><span>本地</span><code id="workspace-path">{{view.workspace_path}}</code></div>
        <div class="environment-row"><span>Git 分支</span><span id="environment-branch">{{view.branch}}</span></div>
        <div class="environment-row"><span>索引</span><span id="environment-index">正在读取…</span></div>
        <div class="environment-row"><span>Daemon</span><span id="daemon-status">正在连接后台服务</span></div>
      </div>
      <div class="environment-actions"><button id="environment-refresh">刷新状态</button><button id="environment-settings">环境设置</button></div>
    </div>
    <div id="environment-orb" class="environment-orb"><span class="environment-ring outer"></span><span class="environment-ring inner"></span><span class="environment-core"></span><span class="environment-online"></span><button id="environment-toggle" class="environment-orb-hit" title="环境信息"></button></div>
    <div id="initial-session" class="initial-session" data-if="view.conversation_empty">
      <div class="starter-block">
        <div class="starter-logo-box"><svg data-attr-src="view.asset_root + '/figma/icon-00.svg'"></svg></div>
        <h1><span>你想在</span><strong id="starter-workspace-name">{{view.workspace_name}}</strong><span>中创造什么？</span></h1>
        <div class="starter-grid">
          <button class="starter-card" starter-kind="explore"><span class="starter-icon explore"><svg data-attr-src="view.asset_root + '/figma/starter-explore.svg'"></svg></span><span class="starter-title">探索并理解代码</span><span class="starter-detail">梳理架构、依赖与核心逻辑</span></button>
          <button class="starter-card" starter-kind="build"><span class="starter-icon build"><svg data-attr-src="view.asset_root + '/figma/starter-build.svg'"></svg></span><span class="starter-title">构建新功能、应用或工具</span><span class="starter-detail">设计方案并编写实现代码</span></button>
          <button class="starter-card" starter-kind="review"><span class="starter-icon review"><svg data-attr-src="view.asset_root + '/figma/starter-review.svg'"></svg></span><span class="starter-title">审查代码并提出修改建议</span><span class="starter-detail">排查隐患与提升代码规范</span></button>
          <button class="starter-card" starter-kind="fix"><span class="starter-icon fix"><svg data-attr-src="view.asset_root + '/figma/starter-fix.svg'"></svg></span><span class="starter-title">修复问题和失败</span><span class="starter-detail">诊断报错堆栈并修复异常</span></button>
        </div>
      </div>
    </div>
    <div id="conversation" class="conversation" data-if="!view.conversation_empty">
      <div class="conversation-spacer" data-if="view.conversation_has_top_spacer" data-style-height="view.conversation_top_spacer"></div>
      <div data-for="turn : view.conversation">
        <div class="user-message-row" data-if="turn.has_user"><article class="message user-message"><button class="markdown-copy message-copy" data-attr-data-copy-markdown="turn.user_copy_id">复制</button><div data-rml="turn.user_rml"></div></article></div>
        <article class="thought-card" data-if="turn.has_reasoning"><div class="card-title"><span>●</span> 思考过程<button class="markdown-copy message-copy" data-attr-data-copy-markdown="turn.reasoning_copy_id">复制</button></div><div class="thought-content" data-rml="turn.reasoning_rml"></div></article>
        <article class="workflow-card" data-if="turn.has_workflow"><div class="card-title"><span class="status-dot"></span> 工作流执行<span class="complete-pill">{{turn.workflow.size}} 项</span></div><div class="workflow-content"><div data-for="step : turn.workflow" class="workflow-step" data-class-failed="step.failed"><span class="step-icon">{{step.failed ? '!' : '✓'}}</span><div><strong>{{step.kind}}</strong><small>{{step.detail}}</small></div></div></div></article>
        <article class="message assistant-message" data-if="turn.has_assistant"><button class="markdown-copy message-copy" data-attr-data-copy-markdown="turn.assistant_copy_id">复制</button><div data-rml="turn.assistant_rml"></div></article>
      </div>
      <div class="conversation-spacer" data-if="view.conversation_has_bottom_spacer" data-style-height="view.conversation_bottom_spacer"></div>
    </div>
    <template src="desk-trajectory"/>
    <div id="composer-wrap" class="composer-wrap">
      <div class="workspace-context"><svg data-attr-src="view.asset_root + '/figma/icon-18.svg'"></svg><strong id="composer-workspace-name">{{view.workspace_name}}</strong><span>·</span><svg data-attr-src="view.asset_root + '/figma/icon-19.svg'"></svg><span>本地</span><span>·</span><svg data-attr-src="view.asset_root + '/figma/icon-50.svg'"></svg><span class="branch">{{view.branch}}</span></div><div class="composer-card-shadow"></div>
      <div id="composer-card" class="composer-card"><span id="composer-placeholder" class="composer-placeholder">随心输入需求，或点击上方卡片快速开始...</span><textarea id="composer" rows="2" placeholder="随心输入需求，或点击上方卡片快速开始..."></textarea><div class="composer-toolbar"><div class="composer-tools"><button id="attach-button" class="round-button"><svg data-attr-src="view.asset_root + '/figma/icon-23.svg'"></svg></button><span id="attachment-pill" class="attachment-pill hidden"></span><button id="access-button" class="tool-pill access"><svg data-attr-src="view.asset_root + '/figma/icon-28.svg'"></svg>{{view.access_label}}⌄</button></div><div class="composer-options"><button class="context-ring"><svg data-attr-src="view.asset_root + '/figma/icon-26.svg'"></svg></button><button id="active-model" class="select-pill">{{view.active_model}}</button><button id="effort-button" class="select-pill"><svg data-attr-src="view.asset_root + '/figma/icon-40.svg'"></svg>{{view.effort}}⌄</button><button id="send-button" class="send-button" data-class-running="view.chat_running" data-class-stopping="view.chat_stopping" data-attr-title="view.chat_running ? '停止当前任务' : '发送消息'"><svg data-if="!view.chat_running" data-attr-src="view.asset_root + '/figma/icon-33.svg'"></svg><span class="stop-glyph" data-if="view.chat_running"></span></button></div></div></div>
    </div>
  </div>

  <template src="desk-right-panel"/>
  <template src="desk-settings-dialog"/>
  <template src="desk-overlays"/>
  <div id="desk-document-content"></div>
</body>
</template>
