<template name="desk-right-panel" content="right-panel-extension">
<head></head>
<body>
  <button id="right-toggle" class="panel-toggle right-toggle"><svg data-attr-src="view.asset_root + '/figma/icon-57.svg'"></svg></button>
  <div id="right-resizer" class="panel-resizer right-resizer"></div>
  <div id="right-panel" class="right-panel">
    <div id="right-titlebar" class="window-controls drag-region"><div class="right-open-tabs"><div id="right-active-tab" class="right-tab-pill hidden"><svg id="active-right-icon" data-attr-src="view.asset_root + '/figma/icon-51.svg'"></svg><strong id="active-right-label">审查</strong><button id="right-tab-close" class="right-tab-close">×</button></div><button id="add-tab-button" class="add-tab-button" title="添加标签页">＋</button></div><span class="window-spacer"></span></div>
    <div id="right-tab-menu" class="right-tab-menu hidden"><strong>打开标签页</strong><button id="review-tab"><svg data-attr-src="view.asset_root + '/figma/icon-51.svg'"></svg>审查<span>Ctrl+Shift+G</span></button><button id="files-tab"><svg data-attr-src="view.asset_root + '/figma/icon-18.svg'"></svg>文件<span>Ctrl+P</span></button><button id="terminal-tab"><svg data-attr-src="view.asset_root + '/figma/icon-19.svg'"></svg>终端</button><button id="browser-tab">◎ 浏览器</button></div>
    <section id="right-launcher" class="right-launcher"><div class="launcher-list"><button id="launcher-review" class="launcher-entry"><span><svg data-attr-src="view.asset_root + '/figma/icon-51.svg'"></svg><strong>审查</strong></span><kbd>Ctrl+Shift+G</kbd></button><button id="launcher-files" class="launcher-entry"><span><svg data-attr-src="view.asset_root + '/figma/icon-18.svg'"></svg><strong>文件</strong></span><kbd>Ctrl+P</kbd></button></div></section>
    <section id="review-view" class="right-view hidden">
      <div class="review-toolbar"><button id="branch-button">⑂ {{view.branch}}⌄</button><button id="commit-button"><svg data-attr-src="view.asset_root + '/figma/icon-52.svg'"></svg>提交或推送</button><button id="refresh-review">↻</button></div>
      <div class="review-summary"><strong>更改</strong><span class="count-pill">{{view.review_count}}</span><button id="accept-agent-changes" class="hidden">接受 Agent 修改</button><button id="reject-agent-changes" class="danger hidden">拒绝</button><button id="diff-view-toggle">并排</button></div>
      <div id="review-empty" class="empty-panel">
        <svg data-if="!view.review_has_files" data-attr-src="view.asset_root + '/figma/icon-51.svg'"></svg><strong data-if="!view.review_has_files">{{view.review_title}}</strong><span data-if="!view.review_has_files">{{view.review_detail}}</span>
        <div class="change-list" data-if="view.review_has_files"><div class="change-row" data-for="file : view.review_files"><button class="change-open" data-attr-diff-path="file.path" data-attr-diff-staged="file.worktree ? '0' : '1'"><code>{{file.status}}</code><span>{{file.path}}</span></button><button class="change-action" data-if="file.worktree" data-attr-git-action="'stage-file'" data-attr-git-path="file.path">＋</button><button class="change-action" data-if="file.staged" data-attr-git-action="'unstage-file'" data-attr-git-path="file.path">−</button><button class="change-action danger" data-if="file.worktree" data-attr-git-action="'discard-file'" data-attr-git-path="file.path">↶</button></div></div>
      </div>
      <div id="review-diff" class="review-diff hidden" data-class-hidden="!view.diff_visible">
        <div class="diff-error" data-if="view.diff_error_visible">{{view.diff_error}}</div>
        <div data-if="!view.diff_error_visible"><div class="diff-header"><button id="close-diff" title="返回更改列表">‹ 更改列表</button><strong>{{view.diff_path}}</strong><span>{{view.diff_summary}}</span></div><div id="diff-hunk-actions" class="diff-hunk-actions"><span data-for="hunk : view.diff_hunks"><button data-attr-git-action="hunk.action" data-attr-git-path="hunk.path" data-attr-git-hunk="hunk.index">{{hunk.header}} · {{hunk.action_label}}</button><button class="danger" data-if="hunk.discardable" data-attr-git-action="'discard-hunk'" data-attr-git-path="hunk.path" data-attr-git-hunk="hunk.index">放弃修改块</button></span></div><tokmon-diff-surface id="diff-surface" class="diff-surface" tab-index="0"></tokmon-diff-surface></div>
      </div>
      <div id="branch-menu" class="branch-menu hidden"><strong>{{view.branch_menu_loading ? '正在读取分支…' : '切换 Git 分支'}}</strong><button data-for="branch : view.branches" data-class-active="branch.selected" data-attr-git-branch="branch.value">{{branch.selected ? '✓ ' : ''}}{{branch.label}}</button><span data-if="view.branch_menu_empty">没有本地分支</span></div>
    </section>
    <section id="files-view" class="right-view hidden"><div class="panel-search"><span id="file-search-placeholder" class="panel-search-placeholder">搜索工作区文件...</span><input id="file-search" type="text"/></div><div class="file-actions"><button id="file-new" title="新建文件">＋文件</button><button id="folder-new" title="新建文件夹">＋文件夹</button><button id="file-rename" title="重命名选中项">重命名</button><button id="file-delete" class="danger-quiet" title="删除选中项">删除</button></div><tokmon-file-tree id="file-tree" class="file-tree" tab-index="0"></tokmon-file-tree><div class="editor-toolbar"><span id="file-path">选择文件以预览或编辑</span><span id="syntax-status"></span><button id="undo-file" disabled="">撤销</button><button id="redo-file" disabled="">重做</button><button id="reload-file">重新载入</button><button id="save-file">保存</button></div><div class="editor-findbar"><input id="editor-find" type="text" placeholder="查找"/><button id="editor-find-previous" title="上一个">↑</button><button id="editor-find-next" title="下一个">↓</button><input id="editor-replace" type="text" placeholder="替换为"/><button id="editor-replace-one">替换</button><input id="editor-line" type="number" min="1" placeholder="行"/><button id="editor-go-line">跳转</button><button id="editor-match-bracket" title="跳到匹配括号">()</button><span id="editor-find-status"></span></div><tokmon-code-surface id="file-preview" class="file-preview" tab-index="0"></tokmon-code-surface></section>
    <section id="terminal-view" class="right-view terminal-view hidden"><div class="terminal-toolbar"><div id="terminal-tabs" class="terminal-tabs"><button data-for="tab : view.terminal_tabs" data-class-active="tab.active" data-attr-terminal-tab-id="tab.id">{{tab.title}}</button></div><button id="terminal-new-tab" title="新建终端">＋</button><button id="terminal-close-tab" title="关闭终端">×</button><span id="terminal-status">未启动</span><input id="terminal-search" type="text" placeholder="搜索当前终端"/><span id="terminal-search-count"></span><button id="terminal-clear-search">×</button></div><tokmon-terminal id="terminal-surface" tab-index="0"></tokmon-terminal><div id="terminal-hint" class="terminal-hint">点击终端后直接输入 · Ctrl+Shift+C/V 复制/粘贴 · Ctrl+单击打开 OSC 8 链接 · Esc 释放焦点</div></section>
    <section id="browser-view" class="right-view hidden"><div class="browser-toolbar"><button id="browser-back" title="后退">‹</button><button id="browser-forward" title="前进">›</button><input id="browser-url" type="text" data-value="view.browser_url"/><button id="browser-go">打开</button><button id="browser-reload">↻</button><button id="browser-stop">停止</button></div><div id="browser-permission" class="browser-permission" data-class-takeover="view.browser_takeover"><span>{{view.browser_permission}}</span><button id="browser-takeover">{{view.browser_takeover_label}}</button></div><div class="browser-actionbar"><input id="browser-selector" type="text" placeholder="@e1 或 CSS 选择器"/><input id="browser-value" type="text" placeholder="填充值"/><button id="browser-click">点击</button><button id="browser-fill">填写</button></div><div id="browser-status" class="browser-placeholder" data-class-compact="view.browser_running">◎<strong>{{view.browser_title}}</strong><span>{{view.browser_detail}}</span><button id="browser-launch" data-class-hidden="view.browser_running">启动 Agent Browser</button></div><img id="browser-preview" class="browser-preview" data-if="view.browser_preview_visible" data-attr-src="view.browser_preview"/><pre id="browser-snapshot" class="browser-snapshot">{{view.browser_snapshot}}</pre></section>
    <div id="right-toast" class="right-toast hidden"></div>
    <div id="right-panel-extension"></div>
  </div>
  <div id="global-window-controls" class="global-window-controls"><button id="minimize-button" title="最小化"><svg data-attr-src="view.asset_root + '/figma/icon-37.svg'"></svg></button><button id="maximize-button" title="最大化或还原"><svg data-attr-src="view.asset_root + '/figma/icon-55.svg'"></svg></button><button id="close-button" class="close-window" title="关闭"><svg data-attr-src="view.asset_root + '/figma/icon-39.svg'"></svg></button></div>
</body>
</template>
