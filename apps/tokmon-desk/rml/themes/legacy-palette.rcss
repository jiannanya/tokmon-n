body.dark .tag,
body.dark .stopped-tag {
  background-color: #1c2520;
  color: #7f9485;
  border-color: rgba(255, 255, 255, 20);
}

body.dark .accent-tag {
  background-color: #1c2c22;
  color: #72b890;
}

body.dark .running-tag {
  background-color: #1c2c22;
  color: #8ee0af;
}

body.dark .compact-setting-card,
body.dark .skill-card,
body.dark .mcp-server,
body.dark .provider-row {
  background-color: #1a221d;
  border-color: rgba(255, 255, 255, 20);
  color: #e6ede7;
}

body.dark .provider-row.selected {
  background-color: #1c2c22;
}

body.dark .mcp-header-card,
body.dark .about-brand {
  background-color: #161c18;
  border-color: rgba(255, 255, 255, 20);
  color: #e6ede7;
}

body.dark .mcp-header-card em,
body.dark .about-brand em,
body.dark .path-value,
body.dark .locked-value {
  color: #72b890;
}

body.dark .path-value {
  background-color: #151c17;
  border-color: rgba(255, 255, 255, 20);
}

/* ---- Dark-mode gaps: floating surfaces, window chrome, trajectory aids ---- */

body.dark .panel-toggle {
  background-color: #1a221d;
  border-color: rgba(255, 255, 255, 20);
  color: #7f9485;
}

body.dark .panel-toggle:hover {
  background-color: #243028;
  color: #72b890;
}

body.dark .window-controls button:hover {
  background-color: rgba(255, 255, 255, 20);
}

body.dark .right-tab-menu,
body.dark .branch-menu,
body.dark .navigation-context-menu,
body.dark .popover-card {
  background-color: #1a221d;
  border-color: rgba(255, 255, 255, 20);
  color: #e6ede7;
}

body.dark .navigation-context-menu span {
  background-color: rgba(255, 255, 255, 20);
}

body.dark .file-empty-icon {
  background-color: #1c2520;
  border-color: rgba(255, 255, 255, 20);
}

body.dark .settings-nav-icon {
  border-color: rgba(255, 255, 255, 20);
  color: #7f9485;
}

body.dark .environment-orb {
  decorator: linear-gradient(180deg, #1c2520 0%, #161c18 100%);
}

body.dark .environment-ring.outer {
  border-color: rgba(230, 237, 231, 56);
}

body.dark .environment-ring.inner {
  border-color: rgba(230, 237, 231, 166);
}

body.dark .environment-online {
  border-color: #1a221d;
}

body.dark .environment-panel {
  background-color: rgba(22, 28, 24, 242);
  box-shadow: rgba(0, 0, 0, 77) 0dp 16dp 40dp 0dp, rgba(0, 0, 0, 26) 0dp 2dp 8dp 0dp;
}

body.dark .attachment-pill {
  background-color: #1c2520;
  border-color: rgba(255, 255, 255, 20);
  color: #b8c7bb;
}

body.dark .editor-findbar button {
  background-color: #1c2520;
  color: #9bb0a0;
}

body.dark .review-summary button.active {
  background-color: #1c2c22;
  border-color: rgba(114, 184, 144, 64);
  color: #72b890;
}

body.dark .review-toolbar #branch-button:hover,
body.dark .review-toolbar #refresh-review:hover {
  background-color: #243028;
}

body.dark .trajectory-range {
  border-color: #72b890;
  background-color: rgba(114, 184, 144, 38);
}

body.dark .trajectory-range.dragging {
  background-color: rgba(114, 184, 144, 66);
}

body.dark .trajectory-zoom-status {
  border-color: rgba(255, 255, 255, 26);
  background-color: rgba(22, 28, 24, 221);
  color: #9bb0a0;
}

body.dark .trajectory-details-dot {
  background-color: #7f9485;
}

body.dark .terminal-toolbar button:hover {
  background-color: #243028;
}

body.dark .provider-row.selected {
  background-color: #1c2c22;
}

body.dark .choice-popover button:hover,
body.dark .choice-popover button.selected,
body.dark .navigation-context-menu button:hover,
body.dark .navigation-context-menu button:focus {
  background-color: #1c2c22;
  color: #72b890;
}

body.dark .right-toast {
  border-color: rgba(255, 255, 255, 26);
}

body.dark .starter-card:hover {
  border-color: #4a7860;
}

body.dark .panel-resizer:hover {
  border-left-color: #72b890;
}

body.dark .form-error {
  color: #f87171;
}

.form-error {
  color: #dc2626;
  font-size: 10.5dp;
}

/* ---- Dark-mode chrome: toggles, modal strips, titlebar restore buttons ---- */

body.dark .brand-collapse:hover,
body.dark .titlebar-restore:hover {
  background-color: rgba(255, 255, 255, 20);
}

body.dark .add-tab-button:hover {
  background-color: rgba(255, 255, 255, 20);
}

body.dark .right-tab-close:hover {
  background-color: rgba(255, 255, 255, 20);
  color: #e6ede7;
}

body.dark .modal-header,
body.dark .modal-footer {
  background-color: #161c18;
  border-color: rgba(255, 255, 255, 20);
}

body.dark .modal-icon {
  background-color: #1c2c22;
  border-color: rgba(114, 184, 144, 64);
  color: #72b890;
}

body.dark .modal-header button:hover {
  background-color: #243028;
  color: #e6ede7;
}

body.dark .modal label {
  color: #b8c7bb;
}

body.dark .modal > p {
  color: #9bb0a0;
}

body.dark .secondary-button:hover {
  background-color: #243028;
  color: #e6ede7;
}

body.dark .popover-card > strong {
  border-bottom-color: rgba(255, 255, 255, 20);
  color: #627568;
}

body.dark .choice-popover small {
  color: #627568;
}
