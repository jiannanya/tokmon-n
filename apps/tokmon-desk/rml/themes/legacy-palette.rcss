/* Deep Forest Sage Green / Warm White Theme System (雅绿·明亮纯净白 / 森林夜色)
   Fully aligned with Tokmon UI prototype (http://localhost:8443/). */

/* ========================================================================= */
/* LIGHT THEME PALETTE                                                       */
/* ========================================================================= */

body {
  background-color: #f4f2ec;
  color: #252d27;
}

/* Base Surfaces & Structural Columns */
.sidebar {
  background-color: #ffffff;
  border-color: rgba(234, 230, 220, 179);
}

.workspace {
  background-color: #ffffff;
}

.right-panel {
  background-color: #ffffff;
  border-color: rgba(234, 230, 220, 179);
}

.brand-row,
.workspace-titlebar,
.window-controls {
  background-color: #ffffff;
  border-color: rgba(234, 230, 220, 153);
}

.brand-name {
  color: #1a211c;
}

/* Sidebar Navigation & Controls */
.new-session-button {
  background-color: #f0f6ef;
  color: #2d5a43;
}

.new-session-button:hover {
  background-color: #e4efe2;
}

.search-box,
.panel-search {
  background-color: #f8f7f4;
  border-color: #eeebe3;
  color: #1a211c;
}

.search-box:focus-within,
.panel-search:focus-within {
  background-color: #ffffff;
  border-color: #2d5a43;
}

.search-placeholder,
.panel-search-placeholder {
  color: #949e97;
}

.tree-caption,
.timestamp,
small {
  color: #747f78;
}

.tree-row {
  color: #4a534c;
}

.tree-row.group {
  color: #252d27;
}

.tree-row.project {
  color: #4a534c;
}

.tree-row.session {
  color: #5c6760;
}

.tree-row:hover {
  background-color: #f7f6f2;
}

.tree-row.selected {
  background-color: #edf5ec;
  color: #2d5a43;
}

.tree-row.selected .tree-icon,
.tree-row.selected svg {
  color: #2d5a43;
}

.tree-guide {
  border-left-color: #eae6dc;
}

.row-add {
  color: #747f78;
}

.row-add:hover {
  background-color: #f0ece3;
  color: #2d5a43;
}

.navigation-scrollbar-thumb {
  background-color: #e8e4da;
}

.settings-button {
  background-color: #ffffff;
  color: #4a534c;
}

.settings-button:hover {
  background-color: #f7f6f2;
  color: #1a211c;
}

.settings-divider {
  background-color: rgba(234, 230, 220, 179);
}

.settings-status-dot {
  background-color: #16a34a;
}

/* Workspace Header & Modes */
.session-title {
  color: #1a211c;
}

.title-edit {
  color: #949e97;
}

.title-edit:hover {
  color: #1a211c;
}

.workspace-chip,
.project-chip,
.branch-chip {
  background-color: #f7f5ef;
  color: #747f78;
  border-color: rgba(234, 230, 220, 153);
}

.workspace-mode-tabs {
  background-color: transparent;
}

.mode-tab-button {
  background-color: transparent;
  color: #747f78;
}

.mode-tab-button:hover {
  color: #1a211c;
}

.mode-tab-button.active {
  color: #2d5a43;
}

.mode-tab-button .active-indicator {
  background-color: #2d5a43;
}

.mode-pill {
  background-color: #f3f1ea;
}

.mode-pill button {
  color: #747f78;
}

.mode-pill button.active {
  background-color: #ffffff;
  color: #1a211c;
}

/* Environment AssistiveTouch Orb & Panel */
.environment-orb {
  background-color: #faf9f6;
  border-color: #eae6dc;
}

.environment-ring.outer {
  border-color: rgba(52, 61, 55, 56);
}

.environment-ring.inner {
  border-color: rgba(52, 61, 55, 166);
}

.environment-core {
  background-color: #2d5a43;
}

.environment-online {
  background-color: #16a34a;
  border-color: #ffffff;
}

.environment-panel {
  background-color: #ffffff;
  border-color: #ece8df;
  color: #252d27;
}

.environment-panel-head strong {
  color: #1a211c;
}

.environment-panel-status {
  background-color: #16a34a;
}

.environment-panel-head button {
  color: #747f78;
}

.environment-panel-head button:hover {
  background-color: #f7f5ef;
  color: #1a211c;
}

.environment-row > span:first-child {
  color: #747f78;
}

.environment-row > code {
  color: #2d5a43;
  background-color: #edf4ec;
}

.environment-actions button {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #5c6760;
}

.environment-actions button:hover {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

/* Starter Grid Cards (Empty Conversation View) */
.starter-logo-box {
  background-color: #edf4ec;
  border-color: #cddcd0;
}

.starter-block h1 {
  color: #1a211c;
}

.starter-block h1 strong,
.starter-workspace-link {
  color: #1a211c;
  border-bottom-color: #949e97;
}

.starter-workspace-link:hover {
  color: #2d5a43;
  border-bottom-color: #2d5a43;
}

.starter-workspace-pill {
  background-color: #edf4ec;
  color: #2d5a43;
  border-color: #cddcd0;
}

.starter-card {
  background-color: #ffffff;
  border-color: #eae6dc;
}

.starter-card:hover {
  background-color: #f9fbf8;
  border-color: #4a7860;
}

.starter-icon {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.starter-icon svg {
  color: #2d5a43;
}

.starter-title {
  color: #1a211c;
}

.starter-card:hover .starter-title {
  color: #2d5a43;
}

.starter-detail {
  color: #949e97;
}

/* Conversation Stream & Chat Bubbles */
.user-message {
  background-color: #f0f6ef;
  color: #252d27;
  box-shadow: #0000000d 0dp 1dp 0dp 0dp;
}

.user-message p {
  color: #1a211c;
}

.assistant-message {
  color: #252d27;
}

.assistant-message h1,
.assistant-message h2,
.assistant-message h3,
.thought-content h1,
.thought-content h2,
.thought-content h3 {
  color: #1a211c;
}

.assistant-message blockquote,
.thought-content blockquote {
  border-left-color: #4a7860;
  background-color: #f7f5ef;
  color: #5c6760;
}

.assistant-message table,
.thought-content table,
.assistant-message td,
.thought-content td {
  border-color: #eae6dc;
}

.assistant-message hr,
.thought-content hr {
  background-color: #eae6dc;
}

.assistant-message code,
.thought-content code {
  background-color: #f4f2ec;
  color: #345e48;
}

.assistant-message pre,
.thought-content pre {
  background-color: #1a211c;
  border-color: #3f3f46;
  color: #f4f2ec;
}

.markdown-copy {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #747f78;
}

.markdown-copy:hover {
  background-color: #f7f5ef;
  color: #1a211c;
}

.parameter-card {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #5c6760;
}

.thought-card {
  background-color: #faf9f5;
  border-color: #eae6dc;
}

.thought-card .card-title {
  color: #747f78;
}

.thought-card .card-title:hover {
  background-color: #f0ede6;
}

.thought-content {
  color: #5c6760;
}

.workflow-card {
  background-color: #faf9f5;
  border-color: #eae6dc;
}

.workflow-card .card-title {
  color: #262626;
}

.status-dot {
  background-color: #16a34a;
}

.complete-pill {
  background-color: #edf4ec;
  color: #2d5a43;
  border-color: #cddcd0;
}

.workflow-summary {
  color: #747f78;
}

.step-icon {
  color: #16a34a;
}

.workflow-step.failed .step-icon {
  color: #dc2626;
}

.step-time {
  color: #949e97;
}

.progress {
  background-color: #f3f1ea;
}

.progress div {
  background-color: #2d5a43;
}

/* Composer Card & Controls */
.composer-card {
  background-color: #ffffff;
  border-color: rgba(0, 0, 0, 20);
}

.composer-card:focus-within {
  border-color: rgba(45, 90, 67, 102);
}

.workspace-context {
  background-color: #f3f1ea;
  color: #2d5a43;
}

.workspace-context strong,
.workspace-context .branch {
  color: #2d5a43;
}

.composer-card textarea {
  color: #1a211c;
}

.composer-placeholder {
  color: #949e97;
}

.round-button,
.tool-pill,
.select-pill,
.context-ring {
  background-color: transparent;
  color: #4a534c;
  border-color: transparent;
}

.round-button:hover,
.tool-pill:hover,
.select-pill:hover,
.context-ring:hover {
  background-color: rgba(0, 0, 0, 10);
  color: #1a211c;
}

.tool-pill.access {
  color: #4a534c;
}

.tool-pill.access:hover {
  color: #2d5a43;
}

.send-button {
  background-color: #2d5a43;
  color: #ffffff;
}

.send-button:hover {
  background-color: #234937;
}

.send-button.running {
  background-color: #1a211c;
  color: #ffffff;
}

.send-button.running:hover {
  background-color: #dc2626;
}

.send-button.disabled {
  background-color: rgba(0, 0, 0, 13);
  color: #949e97;
}

/* Trajectory Toolbar, Timeline & Details */
.trajectory {
  background-color: #ffffff;
  color: #252d27;
}

.trajectory-toolbar {
  background-color: #faf9f6;
  border-bottom-color: #eae6dc;
  color: #5c6760;
}

.trajectory-tool,
.trajectory-icon-tool {
  background-color: transparent;
  color: #5c6760;
}

.trajectory-tool:hover,
.trajectory-icon-tool:hover {
  background-color: rgba(0, 0, 0, 10);
  color: #1a211c;
}

.trajectory-tool.active {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.trajectory-token-summary {
  border-left-color: #eae6dc;
  color: #949e97;
}

.trajectory-search {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #949e97;
}

.trajectory-search:focus-within {
  border-color: #2d5a43;
}

.trajectory-search input {
  color: #1a211c;
}

.trajectory-timeline {
  background-color: #f7f5ef;
  border-bottom-color: #eae6dc;
}

.trajectory-lane-labels {
  border-right-color: #eeeae2;
  color: #949e97;
}

.trajectory-range {
  border-color: #2d5a43;
  background-color: rgba(45, 90, 67, 38);
}

.trajectory-range.dragging {
  background-color: rgba(45, 90, 67, 66);
}

.trajectory-zoom-status {
  border-color: #d7d3ca;
  background-color: rgba(255, 255, 255, 221);
  color: #5c6760;
}

.trajectory-zoom-status:hover {
  border-color: #4a7860;
  color: #2d5a43;
}

.trajectory-no-timing,
.trajectory-empty {
  color: #949e97;
}

.trajectory-empty strong {
  color: #5c6760;
}

.trajectory-span {
  background-color: #747f78;
}

.trajectory-span.user {
  background-color: #0284c7;
}

.trajectory-span.context {
  background-color: #16a34a;
}

.trajectory-span.system {
  background-color: #64748b;
}

.trajectory-span.message {
  background-color: #4a7860;
}

.trajectory-span.model {
  background-color: #2d5a43;
}

.trajectory-span.tool {
  background-color: #d97706;
}

.trajectory-span.error {
  background-color: #dc2626;
}

.trajectory-span.selected {
  box-shadow: #ffffff 0dp 0dp 0dp 1dp, #2d5a43 0dp 0dp 0dp 2dp;
}

.trajectory-ledger {
  background-color: #ffffff;
}

.trajectory-table-head {
  background-color: #faf9f6;
  border-bottom-color: #eae6dc;
  color: #747f78;
}

.trajectory-turn-header {
  background-color: #fcfbfa;
  border-bottom-color: #eae6dc;
  border-top-color: #eae6dc;
  color: #252d27;
}

.trajectory-turn-header:hover {
  background-color: #f6f3eb;
}
.trajectory-cell {
  background-color: #ffffff;
  border-bottom-color: #f7f5ef;
}

.trajectory-cell:hover {
  background-color: #faf9f6;
}

.trajectory-cell.selected {
  background-color: #edf4ec;
  box-shadow: #2d5a43 2dp 0dp 0dp 0dp inset;
}

.trajectory-cell.failed {
  background-color: #fff7f7;
}

.trajectory-cell.failed.selected {
  box-shadow: #dc2626 2dp 0dp 0dp 0dp inset;
}

/* Trajectory Cell Tags */
.trajectory-cell.user .trajectory-cell-event b {
  color: #0369a1;
  background-color: #e0f2fe;
  border-color: #bae6fd;
}

.trajectory-cell.context .trajectory-cell-event b {
  color: #15803d;
  background-color: #dcfce7;
  border-color: #bbf7d0;
}

.trajectory-cell.message .trajectory-cell-event b {
  color: #7e22ce;
  background-color: #f3e8ff;
  border-color: #e9d5ff;
}

.trajectory-cell.model .trajectory-cell-event b {
  color: #2d5a43;
  background-color: #edf4ec;
  border-color: #cddcd0;
}

.trajectory-cell.tool .trajectory-cell-event b {
  color: #b45309;
  background-color: #fef3c7;
  border-color: #fde68a;
}

.trajectory-cell.error .trajectory-cell-event b {
  color: #b91c1c;
  background-color: #fef2f2;
  border-color: #fecaca;
}

.trajectory-cell-content strong {
  color: #252d27;
}

.trajectory-cell-content small {
  color: #747f78;
}

.trajectory-table-footer {
  background-color: #faf9f6;
  border-top-color: #eae6dc;
  color: #949e97;
}

.trajectory-details {
  background-color: #ffffff;
  border-left-color: #eae6dc;
}

.trajectory-details-head {
  background-color: #faf9f6;
  border-bottom-color: #eae6dc;
}

.trajectory-details-head strong {
  color: #1a211c;
}

.trajectory-detail-tabs {
  background-color: #ffffff;
  border-bottom-color: #eae6dc;
}

.trajectory-detail-tabs button {
  color: #747f78;
}

.trajectory-detail-tabs button:hover {
  color: #1a211c;
  background-color: #faf9f6;
}

.trajectory-detail-tabs button.active {
  color: #2d5a43;
  border-bottom-color: #2d5a43;
}

.trajectory-status {
  background-color: #dcfce7;
  color: #166534;
}

.trajectory-status.failed {
  background-color: #fee2e2;
  color: #991b1b;
}

.trajectory-detail-overview pre,
.trajectory-detail-payload {
  background-color: #faf9f6;
  border-color: #eae6dc;
  color: #5c6760;
}

/* Right Panel & Launcher */
.right-tab-pill {
  background-color: #ffffff;
  border-color: rgba(0, 0, 0, 18);
  color: #1a211c;
}

.right-tab-close {
  color: #949e97;
}

.right-tab-close:hover {
  color: #1a211c;
}

.right-fullscreen-button {
  color: #747f78;
}

.right-fullscreen-button:hover {
  background-color: #f4f2ec;
  color: #1a211c;
}

.panel-toggle {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #747f78;
}

.panel-toggle:hover {
  background-color: #f7f5ef;
  color: #2d5a43;
}

.launcher-entry {
  background-color: #f7f5ef;
  color: #252d27;
}

.launcher-entry:hover {
  background-color: #eae6dc;
}

.launcher-entry kbd {
  background-color: #ffffff;
  border-color: rgba(0, 0, 0, 20);
  color: #747f78;
}

.right-tab-menu,
.branch-menu {
  background-color: #ffffff;
  border-color: #eae6dc;
}

.right-tab-menu button:hover,
.branch-menu button:hover {
  background-color: #f7f5ef;
  color: #2d5a43;
}

.branch-menu button.active {
  background-color: #edf4ec;
  color: #2d5a43;
}

/* Review & Git Surfaces */
.review-toolbar,
.review-summary,
.browser-toolbar {
  border-color: #eae6dc;
}

.review-toolbar button,
.review-summary button,
.browser-toolbar button {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #252d27;
}

.review-toolbar button:hover,
.review-summary button:hover,
.browser-toolbar button:hover {
  background-color: #f7f5ef;
}

.review-toolbar #commit-button {
  background-color: #ffffff;
  color: #252d27;
  border-color: #ece8df;
}

.review-toolbar #commit-button:hover {
  background-color: #edf4ec;
  border-color: #2d5a43;
}

.count-pill {
  background-color: #edf4ec;
  color: #2d5a43;
  border-color: #cddcd0;
}

.review-diff,
.diff-surface,
#review-view,
#files-view {
  background-color: #ffffff;
  color: #252d27;
}

.diff-header {
  background-color: #ffffff;
  border-bottom-color: #eae6dc;
  color: #1a211c;
}

.diff-header #close-diff {
  background-color: #faf9f6;
  border-color: #eae6dc;
  color: #5c6760;
}

.diff-header #close-diff:hover {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.diff-hunk-actions {
  background-color: #faf9f6;
  border-bottom-color: #eae6dc;
}

.diff-hunk-actions button {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #5c6760;
}

.diff-hunk-actions button:hover {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.diff-hunk {
  border-color: #eae6dc;
}

.diff-hunk-toolbar {
  background-color: #faf9f6;
}

.diff-line i {
  background-color: #faf9f6;
  color: #949e97;
}

.diff-line.add {
  background-color: rgba(220, 252, 231, 120);
  color: #166534;
}

.diff-line.remove {
  background-color: rgba(254, 226, 226, 120);
  color: #991b1b;
}

/* File Tree & Editor */
.file-tree-pane {
  background-color: #faf9f6;
  border-left-color: rgba(234, 230, 220, 179);
}

.file-editor-pane {
  background-color: #ffffff;
}

.editor-toolbar {
  background-color: #ffffff;
  border-bottom-color: rgba(234, 230, 220, 179);
}

.editor-findbar {
  background-color: #faf9f6;
  border-bottom-color: rgba(234, 230, 220, 179);
}

.file-actions button,
.editor-toolbar button {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #5c6760;
}

.file-actions button:hover,
.editor-toolbar button:hover {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.file-preview {
  background-color: #ffffff;
  color: #252d27;
}

/* Terminal */
.terminal-view {
  background-color: #faf9f6;
  color: #252d27;
}

.terminal-toolbar {
  background-color: #ffffff;
  border-color: #eae6dc;
  color: #252d27;
}

.terminal-tabs button.active {
  background-color: #eaf1e8;
  color: #2d5a43;
  border-color: #cddcd0;
}

.terminal-toolbar input {
  background-color: #f3f1ea;
  color: #252d27;
}

.terminal-toolbar input:focus {
  background-color: #ffffff;
  border-color: #2d5a43;
}

.terminal-hint {
  background-color: #f4f2ec;
  color: #747f78;
}

/* Settings Dialog & Overlays */
.overlay {
  background-color: rgba(0, 0, 0, 89);
}

.settings-dialog,
.modal {
  background-color: #ffffff;
  border-color: #eae6dc;
}

/* Modal chrome (prototype 新建会话设置 dialog) */
.modal-header {
  background-color: #faf9f6;
  border-bottom-color: #eae6dc;
}

.modal-header h2 {
  color: #1a211c;
}

.modal-header button {
  color: #747f78;
}

.modal-header button:hover {
  color: #1a211c;
}

.modal-icon {
  background-color: #edf4ec;
  border-color: #cddcd0;
  color: #2d5a43;
}

.modal label {
  color: #4a534c;
}

.modal > p,
.modal .form-error ~ p {
  color: #747f78;
}

.modal .form-error {
  color: #dc2626;
}

.modal-footer {
  background-color: #faf9f6;
  border-top-color: #eae6dc;
}

.secondary-button {
  background-color: #ffffff;
  color: #5c6760;
  border-color: #eae6dc;
}

.settings-topbar,
.settings-footer {
  border-color: #eae6dc;
}

.settings-topbar h2 {
