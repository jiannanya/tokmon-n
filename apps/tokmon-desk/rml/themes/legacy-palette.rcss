body { background-color: #f5f5f4; color: #292524; }
.sidebar { background-color: #fbfbf9; border-color: #e7e5e4; }
.workspace { background-color: #ffffff; }
.right-panel { background-color: #ffffff; border-color: #e7e5e4; }
.new-session-button { background-color: #f2ece2; color: #7c431b; }
.new-session-button:hover { background-color: #eae2d5; }
.search-box, .panel-search { background-color: #f0eee8; color: #a8a29e; }
.tree-caption, .timestamp, small { color: #a8a29e; }
.tree-row { color: #44403c; }
.tree-row:hover { background-color: rgba(0, 0, 0, 0.04); }
.tree-row.selected { background-color: #f7efe5; color: #8b5229; }
.workspace-titlebar, .window-controls, .right-tabs { background-color: #faf9f6; border-color: #e8e6df; }
.project-chip, .branch-chip { background-color: #f0eee8; color: #78716c; }
.environment-panel { background-color: #faf9f6; border-color: #e7e5e4; }
.user-message { background-color: #fcf8f3; border-color: #ebdcd0; }
.parameter-card { background-color: rgba(247, 239, 229, 0.6); }
.thought-card { background-color: #fafafa; border-color: #e7e5e4; }
.workflow-card { background-color: #ffffff; border-color: #e7e5e4; }
.status-dot { background-color: #16a34a; }
.complete-pill { background-color: #f0fdf4; color: #166534; border-color: #bbf7d0; }
.progress { background-color: #f0eee8; }
.progress div { background-color: #c86a28; }
.composer-card { background-color: #ffffff; border-color: #e7e5e4; }
.workspace-context, .branch { color: #8b5229; }
.tool-pill, .select-pill, .round-button { background-color: #fafaf9; color: #57534e; border-color: #e7e5e4; }
.tool-pill.access { background-color: #fef8f4; color: #8b5229; border-color: #f5d9c3; }
.send-button, .primary-button { background-color: #c86a28; color: #ffffff; }
.right-tab { color: #57534e; }
.right-tab.active { color: #292524; border-color: #c86a28; }
.review-toolbar, .review-summary, .browser-toolbar { border-color: #f0eee8; }
.empty-panel, .browser-placeholder { color: #a8a29e; }
.count-pill { background-color: #f0eee8; color: #57534e; }
.overlay { background-color: rgba(0, 0, 0, 0.35); }
.settings-dialog, .modal { background-color: #ffffff; border-color: #e7e5e4; }
.settings-sidebar { background-color: #faf9f6; border-color: #e7e5e4; }
.settings-nav.active { background-color: #f7efe5; color: #8b5229; }
.setting-card { border-color: #e7e5e4; }
.toggle { background-color: #d6d3d1; }
.toggle.on { background-color: #c86a28; }
.toggle span { background-color: #ffffff; }
.secondary-button, .select-box { background-color: #fafaf9; color: #57534e; border-color: #e7e5e4; }
.locked-value { color: #8b5229; }
.terminal-view, .file-preview { background-color: #1c1917; color: #e7e5e4; }
