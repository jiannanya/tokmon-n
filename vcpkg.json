{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tokmon",
  "version-semver": "0.1.0",
  "builtin-baseline": "c8f45a069ad0266bc70e703c1252cb51506ddcaf",
  "dependencies": [
    "brotli",
    {
      "name": "libsecret",
      "platform": "linux"
    },
    "libuv",
    "openssl",
    "zlib",
    "zstd"
  ],
  "features": {
    "desk": {
      "description": "Native tokmon-desk UI stack",
      "dependencies": [
        "freetype",
        "harfbuzz",
        {
          "name": "libgit2",
          "default-features": false,
          "features": [
            "pcre2",
            "ssl"
          ]
        },
        {
          "name": "rmlui",
          "features": [
            "svg"
          ]
        },
        "sdl3",
        {
          "name": "skia",
          "default-features": false,
          "features": [
            "direct3d",
            "freetype",
            "harfbuzz",
            "png"
          ],
          "platform": "windows"
        },
        {
          "name": "skia",
          "default-features": false,
          "features": [
            "freetype",
            "harfbuzz",
            "metal",
            "png"
          ],
          "platform": "osx"
        },
        {
          "name": "skia",
          "default-features": false,
          "features": [
            "fontconfig",
            "freetype",
            "harfbuzz",
            "png",
            "vulkan"
          ],
          "platform": "linux"
        },
        "tree-sitter"
      ]
    }
  }
}
